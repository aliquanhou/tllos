[Unit]
Description=TLLOS Mall - High Performance E-Commerce Platform
After=network.target nginx.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/tllos-mall
ExecStart=/opt/tllos-mall/host/c/tllvm /opt/tllos-mall/mall/main.tllbc
Restart=always
RestartSec=5
StandardOutput=append:/var/log/tllos-mall.log
StandardError=append:/var/log/tllos-mall.log

# Security hardening
NoNewPrivileges=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target
