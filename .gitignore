# Bytecode build artifacts (generated on first run)
*.tllbc

# Bootstrap seed bytecode (tracked in git for fresh-clone self-hosting)
!compiler/compiler.tllbc
!runtime/vm_run.tllbc

# Temporary test driver files (auto-generated)
.test_*_driver.tll

# Temporary build outputs
__tll_cli_driver.tll
__tll_build_output.tllbc
vm_run_target.tllbc
compiler_generated.tllbc
compiler_self_compiled.tllbc
compiler_v2.tllbc
compiler_v3.tllbc
bytecode_*.json

# Test temp directories
tests/.tmp/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Python cache
__pycache__/
*.pyc

# C Native Launcher build artifacts
host/c/tcc/
host/c/*.exe
host/c/*.o
host/c/*.obj
host/c/tllvm
host/c/tllvm.exe
host/c/*.pdb
host/c/*.ilk
host/c/asan_compat.h
