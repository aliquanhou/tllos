// envget - TLL Dogfooding tool: read environment variables
// Usage: tllvm envget.tllbc VAR_NAME [VAR_NAME2 ...]
// Exit code: 0 if all vars found, 1 if any not found
// Note: process.argv = [tllvm_path, bytecode_path, user_args...]
//       User arguments start at index 2.
fn main() -> void {
    let argv = process.argv
    let argc = arrays.length(argv)

    // argv[0]=tllvm, argv[1]=bytecode, user args start at 2
    if argc < 3 {
        io.println("envget - read environment variables")
        io.println("")
        io.println("Usage: envget VAR_NAME [VAR_NAME2 ...]")
        io.println("")
        io.println("Example: envget PATH HOME")
        process.exit(1)
    }

    let env = process.env
    let allFound = true
    let i = 2
    while i < argc {
        let name = arrays.get(argv, i)
        let value = env[name]
        if value == null {
            io.println(name + "=<not set>")
            allFound = false
        } else {
            io.println(name + "=" + value)
        }
        i = i + 1
    }

    if allFound == false {
        process.exit(1)
    }
    process.exit(0)
}

main()
