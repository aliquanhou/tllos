// cli.tll - Command-line argument parsing for tllc
// Parses argv into a structured command object

// Parse command-line arguments
// args: array of strings (process.argv, excluding program name)
// Returns: {command, input, output, ok, error}
fn parseArgs(args: list) -> map {
    let result = json.parse("{}")
    result["ok"] = false
    result["command"] = ""
    result["input"] = ""
    result["output"] = ""

    let argc = arrays.length(args)

    if argc == 0 {
        result["command"] = "help"
        result["ok"] = true
        return result
    }

    let cmd = arrays.get(args, 0)
    result["command"] = cmd

    if cmd == "help" {
        result["ok"] = true
        return result
    }

    if cmd == "compile" {
        if argc < 2 {
            result["error"] = "compile requires an input file: tllc compile <file.tll>"
            return result
        }
        result["input"] = arrays.get(args, 1)
        // Default output: replace .tll with .tllbc
        let input = result["input"]
        if strings.endsWith(input, ".tll") {
            result["output"] = strings.substring(input, 0, strings.length(input) - 4) + ".tllbc"
        } else {
            result["output"] = input + ".tllbc"
        }
        // Check for -o flag
        let i = 2
        while i < argc {
            let arg = arrays.get(args, i)
            if arg == "-o" && i + 1 < argc {
                result["output"] = arrays.get(args, i + 1)
                i = i + 2
            } else {
                i = i + 1
            }
        }
        result["ok"] = true
        return result
    }

    if cmd == "check" {
        if argc < 2 {
            result["error"] = "check requires an input file: tllc check <file.tll>"
            return result
        }
        result["input"] = arrays.get(args, 1)
        result["ok"] = true
        return result
    }

    if cmd == "info" {
        if argc < 2 {
            result["error"] = "info requires a bytecode file: tllc info <file.tllbc>"
            return result
        }
        result["input"] = arrays.get(args, 1)
        result["ok"] = true
        return result
    }

    result["error"] = "Unknown command: " + cmd + " (try 'tllc help')"
    return result
}

export parseArgs
