// User module - User registration, login, persistence for TLL OS Shop
// Pure TLL implementation - uses JSON file persistence

let users = []
let usersLoaded = false

fn loadUsers() {
    if (usersLoaded) { return }
    usersLoaded = true
    if (fs.exists("shop/users.json")) {
        let data = fs.readFile("shop/users.json")
        if (strings.length(data) > 0) {
            let parsed = json.parse(data)
            if (parsed != null) { users = parsed }
        }
    }
    io.println("Loaded " + convert.toString(arrays.length(users)) + " users")
}

fn saveUsers() {
    fs.writeFile("shop/users.json", json.stringify(users))
}

fn hashPassword(password) {
    // DJB2-style hash using strings.charCodeAt (ABI 42)
    let hash = 5381
    let i = 0
    let len = strings.length(password)
    while (i < len) {
        let c = strings.charCodeAt(password, i)
        hash = ((hash * 33) + c) % 1000000007
        i = i + 1
    }
    return convert.toString(hash)
}

export fn registerUser(username, password, email) {
    loadUsers()
    // Check if username exists
    let i = 0
    while (i < arrays.length(users)) {
        if (users[i].username == username) {
            return { success: false, error: "Username already exists" }
        }
        i = i + 1
    }
    let userId = arrays.length(users) + 1
    let user = {
        id: userId,
        username: username,
        passwordHash: hashPassword(password),
        email: email,
        createdAt: time.now()
    }
    arrays.push(users, user)
    saveUsers()
    return { success: true, user: user }
}

export fn loginUser(username, password) {
    loadUsers()
    let hash = hashPassword(password)
    let i = 0
    while (i < arrays.length(users)) {
        if (users[i].username == username && users[i].passwordHash == hash) {
            return { success: true, user: users[i] }
        }
        i = i + 1
    }
    return { success: false, error: "Invalid username or password" }
}

export fn getUserById(id) {
    loadUsers()
    let i = 0
    while (i < arrays.length(users)) {
        if (users[i].id == id) { return users[i] }
        i = i + 1
    }
    return null
}

export fn getAllUsers() {
    loadUsers()
    return users
}

export fn getUserCount() {
    loadUsers()
    return arrays.length(users)
}
