// Cart module - TLL OS Shop
export let cart = []

export fn addToCart(product) {
    let found = 0
    let i = 0
    while (i < arrays.length(cart)) {
        if (cart[i].id == product.id) {
            cart[i].qty = cart[i].qty + 1
            found = 1
        }
        i = i + 1
    }
    if (found == 0) {
        arrays.push(cart, {id: product.id, name: product.name, price: product.price, qty: 1, img: product.img})
    }
}

export fn removeFromCart(id) {
    let newCart = []
    let i = 0
    while (i < arrays.length(cart)) {
        if (cart[i].id != id) { arrays.push(newCart, cart[i]) }
        i = i + 1
    }
    cart = newCart
}

export fn cartTotal() {
    let total = 0.0
    let i = 0
    while (i < arrays.length(cart)) {
        total = total + cart[i].price * cart[i].qty
        i = i + 1
    }
    return total
}

export fn cartCount() {
    let count = 0
    let i = 0
    while (i < arrays.length(cart)) {
        count = count + cart[i].qty
        i = i + 1
    }
    return count
}

export fn clearCart() {
    cart = []
}
