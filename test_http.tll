// HTTP module test
io.println("=== HTTP Module Test ===")

// Test http.encodeURI
let encoded = http.encodeURI("hello world?a=1&b=2")
io.println("encodeURI: " + encoded)

// Test http.decodeURI
let decoded = http.decodeURI("hello%20world%3Fa%3D1")
io.println("decodeURI: " + decoded)

// Test http.get (real network request)
io.println("")
io.println("Testing http.get to httpbin.org...")
let resp = http.get("https://httpbin.org/get")
if (resp.ok) {
    io.println("PASS: http.get status=" + convert.toString(resp.status))
    io.println("body length: " + convert.toString(strings.length(resp.body)))
    io.println("body preview: " + strings.substring(resp.body, 0, 100))
} else {
    io.println("http.get result: ok=" + convert.toString(resp.ok))
    if (resp.error) {
        io.println("error: " + resp.error)
    }
    if (resp.status) {
        io.println("status: " + convert.toString(resp.status))
    }
}

io.println("")
io.println("=== HTTP Test Done ===")
