// TLL Blockchain Node - Task-based concurrent architecture (P0-15.13)
//
// Architecture:
//   EventScheduler
//     ├── Network Task: accept connections, receive messages
//     ├── Mempool Task: validate transactions, manage pool
//     ├── Mining Task: periodic block creation
//     └── Broadcast Task: propagate transactions/blocks
//
// Tasks communicate via Channels and share state via maps.
// All tasks run in a single-threaded event loop with select-based IO.

from "../../stdlib/blockchain" import createTransaction, signTransaction, validateTransaction, verifyTransactionSignature
from "../../stdlib/crypto" import sha256
from "../../stdlib/p2p" import encodeMessage, decodeMessages
from "../../stdlib/task" import createEventScheduler, onIOEvent, onServerEvent, onTimerEvent, runEventScheduler, createChannel, sendChannel, recvChannel, tryRecvChannel, lenChannel

fn main() {
    let argv = process.argv
    let argc = arrays.length(argv)

    if argc < 4 {
        io.println("Usage: node_task.tllbc <nodeId> <port> [peer1:port1] ...")
        return
    }

    let nodeId = convert.toString(arrays.get(argv, 2))
    let port = convert.toInt(convert.toString(arrays.get(argv, 3)))

    io.println("=== TLL Task-based Blockchain Node " + nodeId + " ===")
    io.println("Port: " + convert.toString(port))

    // === Shared State ===
    let chain: list = []
    let genesis = createGenesisBlock()
    arrays.push(chain, genesis)

    let mempool: list = []
    let seenTxIds: map = {}
    let peers: list = []  // list of { fd, nodeId, lastActivity, timeouts, handshaked }

    // === Channels ===
    let txChannel = createChannel()
    let blockChannel = createChannel()
    let broadcastChannel = createChannel()

    // === Event Scheduler ===
    let sched = createEventScheduler()

    // === Network Task ===
    let serverFd = tcp.listen("127.0.0.1", port)
    if serverFd < 0 {
        io.println("Failed to listen")
        return
    }
    io.println("Listening on 127.0.0.1:" + convert.toString(port))

    // Register server fd for accept
    onServerEvent(sched, serverFd, "network",
        fn(ctx) {
            // New connection
            let newFd = ctx.fd
            if newFd >= 0 {
                tcp.setTimeout(newFd, 100)
                let peer = { fd: newFd, nodeId: "unknown", lastActivity: time.nowMs(), timeouts: 0, handshaked: false }
                arrays.push(peers, peer)
                io.println("[" + nodeId + "] New peer connected (fd=" + convert.toString(newFd) + "), total: " + convert.toString(arrays.length(peers)))
                // Register peer fd for data
                onIOEvent(sched, newFd, "peer-" + convert.toString(newFd),
                    fn(ctx2) {
                        handlePeerData(nodeId, peers, mempool, seenTxIds, broadcastChannel, ctx2.fd, ctx2.data)
                    },
                    fn(ctx2) {
                        io.println("[" + nodeId + "] Peer fd=" + convert.toString(ctx2.fd) + " disconnected")
                    }
                )
                // Send handshake
                let handshake = { nodeId: nodeId, host: "127.0.0.1", port: port, version: "0.4.0" }
                tcp.send(newFd, encodeMessage("handshake", handshake))
            }
        }
    )

    // Connect to bootstrap peers
    let ai = 4
    while ai < argc {
        let addr = convert.toString(arrays.get(argv, ai))
        let parts = strings.split(addr, ":")
        let peerHost = parts[0]
        let peerPort = convert.toInt(parts[1])
        io.println("Connecting to " + addr + "...")
        let fd = tcp.connect(peerHost, peerPort)
        if fd >= 0 {
            tcp.setTimeout(fd, 100)
            let peer = { fd: fd, nodeId: "unknown", lastActivity: time.nowMs(), timeouts: 0, handshaked: false }
            arrays.push(peers, peer)
            eventScheduler.onIO(sched, fd, "peer-" + convert.toString(fd),
                fn(ctx2) {
                    handlePeerData(nodeId, peers, mempool, seenTxIds, broadcastChannel, ctx2.fd, ctx2.data)
                },
                fn(ctx2) {
                    io.println("[" + nodeId + "] Peer fd=" + convert.toString(ctx2.fd) + " disconnected")
                }
            )
            let handshake = { nodeId: nodeId, host: "127.0.0.1", port: port, version: "0.4.0" }
            tcp.send(fd, encodeMessage("handshake", handshake))
            io.println("Connected to " + addr)
        } else {
            io.println("Failed to connect to " + addr)
        }
        ai = ai + 1
    }

    // === Mempool Task (timer: process pending transactions every 500ms) ===
    onTimerEvent(sched, 500, "mempool",
        fn(ctx) {
            // Process transactions from channel
            let processed = 0
            while lenChannel(txChannel) > 0 && processed < 10 {
                let result = tryRecvChannel(txChannel)
                if result.ok {
                    let tx = result.value
                    let seen = false
                    if seenTxIds[tx.id] != null { seen = true }
                    if !seen {
                        let valid = validateTransaction(tx) && verifyTransactionSignature(tx)
                        if valid {
                            seenTxIds[tx.id] = true
                            arrays.push(mempool, tx)
                            processed = processed + 1
                            // Broadcast valid tx
                            sendChannel(broadcastChannel, { type: "transaction", payload: tx })
                        }
                    }
                }
            }
            if processed > 0 {
                io.println("[" + nodeId + "] Mempool: processed " + convert.toString(processed) + " tx, total=" + convert.toString(arrays.length(mempool)))
            }
        }
    )

    // === Mining Task (timer: create block every 5s) ===
    onTimerEvent(sched, 5000, "mining",
        fn(ctx) {
            if arrays.length(mempool) > 0 {
                // Create block from mempool
                let block = {
                    index: arrays.length(chain),
                    timestamp: time.nowMs(),
                    transactions: mempool,
                    previousHash: arrays.get(chain, arrays.length(chain) - 1).hash,
                    nonce: 0,
                    hash: ""
                }
                block.hash = sha256(convert.toString(block.index) + block.previousHash + convert.toString(block.timestamp))
                arrays.push(chain, block)
                io.println("[" + nodeId + "] Mined block #" + convert.toString(block.index) + " with " + convert.toString(arrays.length(mempool)) + " tx")
                // Clear mempool
                mempool = []
                // Broadcast block
                sendChannel(broadcastChannel, { type: "block", payload: block })
            }
        }
    )

    // === Broadcast Task (timer: send pending messages every 200ms) ===
    onTimerEvent(sched, 200, "broadcast",
        fn(ctx) {
            let sent = 0
            while lenChannel(broadcastChannel) > 0 && sent < 20 {
                let result = tryRecvChannel(broadcastChannel)
                if result.ok {
                    let msg = result.value
                    let data = encodeMessage(msg.type, msg.payload)
                    let pi = 0
                    while pi < arrays.length(peers) {
                        tcp.send(arrays.get(peers, pi).fd, data)
                        pi = pi + 1
                    }
                    sent = sent + 1
                }
            }
        }
    )

    // === Transaction Generator Task (timer: generate test tx every 2s) ===
    onTimerEvent(sched, 2000, "txgen",
        fn(ctx) {
            let txId = nodeId + "_tx_" + convert.toString(ctx.tick)
            let tx = createTransaction(nodeId, "network", 10, 1, 0, time.nowMs(), nodeId + "_pubkey")
            tx = signTransaction(tx, nodeId + "_privkey")
            tx.id = sha256(txId)
            sendChannel(txChannel, tx)
            io.println("[" + nodeId + "] Generated tx " + strings.substring(tx.id, 0, 12) + "...")
        }
    )

    // === Status Task (timer: print status every 10s) ===
    onTimerEvent(sched, 10000, "status",
        fn(ctx) {
            io.println("[" + nodeId + "] Status: peers=" + convert.toString(arrays.length(peers)) +
                " mempool=" + convert.toString(arrays.length(mempool)) +
                " chain=" + convert.toString(arrays.length(chain)) +
                " tick=" + convert.toString(ctx.tick))
        }
    )

    // === Run ===
    io.println("\n--- Task-based event loop started ---")
    io.println("Tasks: network, mempool, mining, broadcast, txgen, status")
    runEventScheduler(sched, 200, 50)

    // === Cleanup ===
    io.println("\n--- Event loop ended ---")
    io.println("Final: peers=" + convert.toString(arrays.length(peers)) +
        " mempool=" + convert.toString(arrays.length(mempool)) +
        " chain=" + convert.toString(arrays.length(chain)))

    let ci = 0
    while ci < arrays.length(peers) {
        tcp.close(arrays.get(peers, ci).fd)
        ci = ci + 1
    }
    tcp.close(serverFd)
    io.println("Cleanup complete")
}

// Handle incoming peer data
fn handlePeerData(nodeId: string, peers: list, mempool: list, seenTxIds: map, broadcastChannel: map, fd: int, data: string) -> void {
    let decoded = decodeMessages(data)
    let mi = 0
    while mi < arrays.length(decoded.messages) {
        let msg = arrays.get(decoded.messages, mi)

        if msg.type == "handshake" {
            // Find peer and update nodeId
            let pi = 0
            while pi < arrays.length(peers) {
                if arrays.get(peers, pi).fd == fd {
                    arrays.get(peers, pi).nodeId = msg.payload.nodeId
                    if !arrays.get(peers, pi).handshaked {
                        arrays.get(peers, pi).handshaked = true
                        io.println("[" + nodeId + "] Handshake from " + msg.payload.nodeId)
                    }
                }
                pi = pi + 1
            }
        }

        if msg.type == "transaction" {
            let tx = msg.payload
            let seen = false
            if seenTxIds[tx.id] != null { seen = true }
            if !seen {
                seenTxIds[tx.id] = true
                arrays.push(mempool, tx)
                io.println("[" + nodeId + "] RX tx " + strings.substring(tx.id, 0, 12) + "... (mempool=" + convert.toString(arrays.length(mempool)) + ")")
                // Re-broadcast
                sendChannel(broadcastChannel, { type: "transaction", payload: tx })
            }
        }

        if msg.type == "block" {
            let block = msg.payload
            io.println("[" + nodeId + "] RX block #" + convert.toString(block.index))
            // TODO: validate and add to chain
        }

        if msg.type == "ping" {
            tcp.send(fd, encodeMessage("pong", { timestamp: time.nowMs() }))
        }

        mi = mi + 1
    }
}

fn createGenesisBlock() -> map {
    let block = {
        index: 0,
        timestamp: 0,
        transactions: [],
        previousHash: "0",
        hash: "",
        nonce: 0
    }
    block.hash = sha256("genesis_block_tll_v4_task")
    return block
}

main()
