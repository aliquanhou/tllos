// Simple array.push test
let arr = []
io.println("Initial length: " + convert.toString(array.length(arr)))
array.push(arr, 1)
io.println("After push 1: length = " + convert.toString(array.length(arr)))
array.push(arr, 2)
io.println("After push 2: length = " + convert.toString(array.length(arr)))
io.println("arr[0] = " + convert.toString(arr[0]))
io.println("arr[1] = " + convert.toString(arr[1]))

// Test with map
let obj = { list: [] }
io.println("obj.list initial length: " + convert.toString(array.length(obj["list"])))
array.push(obj["list"], "hello")
io.println("obj.list after push: length = " + convert.toString(array.length(obj["list"])))
io.println("obj.list[0] = " + convert.toString(obj["list"][0]))
