// Dogfood Project 1: TLL HTTP Server
// Demonstrates basic HTTP server with routing using http.serve builtin
// P0-COMPILER-07: IO / Network / Database Capability Implementation

// Simple inline router (no external import needed)
let routes: list = []

fn addRoute(method: string, pattern: string, handler: any) -> void {
    arrays.push(routes, { method: method, pattern: pattern, handler: handler })
}

fn matchPattern(pattern: string, path: string) -> map {
    let patternParts = strings.split(pattern, "/")
    let pathParts = strings.split(path, "/")
    let params: map = {}

    if arrays.length(patternParts) != arrays.length(pathParts) {
        return { matched: false, params: params }
    }

    let i = 0
    while i < arrays.length(patternParts) {
        let pp = convert.toString(arrays.get(patternParts, i))
        let rp = convert.toString(arrays.get(pathParts, i))

        if strings.startsWith(pp, ":") {
            let paramName = strings.substring(pp, 1, arrays.length(pp))
            params[paramName] = rp
        } else if pp != rp {
            return { matched: false, params: params }
        }
        i = i + 1
    }

    return { matched: true, params: params }
}

fn jsonResponse(data: any, status: int) -> map {
    return {
        status: status,
        body: json.stringify(data),
        contentType: "application/json; charset=utf-8"
    }
}

fn textResponse(text: string, status: int) -> map {
    return {
        status: status,
        body: text,
        contentType: "text/plain; charset=utf-8"
    }
}

fn htmlResponse(html: string, status: int) -> map {
    return {
        status: status,
        body: html,
        contentType: "text/html; charset=utf-8"
    }
}

// === Routes ===

addRoute("GET", "/", fn(req: map) -> any {
    return htmlResponse("<html><body><h1>TLL OS HTTP Server</h1><p>Running on TLL native HTTP server.</p><ul><li>GET /api/hello</li><li>GET /api/user/:id</li><li>POST /api/echo</li><li>GET /api/status</li></ul></body></html>", 200)
})

addRoute("GET", "/api/hello", fn(req: map) -> any {
    return jsonResponse({ message: "Hello from TLL!", timestamp: time.now() }, 200)
})

addRoute("GET", "/api/user/:id", fn(req: map) -> any {
    let params = req["params"]
    let userId = params["id"]
    return jsonResponse({ id: userId, name: "User " + convert.toString(userId), email: "user" + convert.toString(userId) + "@tllos.dev" }, 200)
})

addRoute("POST", "/api/echo", fn(req: map) -> any {
    let body = req["body"]
    return jsonResponse({ echoed: body, method: req["method"], path: req["path"] }, 200)
})

addRoute("GET", "/api/status", fn(req: map) -> any {
    return jsonResponse({
        status: "running",
        platform: process.platform(),
        cwd: process.cwd(),
        uptime: time.now()
    }, 200)
})

// === Main Handler ===

fn mainHandler(req: map) -> any {
    let method = convert.toString(req["method"])
    let path = convert.toString(req["path"])

    let i = 0
    while i < arrays.length(routes) {
        let route = arrays.get(routes, i)
        if route["method"] == method {
            let matchResult = matchPattern(convert.toString(route["pattern"]), path)
            if matchResult["matched"] == true {
                req["params"] = matchResult["params"]
                let handler = route["handler"]
                return handler(req)
            }
        }
        i = i + 1
    }

    return textResponse("404 Not Found: " + method + " " + path, 404)
}

// === Start Server ===

io.println("TLL OS HTTP Server starting on :8080")
io.println("Routes: GET /, GET /api/hello, GET /api/user/:id, POST /api/echo, GET /api/status")
http.serve("0.0.0.0:8080", mainHandler)
