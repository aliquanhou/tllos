// TLL Standard Library test - Math operations
from "./stdlib/math" import math_abs, math_max, math_min, math_clamp, math_sign, math_isEven, math_isOdd, math_pow, math_sum, math_avg, math_product, math_arrayMax, math_arrayMin, math_round, math_floor, math_ceil

// Test abs
io.println("abs(-5): " + convert.toString(math_abs(-5)))
io.println("abs(3): " + convert.toString(math_abs(3)))

// Test max/min
io.println("max(3,7): " + convert.toString(math_max(3, 7)))
io.println("min(3,7): " + convert.toString(math_min(3, 7)))

// Test clamp
io.println("clamp(5,0,10): " + convert.toString(math_clamp(5, 0, 10)))
io.println("clamp(-5,0,10): " + convert.toString(math_clamp(-5, 0, 10)))
io.println("clamp(15,0,10): " + convert.toString(math_clamp(15, 0, 10)))

// Test sign
io.println("sign(5): " + convert.toString(math_sign(5)))
io.println("sign(-5): " + convert.toString(math_sign(-5)))
io.println("sign(0): " + convert.toString(math_sign(0)))

// Test isEven/isOdd
io.println("isEven(4): " + convert.toString(math_isEven(4)))
io.println("isOdd(4): " + convert.toString(math_isOdd(4)))

// Test pow
io.println("pow(2,10): " + convert.toString(math_pow(2, 10)))
io.println("pow(3,3): " + convert.toString(math_pow(3, 3)))

// Test array operations
let nums = [1, 2, 3, 4, 5]
io.println("sum: " + convert.toString(math_sum(nums)))
io.println("avg: " + convert.toString(math_avg(nums)))
io.println("product: " + convert.toString(math_product(nums)))
io.println("arrayMax: " + convert.toString(math_arrayMax(nums)))
io.println("arrayMin: " + convert.toString(math_arrayMin(nums)))

// Test round/floor/ceil
io.println("round(3.7): " + convert.toString(math_round(3.7)))
io.println("floor(3.7): " + convert.toString(math_floor(3.7)))
io.println("ceil(3.2): " + convert.toString(math_ceil(3.2)))

io.println("=== Stdlib Math Tests Done ===")
