// P0-15.18.3: Blockchain High-Message Stress Test - Node A
// Submits 120 high-frequency transactions (fee递增) to trigger mempool capacity=50 overflow,
// then mines blocks. Verifies transaction propagation + block propagation + final consistency.
from "../../stdlib/blockchain_node" import createBlockchainNode, startNode, stopNode, submitTransaction, mineBlockFromMempool, printNodeStatus, getNodeStatus
from "../../stdlib/blockchain" import createTransaction, signTransaction

let node = createBlockchainNode("nodeA", "127.0.0.1", 19301, 1, 50)
// Override mempool capacity to 50 to test real overflow behavior
// (createBlockchainNode hardcodes capacity=1000; we set it to 50 for stress test)
node.mempool.capacity = 50
io.println("=== Node A mempool capacity set to: " + convert.toString(node.mempool.capacity) + " ===")
startNode(node)

io.println("=== Node A Waiting for 3 peers ===")
let waitTicks = 0
while waitTicks < 80 {
    coroutine.sleep(100)
    waitTicks = waitTicks + 1
    if node.p2p.peers.length >= 3 { break }
}
io.println("=== Node A peers=" + convert.toString(node.p2p.peers.length) + " ===")

// Phase 1: Submit 120 high-frequency transactions (fee 1->120,递增)
// mempool capacity=50, so after 50, lowest-fee txs get evicted
io.println("=== Phase 1: Submitting 120 transactions (high frequency) ===")
let txSubmitted = 0
let txAccepted = 0
let txRejected = 0
let nonce = 0
while nonce < 120 {
    let fee = 1 + nonce  // fee递增: 1,2,3,...,120
    let amount = 100 + nonce
    let tx = createTransaction("addrA", "addrB", amount, fee, nonce, time.nowMs(), "keyA")
    tx = signTransaction(tx, "privateA")
    let result = submitTransaction(node, tx)
    txSubmitted = txSubmitted + 1
    if result == 0 {
        txAccepted = txAccepted + 1
    } else {
        txRejected = txRejected + 1
    }
    nonce = nonce + 1
    // High frequency: small sleep between submissions
    if (nonce % 10) == 0 {
        coroutine.sleep(50)
    }
}

io.println("=== Phase 1 Results ===")
io.println("Submitted: " + convert.toString(txSubmitted))
io.println("Accepted to mempool: " + convert.toString(txAccepted))
io.println("Rejected/evicted: " + convert.toString(txRejected))
io.println("Mempool size after submission: " + convert.toString(node.mempool.count))

// Wait for transaction propagation to peers
io.println("=== Waiting for transaction propagation ===")
coroutine.sleep(5000)

// Phase 2: Mine blocks from mempool
io.println("=== Phase 2: Mining blocks ===")
let blocksMined = 0
let blockTxTotal = 0
let mineAttempt = 0
while mineAttempt < 3 {
    if node.mempool.count > 0 {
        let block = mineBlockFromMempool(node, "minerA")
        blocksMined = blocksMined + 1
        let txCount = arrays.length(block.transactions)
        blockTxTotal = blockTxTotal + txCount
        io.println("Mined block " + convert.toString(block.index) + " with " + convert.toString(txCount) + " txs")
    } else {
        io.println("Mempool empty, skipping mine attempt " + convert.toString(mineAttempt))
    }
    coroutine.sleep(3000)
    mineAttempt = mineAttempt + 1
}

io.println("=== Phase 2 Results ===")
io.println("Blocks mined: " + convert.toString(blocksMined))
io.println("Total transactions in mined blocks: " + convert.toString(blockTxTotal))

// Wait for block propagation
io.println("=== Waiting for block propagation ===")
coroutine.sleep(10000)

printNodeStatus(node)
let status = getNodeStatus(node)
io.println("RESULT_NODE_A height=" + convert.toString(status.height) + " tip=" + status.tipHash + " valid=" + convert.toString(status.chainValid) + " mempool=" + convert.toString(node.mempool.count))
io.println("STRESS_SUBMITTED=" + convert.toString(txSubmitted))
io.println("STRESS_ACCEPTED=" + convert.toString(txAccepted))
io.println("STRESS_REJECTED=" + convert.toString(txRejected))
io.println("STRESS_BLOCKS=" + convert.toString(blocksMined))
io.println("STRESS_BLOCK_TX_TOTAL=" + convert.toString(blockTxTotal))

coroutine.sleep(1000)
stopNode(node)
io.println("=== Node A Done ===")
