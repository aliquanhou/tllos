// P0-15.18.3: Blockchain High-Message Stress Test - Node D (receiver)
from "../../stdlib/blockchain_node" import createBlockchainNode, startNode, stopNode, connectToPeer, printNodeStatus, getNodeStatus

let node = createBlockchainNode("nodeD", "127.0.0.1", 19304, 1, 50)
startNode(node)

io.println("=== Node D Connecting to Node A ===")
connectToPeer(node, "127.0.0.1", 19301)
coroutine.sleep(500)

io.println("=== Node D Waiting for stress test completion ===")
let waitTicks = 0
while waitTicks < 200 {
    coroutine.sleep(500)
    waitTicks = waitTicks + 1
    if node.blockchain.chain.length >= 2 { break }
}

coroutine.sleep(5000)

printNodeStatus(node)
let status = getNodeStatus(node)
io.println("RESULT_NODE_D height=" + convert.toString(status.height) + " tip=" + status.tipHash + " valid=" + convert.toString(status.chainValid) + " mempool=" + convert.toString(node.mempool.count))

coroutine.sleep(1000)
stopNode(node)
io.println("=== Node D Done ===")
