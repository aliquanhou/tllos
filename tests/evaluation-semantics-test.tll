// TLL Evaluation Semantics Behavior Test (Reality-Aligned)
// Phase 4 FINAL BEHAVIOR EVIDENCE CLOSURE
//
// IMPORTANT: Uses ONLY currently-supported TLL syntax.
// Each test produces machine-parseable EVIDENCE records.
// Unsupported capabilities are recorded as UNSUPPORTED, not faked.

import "io"
import "arrays"

// Global log to record execution order
let executionLog = []

fn logEvent(name: string) -> int {
    arrays.push(executionLog, name)
    return arrays.length(executionLog)
}

fn fnA() -> int {
    logEvent("A")
    return 1
}

fn fnB() -> int {
    logEvent("B")
    return 2
}

fn fnC() -> int {
    logEvent("C")
    return 3
}

fn sumThree(a: int, b: int, c: int) -> int {
    return a + b + c
}

// Helper to emit machine-parseable evidence
fn emitEvidence(testId: string, expected: string, actual: string, status: string) {
    io.println("EVIDENCE: TEST_ID=" + testId + " EXPECTED=" + expected + " ACTUAL=" + actual + " STATUS=" + status)
}

// === Test 1: Function Argument Evaluation Order ===
fn testFunctionArgumentOrder() {
    io.println("=== Test 1: Function Argument Order ===")
    executionLog = []
    let result = sumThree(fnA(), fnB(), fnC())
    let eventCount = arrays.length(executionLog)
    let firstEvent = arrays.get(executionLog, 0)
    let secondEvent = arrays.get(executionLog, 1)
    let thirdEvent = arrays.get(executionLog, 2)
    let actual = firstEvent + "," + secondEvent + "," + thirdEvent
    if eventCount == 3 && actual == "A,B,C" && result == 6 {
        emitEvidence("eval.function_arg_order", "A,B,C", actual, "PASS")
    } else {
        emitEvidence("eval.function_arg_order", "A,B,C", actual, "FAIL")
    }
}

// === Test 2: Binary Expression Operand Evaluation Order ===
fn testBinaryOperandOrder() {
    io.println("=== Test 2: Binary Operand Order ===")
    executionLog = []
    let result = fnA() + fnB() + fnC()
    let eventCount = arrays.length(executionLog)
    let actual = arrays.get(executionLog, 0) + "," + arrays.get(executionLog, 1) + "," + arrays.get(executionLog, 2)
    if eventCount == 3 && actual == "A,B,C" && result == 6 {
        emitEvidence("eval.binary_operand_order", "A,B,C", actual, "PASS")
    } else {
        emitEvidence("eval.binary_operand_order", "A,B,C", actual, "FAIL")
    }
}

// === Test 3: Chained Assignment (a = b = c) ===
fn testChainedAssignment() {
    io.println("=== Test 3: Chained Assignment (a=b=c) ===")
    let a = 0
    let b = 0
    let c = 42
    a = b = c
    let actual = "a=" + a + ",b=" + b
    if a == 42 && b == 42 {
        emitEvidence("eval.chained_assignment", "a=42,b=42", actual, "PASS")
    } else {
        emitEvidence("eval.chained_assignment", "a=42,b=42", actual, "FAIL")
    }
}

// === Test 4: Index Expression Evaluation Order ===
fn testIndexExpressionOrder() {
    io.println("=== Test 4: Index Expression Order ===")
    executionLog = []
    let arr = [10, 20, 30, 40, 50]
    let result = arr[fnB()]
    let eventCount = arrays.length(executionLog)
    let actual = "events=" + eventCount + ",result=" + result
    if eventCount == 1 && result == 30 {
        emitEvidence("eval.index_expression", "events=1,result=30", actual, "PASS")
    } else {
        emitEvidence("eval.index_expression", "events=1,result=30", actual, "FAIL")
    }
}

// === Test 5: Member Access Evaluation Order ===
struct Point {
    x: int
    y: int
}

fn getPoint() -> Point {
    logEvent("getPoint")
    return Point { x: 100, y: 200 }
}

fn testMemberAccessOrder() {
    io.println("=== Test 5: Member Access Order ===")
    executionLog = []
    let result = getPoint().x
    let eventCount = arrays.length(executionLog)
    let actual = "events=" + eventCount + ",result=" + result
    if eventCount == 1 && result == 100 {
        emitEvidence("eval.member_access", "events=1,result=100", actual, "PASS")
    } else {
        emitEvidence("eval.member_access", "events=1,result=100", actual, "FAIL")
    }
}

// === Test 6: Compound Assignment - RECORDED AS UNSUPPORTED ===
// TLL currently does NOT implement += in codegen.
// We test equivalent behavior with plain assignment and record += as UNSUPPORTED.
fn testCompoundAssignmentEquivalent() {
    io.println("=== Test 6: Compound Assignment (equivalent plain assignment) ===")
    executionLog = []
    let a = 10
    // Equivalent to a += fnB(), using currently-supported syntax
    a = a + fnB()
    let eventCount = arrays.length(executionLog)
    let actual = "events=" + eventCount + ",a=" + a
    if eventCount == 1 && a == 12 {
        emitEvidence("eval.compound_assignment_equivalent", "events=1,a=12", actual, "PASS")
    } else {
        emitEvidence("eval.compound_assignment_equivalent", "events=1,a=12", actual, "FAIL")
    }
    // Explicitly record += as unsupported capability
    emitEvidence("eval.compound_assignment_plus_eq", "SUPPORTED", "UNSUPPORTED", "UNSUPPORTED")
}

// === Test 7: Nested Expression Evaluation ===
fn testNestedExpressionOrder() {
    io.println("=== Test 7: Nested Expression ===")
    executionLog = []
    let result = sumThree(fnA(), fnB() * 2, fnC())
    let eventCount = arrays.length(executionLog)
    let actual = "events=" + eventCount + ",result=" + result
    if eventCount == 3 && result == 8 {
        emitEvidence("eval.nested_expression", "events=3,result=8", actual, "PASS")
    } else {
        emitEvidence("eval.nested_expression", "events=3,result=8", actual, "FAIL")
    }
}

// === Test 8: Short-circuit AND (using && canonical syntax) ===
fn returnsFalseLogged() -> bool {
    logEvent("falseFn")
    return false
}

fn returnsTrueLogged() -> bool {
    logEvent("trueFn")
    return true
}

fn testShortCircuitAnd() {
    io.println("=== Test 8: Short-circuit AND (false && true) ===")
    executionLog = []
    let result = returnsFalseLogged() && returnsTrueLogged()
    let eventCount = arrays.length(executionLog)
    let actual = "events=" + eventCount + ",result=" + result
    if eventCount == 1 && result == false {
        emitEvidence("eval.short_circuit_and", "events=1,result=false", actual, "PASS")
    } else {
        emitEvidence("eval.short_circuit_and", "events=1,result=false", actual, "FAIL")
    }
}

// === Test 9: Short-circuit OR (using || canonical syntax) ===
fn testShortCircuitOr() {
    io.println("=== Test 9: Short-circuit OR (true || false) ===")
    executionLog = []
    let result = returnsTrueLogged() || returnsFalseLogged()
    let eventCount = arrays.length(executionLog)
    let actual = "events=" + eventCount + ",result=" + result
    if eventCount == 1 && result == true {
        emitEvidence("eval.short_circuit_or", "events=1,result=true", actual, "PASS")
    } else {
        emitEvidence("eval.short_circuit_or", "events=1,result=true", actual, "FAIL")
    }
}

// === Test 10: Ternary Branch Laziness (true condition) ===
fn ternaryTrueLogged() -> int {
    logEvent("ternaryTrue")
    return 100
}

fn ternaryFalseLogged() -> int {
    logEvent("ternaryFalse")
    return 200
}

fn testTernaryLazinessTrue() {
    io.println("=== Test 10: Ternary Laziness (true ? A() : B()) ===")
    executionLog = []
    let condition = true
    let result = condition ? ternaryTrueLogged() : ternaryFalseLogged()
    let eventCount = arrays.length(executionLog)
    let actual = "events=" + eventCount + ",result=" + result
    if eventCount == 1 && result == 100 {
        emitEvidence("eval.ternary_laziness_true", "events=1,result=100", actual, "PASS")
    } else {
        emitEvidence("eval.ternary_laziness_true", "events=1,result=100", actual, "FAIL")
    }
}

// === Test 11: Ternary Branch Laziness (false condition) ===
fn testTernaryLazinessFalse() {
    io.println("=== Test 11: Ternary Laziness (false ? A() : B()) ===")
    executionLog = []
    let condition = false
    let result = condition ? ternaryTrueLogged() : ternaryFalseLogged()
    let eventCount = arrays.length(executionLog)
    let actual = "events=" + eventCount + ",result=" + result
    if eventCount == 1 && result == 200 {
        emitEvidence("eval.ternary_laziness_false", "events=1,result=200", actual, "PASS")
    } else {
        emitEvidence("eval.ternary_laziness_false", "events=1,result=200", actual, "FAIL")
    }
}

fn main() -> int {
    io.println("========================================")
    io.println("TLL Evaluation Semantics Behavior Test")
    io.println("Phase 4 FINAL BEHAVIOR EVIDENCE CLOSURE")
    io.println("REALITY-ALIGNED: Uses only supported syntax")
    io.println("========================================")

    testFunctionArgumentOrder()
    testBinaryOperandOrder()
    testChainedAssignment()
    testIndexExpressionOrder()
    testMemberAccessOrder()
    testCompoundAssignmentEquivalent()
    testNestedExpressionOrder()
    testShortCircuitAnd()
    testShortCircuitOr()
    testTernaryLazinessTrue()
    testTernaryLazinessFalse()

    io.println("========================================")
    io.println("EVALUATION EVIDENCE COMPLETE")
    io.println("Total evidence records: 12 (11 tests + 1 unsupported capability)")
    return 0
}
