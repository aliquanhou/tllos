// P0-15.18.5: Long-Run Stability Test - Node A (continuous miner, 20 blocks)
from "../../stdlib/blockchain_node" import createBlockchainNode, startNode, stopNode, connectToPeer, submitTransaction, mineBlockFromMempool, printNodeStatus, getNodeStatus
from "../../stdlib/blockchain" import createTransaction, signTransaction

let node = createBlockchainNode("nodeA", "127.0.0.1", 19301, 1, 50)
startNode(node)

io.println("=== LRS Node A Waiting for 3 peers ===")
let waitTicks = 0
while waitTicks < 60 {
    coroutine.sleep(100)
    waitTicks = waitTicks + 1
    if node.p2p.peers.length >= 3 { break }
}
io.println("=== LRS Node A peers=" + convert.toString(node.p2p.peers.length) + " ===")

// Continuous mining: 20 blocks, 3 tx per block = 60 transactions
let blockNum = 0
let totalTx = 0
while blockNum < 20 {
    // Submit 3 transactions per block
    let txIdx = 0
    while txIdx < 3 {
        let amount = 100 + blockNum * 10 + txIdx
        let tx = createTransaction("addrA", "addrB", amount, 1, totalTx, time.nowMs(), "keyA")
        tx = signTransaction(tx, "privateA")
        submitTransaction(node, tx)
        totalTx = totalTx + 1
        txIdx = txIdx + 1
    }
    coroutine.sleep(300)
    mineBlockFromMempool(node, "minerA")
    let status = getNodeStatus(node)
    io.println("LRS Node A mined block " + convert.toString(blockNum + 1) + "/20, height=" + convert.toString(status.height) + ", txs=" + convert.toString(totalTx))
    coroutine.sleep(1500)
    blockNum = blockNum + 1
}

// Wait for propagation to all peers
io.println("=== LRS Node A waiting propagation (15s) ===")
coroutine.sleep(15000)

printNodeStatus(node)
let finalStatus = getNodeStatus(node)
io.println("RESULT_NODE_A height=" + convert.toString(finalStatus.height) + " tip=" + finalStatus.tipHash + " valid=" + convert.toString(finalStatus.chainValid) + " totalTx=" + convert.toString(totalTx))

coroutine.sleep(1000)
stopNode(node)
io.println("=== LRS Node A Done ===")
