// D13 Module Test: Form Component
// 验证：组件依赖其他组件（Form → Button）、组件组合

from "./Button.tll" import createButton, clickButton, getButtonCount

// 组件内部状态
let formCount = 0

// 导出的组件创建函数
export fn createForm(title, fields) {
    formCount = formCount + 1
    let submitBtn = createButton("Submit", null)
    return {
        "id": "form_" + convert.toString(formCount),
        "title": title,
        "fields": fields,
        "submitButton": submitBtn,
        "values": {}
    }
}

// 导出的组件方法：设置字段值
export fn setFieldValue(form, fieldName, value) {
    form["values"][fieldName] = value
    return form
}

// 导出的组件方法：获取字段值
export fn getFieldValue(form, fieldName) {
    return form["values"][fieldName]
}

// 导出的组件方法：验证表单
export fn validateForm(form) {
    for field in form["fields"] {
        if field["required"] == true {
            let val = form["values"][field["name"]]
            if val == null || val == "" {
                return false
            }
        }
    }
    return true
}

// 导出的函数：获取表单数量
export fn getFormCount() {
    return formCount
}
