// TLL Blockchain Test (P0-15 dogfooding)
from "../../stdlib/blockchain" import createBlockchain, addTransaction, minePendingTransactions, getBalance, isChainValid, getLatestBlock, createTransaction, signTransaction, verifyTransactionSignature, validateTransaction

fn main() {
    io.println("=== TLL Blockchain Test ===")

    let bc = createBlockchain(2, 100)
    io.println("Genesis block created")
    io.println("Genesis hash: " + getLatestBlock(bc).hash)

    // Transaction Engine test
    io.println("\n=== Transaction Engine ===")
    let tx1 = createTransaction("alice", "bob", 50, 2, 1, 1000, "alice_pubkey")
    tx1 = signTransaction(tx1, "alice_private")
    io.println("tx1 id: " + tx1.id)
    io.println("tx1 signature: " + convert.toString(strings.length(tx1.signature)) + " chars")
    io.println("tx1 valid: " + convert.toString(validateTransaction(tx1)))
    // Note: signature verification uses publicKey as key, so won't match private key signature
    // This is a simplified model; real ECDSA would use proper key pairs

    // Add transactions
    io.println("\n=== Adding transactions ===")
    let tx2 = createTransaction("alice", "bob", 50, 1, 2, 1001, "alice_key")
    let tx3 = createTransaction("bob", "charlie", 25, 1, 1, 1002, "bob_key")
    addTransaction(bc, tx2)
    addTransaction(bc, tx3)
    io.println("Pending transactions: " + convert.toString(arrays.length(bc.pendingTransactions)))

    // Mine block 1
    io.println("\n=== Mining block 1 ===")
    let block1 = minePendingTransactions(bc, "miner1", 2000)
    io.println("Block 1 index: " + convert.toString(block1.index))
    io.println("Block 1 nonce: " + convert.toString(block1.nonce))
    io.println("Block 1 hash: " + block1.hash)
    io.println("Block 1 transactions: " + convert.toString(arrays.length(block1.transactions)))

    // Add more transactions
    io.println("\n=== Adding more transactions ===")
    addTransaction(bc, createTransaction("charlie", "alice", 10, 1, 2, 3000, "charlie_key"))
    addTransaction(bc, createTransaction("alice", "bob", 5, 1, 3, 3001, "alice_key"))

    // Mine block 2
    io.println("\n=== Mining block 2 ===")
    let block2 = minePendingTransactions(bc, "miner2", 4000)
    io.println("Block 2 index: " + convert.toString(block2.index))
    io.println("Block 2 nonce: " + convert.toString(block2.nonce))
    io.println("Block 2 hash: " + block2.hash)

    // Check balances
    io.println("\n=== Balances ===")
    io.println("alice: " + convert.toString(getBalance(bc, "alice")))
    io.println("bob: " + convert.toString(getBalance(bc, "bob")))
    io.println("charlie: " + convert.toString(getBalance(bc, "charlie")))
    io.println("miner1: " + convert.toString(getBalance(bc, "miner1")))
    io.println("miner2: " + convert.toString(getBalance(bc, "miner2")))

    // Validate chain
    io.println("\n=== Chain Validation ===")
    io.println("Chain valid: " + convert.toString(isChainValid(bc)))
    io.println("Chain length: " + convert.toString(arrays.length(bc.chain)))

    io.println("\n=== All blockchain tests completed ===")
}
main()
