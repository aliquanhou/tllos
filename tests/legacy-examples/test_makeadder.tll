// Test makeAdder (known working pattern)
fn makeAdder(n) {
    return fn(x) {
        return x + n
    }
}
let add5 = makeAdder(5)
io.println("makeAdder(5)(10) = " + convert.toString(add5(10)))
io.println("makeAdder(5)(20) = " + convert.toString(add5(20)))

// Test direct closure read
fn test2() {
    let n = 5
    let f = fn(x) {
        return x + n
    }
    io.println("direct closure: " + convert.toString(f(10)))
}
test2()
io.println("done")
