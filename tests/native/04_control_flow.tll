// Cross-Target Conformance Case 04: Control Flow & Local State
// 覆盖: variable reassignment, while loop, if/else, nested blocks

fn main() {
    // variable reassignment
    let x = 10;
    io.println(x);
    x = 20;
    io.println(x);
    x = x + 5;
    io.println(x);

    // while loop with counter
    let i = 0;
    let sum = 0;
    while i < 5 {
        sum = sum + i;
        i = i + 1;
    }
    io.println(sum);
    io.println(i);

    // while loop with if/else
    let j = 0;
    while j < 3 {
        if j == 1 {
            io.println("one");
        } else {
            io.println("other");
        }
        j = j + 1;
    }

    // nested while
    let a = 0;
    let b = 0;
    while a < 2 {
        b = 0;
        while b < 2 {
            io.println(a + b);
            b = b + 1;
        }
        a = a + 1;
    }

    return 0;
}

main()
