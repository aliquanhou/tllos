// P2-01-B11-R1-R2-R3: Assignment Expression as Return Consumer
// Machine-verifiable success criteria: explicit assertions, exit code != 0 on failure.
//
// Scenarios:
//   1. return (x = "new_value")
//   2. return (y = (x = "nested_new_value"))
//   3. return (x = y)

fn test_return_simple_assignment() -> string {
    let x = "old";
    return (x = "new_value");
}

fn test_return_nested_assignment() -> string {
    let x = "old_x";
    let y = "old_y";
    return (y = (x = "nested_new_value"));
}

fn test_return_ident_rhs_assignment() -> string {
    let x = "old_x";
    let y = "source_y";
    return (x = y);
}

fn main() {
    io.println("=== Assignment Expression as Return Consumer ===");

    // Test 1
    let r1 = test_return_simple_assignment();
    if r1 == "new_value" {
        io.println("PASS: return (x = new_value)");
    } else {
        io.println("FAIL: return (x = new_value)");
        io.println("  expected: new_value");
        io.println("  actual: ");
        io.println(r1);
        return 1;
    }

    // Test 2
    let r2 = test_return_nested_assignment();
    if r2 == "nested_new_value" {
        io.println("PASS: return (y = (x = nested_new_value))");
    } else {
        io.println("FAIL: return (y = (x = nested_new_value))");
        io.println("  expected: nested_new_value");
        io.println("  actual: ");
        io.println(r2);
        return 1;
    }

    // Test 3
    let r3 = test_return_ident_rhs_assignment();
    if r3 == "source_y" {
        io.println("PASS: return (x = y)");
    } else {
        io.println("FAIL: return (x = y)");
        io.println("  expected: source_y");
        io.println("  actual: ");
        io.println(r3);
        return 1;
    }

    io.println("=== ALL 3 ASSERTIONS PASSED ===");
    return 0;
}

main()
