// P1-04 macOS Full Gate Test Sequential Diagnostic
// Runs tests in exact same order as gate_http_client_local.tll
// Prints detailed debug output and pass/fail counts after each test
io.println("=== P1-04 macOS Full Gate Test Sequential Diagnostic ===")
io.println("")

let passed = 0
let failed = 0

fn test(name, cond) {
    if cond {
        io.println("  PASS: " + name)
        passed = passed + 1
    } else {
        io.println("  FAIL: " + name)
        failed = failed + 1
    }
    io.println("  [counts: passed=" + passed + " failed=" + failed + "]")
}

let base = "http://127.0.0.1:18080"

// Test 1: httpc.get /status
io.println("--- Test 1: httpc.get /status ---")
let resp1 = httpc.get(base + "/status")
io.println("  status=" + resp1.status + " ok=" + resp1.ok)
io.println("  statusText=[" + resp1.statusText + "]")
io.println("  body_len=" + strings.length(resp1.body))
test("get status is 200", resp1.status == 200)
test("get ok is true", resp1.ok == true)
test("get body not empty", strings.length(resp1.body) > 0)
test("get body contains status", strings.contains(resp1.body, "status"))
test("get statusText not empty", strings.length(resp1.statusText) > 0)
io.println("")

// Test 2: httpc.get with custom headers /headers
io.println("--- Test 2: httpc.get with custom headers ---")
let headers2 = {}
headers2["X-Test-Header"] = "TLL-HTTP-Client"
headers2["Accept"] = "application/json"
let resp2 = httpc.get(base + "/headers", headers2)
io.println("  status=" + resp2.status)
io.println("  body_len=" + strings.length(resp2.body))
test("get with headers status 200", resp2.status == 200)
test("get with headers body contains X-Test-Header", strings.contains(resp2.body, "X-Test-Header"))
test("get with headers body contains TLL-HTTP-Client", strings.contains(resp2.body, "TLL-HTTP-Client"))
io.println("")

// Test 3: httpc.post with body /echo
io.println("--- Test 3: httpc.post with body ---")
let postBody = "{\"name\":\"TLL\",\"version\":\"1.0\"}"
let resp3 = httpc.post(base + "/echo", postBody)
io.println("  status=" + resp3.status)
io.println("  body_len=" + strings.length(resp3.body))
test("post status 200", resp3.status == 200)
test("post body contains TLL", strings.contains(resp3.body, "TLL"))
test("post body contains version", strings.contains(resp3.body, "1.0"))
io.println("")

// Test 4: httpc.post with Content-Type header
io.println("--- Test 4: httpc.post with Content-Type header ---")
let headers4 = {}
headers4["Content-Type"] = "application/json"
let resp4 = httpc.post(base + "/echo", postBody, headers4)
io.println("  status=" + resp4.status)
test("post with headers status 200", resp4.status == 200)
io.println("")

// Test 5: httpc.request with full control (GET)
io.println("--- Test 5: httpc.request GET (full control) ---")
let req5 = {}
req5["method"] = "GET"
req5["url"] = base + "/status"
req5["timeout"] = 10000
let resp5 = httpc.request(req5)
io.println("  status=" + resp5.status + " ok=" + resp5.ok)
test("request GET status 200", resp5.status == 200)
test("request GET ok true", resp5.ok == true)
test("request GET body not empty", strings.length(resp5.body) > 0)
io.println("")

// Test 6: httpc.request with POST
io.println("--- Test 6: httpc.request with POST ---")
let req6 = {}
req6["method"] = "POST"
req6["url"] = base + "/echo"
req6["body"] = "{\"test\":\"request\"}"
let resp6 = httpc.request(req6)
io.println("  status=" + resp6.status)
io.println("  body_len=" + strings.length(resp6.body))
test("request POST status 200", resp6.status == 200)
test("request POST body contains test", strings.contains(resp6.body, "request"))
io.println("")

// Test 7: Response headers parsing
io.println("--- Test 7: Response headers parsing ---")
let resp7 = httpc.get(base + "/json")
let ct = resp7.headers["content-type"]
io.println("  content-type=[" + ct + "]")
test("response content-type header exists", strings.length(ct) > 0)
test("content-type contains json", strings.contains(ct, "json"))
io.println("")

// Test 8: Error handling - connection refused (invalid port)
io.println("--- Test 8: Error handling - connection refused ---")
let resp8 = httpc.get("http://127.0.0.1:19999/")
io.println("  status=" + resp8.status + " ok=" + resp8.ok + " error=[" + resp8.error + "]")
test("connection refused returns ok=false", resp8.ok == false)
test("connection refused status is 0", resp8.status == 0)
test("connection refused error not empty", strings.length(resp8.error) > 0)
io.println("")

// Test 9: httpc.put
io.println("--- Test 9: httpc.put ---")
let resp9 = httpc.put(base + "/echo", "{\"key\":\"value\"}")
io.println("  status=" + resp9.status)
io.println("  body_len=" + strings.length(resp9.body))
test("put status 200", resp9.status == 200)
test("put body contains key", strings.contains(resp9.body, "key"))
io.println("")

// Test 10: httpc.delete
io.println("--- Test 10: httpc.delete ---")
let resp10 = httpc.delete(base + "/echo")
io.println("  status=" + resp10.status)
test("delete status 200", resp10.status == 200)
io.println("")

// Test 11: url field in response
io.println("--- Test 11: url field in response ---")
let resp11 = httpc.get(base + "/status")
io.println("  url=[" + resp11.url + "]")
test("url field matches request", strings.contains(resp11.url, "127.0.0.1"))
io.println("")

// Test 12: Custom status code
io.println("--- Test 12: Custom status code 404 ---")
let resp12 = httpc.get(base + "/status/404")
io.println("  status=" + resp12.status)
test("custom 404 status", resp12.status == 404)
io.println("")

// Test 13: Custom status code 500
io.println("--- Test 13: Custom status code 500 ---")
let resp13 = httpc.get(base + "/status/500")
io.println("  status=" + resp13.status)
test("custom 500 status", resp13.status == 500)
io.println("")

// Test 14: Multiple sequential requests (resource leak test)
io.println("--- Test 14: Multiple sequential requests (10x) ---")
let allOk = true
for i in 1..11 {
    let r = httpc.get(base + "/status")
    io.println("  req " + i + ": status=" + r.status + " ok=" + r.ok)
    if r.status != 200 {
        allOk = false
        io.println("  *** FAILED at req " + i + " ***")
    }
}
test("10 sequential requests all 200", allOk)
io.println("")

io.println("=== Results ===")
io.println("Passed: " + passed)
io.println("Failed: " + failed)
io.println("")
if failed == 0 {
    io.println("ALL TESTS PASSED")
} else {
    io.println("SOME TESTS FAILED")
}
