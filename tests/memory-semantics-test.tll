// TLL Memory Semantics Behavior Test (Reality-Aligned with Machine Evidence)
// Phase 4 FINAL BEHAVIOR EVIDENCE CLOSURE
//
// IMPORTANT: Do NOT presuppose answers. Each test OBSERVES actual behavior.
// Each test emits machine-parseable EVIDENCE record with EXPECTED=OBSERVE.

import "io"
import "arrays"

fn emitEvidence(testId: string, expected: string, actual: string, status: string) {
    io.println("EVIDENCE: TEST_ID=" + testId + " EXPECTED=" + expected + " ACTUAL=" + actual + " STATUS=" + status)
}

// === Test 1: Array Aliasing ===
fn testArrayAliasing() {
    io.println("=== Test 1: Array Aliasing ===")
    let a = [1, 2, 3]
    let b = a
    arrays.set(b, 0, 99)
    let a0 = arrays.get(a, 0)
    let actual = "a[0]=" + a0
    if a0 == 99 {
        emitEvidence("memory.array.aliasing", "OBSERVE", "REFERENCE", "OBSERVED")
    } else {
        emitEvidence("memory.array.aliasing", "OBSERVE", "VALUE", "OBSERVED")
    }
}

// === Test 2: Map Aliasing ===
fn testMapAliasing() {
    io.println("=== Test 2: Map Aliasing ===")
    let a = {"x": 1, "y": 2}
    let b = a
    b["x"] = 99
    let ax = a["x"]
    if ax == 99 {
        emitEvidence("memory.map.aliasing", "OBSERVE", "REFERENCE", "OBSERVED")
    } else {
        emitEvidence("memory.map.aliasing", "OBSERVE", "VALUE", "OBSERVED")
    }
}

// === Test 3: Struct Aliasing - CRITICAL: Do NOT presuppose ===
struct Person {
    name: string
    age: int
}

fn testStructAliasing() {
    io.println("=== Test 3: Struct Aliasing (DO NOT PRESUPPOSE) ===")
    let a = Person { name: "Alice", age: 30 }
    let b = a
    b.age = 99
    let aAge = a.age
    if aAge == 99 {
        emitEvidence("memory.struct.aliasing", "OBSERVE", "REFERENCE", "OBSERVED")
    } else {
        emitEvidence("memory.struct.aliasing", "OBSERVE", "VALUE", "OBSERVED")
    }
}

// === Test 4: Parameter Passing - Array ===
fn modifyArrayParam(arr: list) -> void {
    arrays.set(arr, 0, 100)
}

fn testParameterPassingArray() {
    io.println("=== Test 4: Parameter Passing (Array) ===")
    let a = [1, 2, 3]
    modifyArrayParam(a)
    let a0 = arrays.get(a, 0)
    if a0 == 100 {
        emitEvidence("memory.param.array", "OBSERVE", "REFERENCE", "OBSERVED")
    } else {
        emitEvidence("memory.param.array", "OBSERVE", "VALUE", "OBSERVED")
    }
}

// === Test 5: Parameter Passing - Struct ===
fn modifyStructParam(p: Person) -> void {
    p.age = 200
}

fn testParameterPassingStruct() {
    io.println("=== Test 5: Parameter Passing (Struct) ===")
    let a = Person { name: "Bob", age: 25 }
    modifyStructParam(a)
    let aAge = a.age
    if aAge == 200 {
        emitEvidence("memory.param.struct", "OBSERVE", "REFERENCE", "OBSERVED")
    } else {
        emitEvidence("memory.param.struct", "OBSERVE", "VALUE", "OBSERVED")
    }
}

// === Test 6: Return Value - Array ===
fn createArray() -> list {
    return [10, 20, 30]
}

fn testReturnValueArray() {
    io.println("=== Test 6: Return Value (Array) ===")
    let a = createArray()
    let b = a
    arrays.set(b, 0, 999)
    let a0 = arrays.get(a, 0)
    if a0 == 999 {
        emitEvidence("memory.return.array", "OBSERVE", "REFERENCE", "OBSERVED")
    } else {
        emitEvidence("memory.return.array", "OBSERVE", "VALUE", "OBSERVED")
    }
}

// === Test 7: Return Value - Struct ===
fn createPerson() -> Person {
    return Person { name: "Charlie", age: 35 }
}

fn testReturnValueStruct() {
    io.println("=== Test 7: Return Value (Struct) ===")
    let a = createPerson()
    let b = a
    b.age = 888
    let aAge = a.age
    if aAge == 888 {
        emitEvidence("memory.return.struct", "OBSERVE", "REFERENCE", "OBSERVED")
    } else {
        emitEvidence("memory.return.struct", "OBSERVE", "VALUE", "OBSERVED")
    }
}

// === Test 8: Closure Capture - Mutation ===
fn testClosureCaptureMutation() {
    io.println("=== Test 8: Closure Capture (Mutation) ===")
    let counter = [0]
    let increment = fn() -> void {
        arrays.set(counter, 0, arrays.get(counter, 0) + 1)
    }
    increment()
    increment()
    increment()
    let count = arrays.get(counter, 0)
    if count == 3 {
        emitEvidence("memory.closure.capture", "OBSERVE", "REFERENCE", "OBSERVED")
    } else {
        emitEvidence("memory.closure.capture", "OBSERVE", "VALUE", "OBSERVED")
    }
}

// === Test 9: Closure Independent Instances ===
fn testClosureIndependentInstances() {
    io.println("=== Test 9: Closure Independent Instances ===")
    let makeCounter = fn() -> map {
        let state = [0]
        let result = {
            "inc": fn() -> void { arrays.set(state, 0, arrays.get(state, 0) + 1) },
            "get": fn() -> int { return arrays.get(state, 0) }
        }
        return result
    }
    let c1 = makeCounter()
    let c2 = makeCounter()
    c1["inc"]()
    c1["inc"]()
    c2["inc"]()
    let v1 = c1["get"]()
    let v2 = c2["get"]()
    if v1 == 2 && v2 == 1 {
        emitEvidence("memory.closure.independent", "OBSERVE", "INDEPENDENT", "OBSERVED")
    } else {
        emitEvidence("memory.closure.independent", "OBSERVE", "SHARED", "OBSERVED")
    }
}

// === Test 10: Escape / Lifetime ===
fn testEscapeLifetime() {
    io.println("=== Test 10: Escape / Lifetime ===")
    let getEscaped = fn() -> list {
        let local = [1, 2, 3]
        return local
    }
    let escaped = getEscaped()
    let len = arrays.length(escaped)
    let first = arrays.get(escaped, 0)
    if len == 3 && first == 1 {
        emitEvidence("memory.escape.lifetime", "OBSERVE", "ALIVE", "OBSERVED")
    } else {
        emitEvidence("memory.escape.lifetime", "OBSERVE", "DEAD", "OBSERVED")
    }
}

// === Test 11: Primitive Value Semantics (Control Group) ===
fn testPrimitiveValueSemantics() {
    io.println("=== Test 11: Primitive Value Semantics (Control Group) ===")
    let a = 10
    let b = a
    b = 20
    if a == 10 {
        emitEvidence("memory.primitive.value", "OBSERVE", "VALUE", "OBSERVED")
    } else {
        emitEvidence("memory.primitive.value", "OBSERVE", "REFERENCE", "OBSERVED")
    }
}

fn main() -> int {
    io.println("========================================")
    io.println("TLL Memory Semantics Behavior Test")
    io.println("Phase 4 FINAL BEHAVIOR EVIDENCE CLOSURE")
    io.println("REALITY-ALIGNED: Machine-parseable EVIDENCE records")
    io.println("========================================")

    testArrayAliasing()
    testMapAliasing()
    testStructAliasing()
    testParameterPassingArray()
    testParameterPassingStruct()
    testReturnValueArray()
    testReturnValueStruct()
    testClosureCaptureMutation()
    testClosureIndependentInstances()
    testEscapeLifetime()
    testPrimitiveValueSemantics()

    io.println("========================================")
    io.println("MEMORY EVIDENCE COMPLETE")
    io.println("Total evidence records: 11")
    return 0
}
