// scope_05: Closure capture and upvalue scope

fn makeCounter() -> any {
    let count = 0
    fn increment() -> int {
        count = count + 1
        return count
    }
    return increment
}

fn makeAdder(base: int) -> any {
    fn add(x: int) -> int {
        return base + x
    }
    return add
}

fn makeAccumulator() -> any {
    let sum = 0
    fn acc(x: int) -> int {
        sum = sum + x
        return sum
    }
    return acc
}

fn closureIsolation() -> list {
    let c1 = makeCounter()
    let c2 = makeCounter()
    let r1 = c1(0)  // increment, returns 1
    let r2 = c1(0)  // increment, returns 2
    let r3 = c2(0)  // increment, returns 1 (independent)
    let result: list = []
    arrays.push(result, r1)
    arrays.push(result, r2)
    arrays.push(result, r3)
    return result
}

let pass = true

// Test 1: closure captures and modifies upvalue
let counter = makeCounter()
let v1 = counter(0)
let v2 = counter(0)
let v3 = counter(0)
if v1 != 1 { io.println("FAIL 1: first call should be 1, got " + convert.toString(v1)); pass = false }
if v2 != 2 { io.println("FAIL 2: second call should be 2, got " + convert.toString(v2)); pass = false }
if v3 != 3 { io.println("FAIL 3: third call should be 3, got " + convert.toString(v3)); pass = false }

// Test 2: closure captures parameter
let add5 = makeAdder(5)
let add10 = makeAdder(10)
if add5(3) != 8 { io.println("FAIL 4: add5(3) should be 8"); pass = false }
if add10(3) != 13 { io.println("FAIL 5: add10(3) should be 13"); pass = false }

// Test 3: accumulator closure
let acc = makeAccumulator()
acc(10)
acc(20)
let total = acc(30)
if total != 60 { io.println("FAIL 6: accumulator should be 60, got " + convert.toString(total)); pass = false }

// Test 4: independent closures have independent upvalues
let iso = closureIsolation()
if iso[0] != 1 { io.println("FAIL 7a: c1 first should be 1"); pass = false }
if iso[1] != 2 { io.println("FAIL 7b: c1 second should be 2"); pass = false }
if iso[2] != 1 { io.println("FAIL 7c: c2 first should be 1 (independent)"); pass = false }

if pass {
    io.println("scope_05 PASS: closure capture and upvalue scope verified")
} else {
    io.println("scope_05 FAIL")
}
