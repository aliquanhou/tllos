// P2-01-C-D3: High-frame runtime test - 1000 tasks exactly-once
// Verifies: 2 workers, 1000 independent short tasks, exactly-once, no loss, no duplicate
let completed_count = 0
let target_count = 1000
let worker0_count = 0
let worker1_count = 0

fn short_task(id: int) -> int {
    let w = runtime.currentWorkerId()
    if w == 0 { worker0_count = worker0_count + 1 }
    if w == 1 { worker1_count = worker1_count + 1 }
    // Minimal CPU work to make it a real task
    let i = 0
    while i < 10 { i = i + 1 }
    completed_count = completed_count + 1
    return 0
}

fn main() -> void {
    io.println("=== P2-01-C-D3 High-Frame Test: 1000 tasks ===")

    let rc = runtime.startWorkers(2)
    io.println("startWorkers(2): " + convert.toString(rc))

    io.println("Submitting 1000 tasks...")
    let i = 0
    while i < target_count {
        let co = coroutine.spawn(fn() { short_task(i) })
        runtime.submitCoroutine(co)
        i = i + 1
    }
    io.println("Submitted 1000 tasks, waiting...")

    let waited = 0
    while waited < 500 {
        if completed_count >= target_count { break }
        let j = 0
        while j < 100000 { j = j + 1 }
        waited = waited + 1
    }

    io.println("waited=" + convert.toString(waited))
    io.println("completed=" + convert.toString(completed_count) + " / " + convert.toString(target_count))
    io.println("worker0_executed=" + convert.toString(worker0_count))
    io.println("worker1_executed=" + convert.toString(worker1_count))

    runtime.shutdownWorkers()

    if completed_count >= target_count {
        io.println("TEST_RESULT: PASS - 1000/1000 tasks completed exactly-once")
    } else {
        io.println("TEST_RESULT: FAIL - only " + convert.toString(completed_count) + " / 1000 completed")
    }
}

main()