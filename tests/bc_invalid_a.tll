// P0-15.17.1: Invalid Block test - Node A (normal miner + validator)
from "../../stdlib/blockchain_node" import createBlockchainNode, startNode, stopNode, connectToPeer, submitTransaction, mineBlockFromMempool, printNodeStatus, getNodeStatus
from "../../stdlib/blockchain" import createTransaction, signTransaction, createBlock, getLatestBlock

let node = createBlockchainNode("nodeA", "127.0.0.1", 19401, 1, 50)
startNode(node)
connectToPeer(node, "127.0.0.1", 19402)

io.println("=== Node A waiting for Node B ===")
coroutine.sleep(3000)

// Mine one normal block
let tx = createTransaction("addrA", "addrB", 100, 1, 0, time.nowMs(), "keyA")
tx = signTransaction(tx, "privateA")
submitTransaction(node, tx)
coroutine.sleep(500)
mineBlockFromMempool(node, "minerA")

io.println("=== Node A waiting for invalid block from Node B ===")
let waitTicks = 0
while waitTicks < 80 {
    coroutine.sleep(100)
    waitTicks = waitTicks + 1
}

printNodeStatus(node)
let status = getNodeStatus(node)
io.println("RESULT_NODE_A height=" + convert.toString(status.height) + " tip=" + status.tipHash + " valid=" + convert.toString(status.chainValid) + " invalid=" + convert.toString(status.invalidBlockCount) + " forks=" + convert.toString(status.forkCount))

coroutine.sleep(500)
stopNode(node)
io.println("=== Node A Done ===")
