// P1-02 Password Hashing - Quick Test
import "password"

fn main() -> int {
    println("=== P1-02 Password Hashing Test ===")

    // Test 1: hash a password
    let hash1 = password.hash("mysecretpassword")
    println("Test 1 - hash('mysecretpassword'):")
    println(hash1)

    // Test 2: verify correct password
    let ok1 = password.verify("mysecretpassword", hash1)
    println("Test 2 - verify correct: ", ok1)

    // Test 3: verify wrong password
    let ok2 = password.verify("wrongpassword", hash1)
    println("Test 3 - verify wrong: ", ok2)

    // Test 4: same password produces different hash (salt)
    let hash2 = password.hash("mysecretpassword")
    let different = (hash1 != hash2)
    println("Test 4 - different salt (hashes differ): ", different)

    // Test 5: hash with cost
    let hash3 = password.hashWithCost("test123", 4)
    println("Test 5 - hashWithCost(cost=4):")
    println(hash3)
    let ok3 = password.verify("test123", hash3)
    println("Test 5 - verify: ", ok3)

    // Test 6: hashInfo
    let info = password.hashInfo(hash1)
    println("Test 6 - hashInfo:")
    println("  valid: ", map_get(info, "valid"))
    println("  algorithm: ", map_get(info, "algorithm"))
    println("  cost: ", map_get(info, "cost"))

    // Test 7: needsRehash
    let rehash1 = password.needsRehash(hash1, 12)
    println("Test 7 - needsRehash(minCost=12): ", rehash1)
    let rehash2 = password.needsRehash(hash1, 15)
    println("Test 7 - needsRehash(minCost=15): ", rehash2)

    println("=== All tests completed ===")
    return 0
}
