// ============================================================
// P1-02 Password Hashing Gate - Complete Test Suite
// ============================================================

io.println("============================================================")
io.println("P1-02 Password Hashing Gate - Complete Test Suite")
io.println("============================================================")
io.println("")

let pass = 0
let fail = 0

fn check(name, cond) -> void {
    if (cond) {
        io.println("  PASS: " + name)
        pass = pass + 1
    } else {
        io.println("  FAIL: " + name)
        fail = fail + 1
    }
}

// Section 1: password.hash Format
io.println("--- Section 1: password.hash Format ---")

let h1 = password.hash("test123")
check("hash returns non-empty", strings.length(h1) > 0)
check("hash length is 60", strings.length(h1) == 60)
check("hash starts with $2b$", strings.substring(h1, 0, 4) == "$2b$")
check("hash has cost 12", strings.substring(h1, 4, 6) == "12")
check("hash has $ after cost", strings.substring(h1, 6, 7) == "$")
check("hash does not equal password", h1 != "test123")

io.println("")

// Section 2: Salt Randomness
io.println("--- Section 2: Salt Randomness ---")

let h2a = password.hash("samepassword")
let h2b = password.hash("samepassword")
check("same password produces different hash", h2a != h2b)
check("both hashes have same prefix", strings.substring(h2a, 0, 7) == strings.substring(h2b, 0, 7))

io.println("")

// Section 3: password.verify
io.println("--- Section 3: password.verify ---")

let h3 = password.hash("mysecret")
check("verify correct returns true", password.verify("mysecret", h3) == true)
check("verify wrong returns false", password.verify("wrong", h3) == false)
check("verify empty returns false", password.verify("", h3) == false)
check("verify different case returns false", password.verify("MySecret", h3) == false)

io.println("")

// Section 4: password.hashWithCost
io.println("--- Section 4: password.hashWithCost ---")

let h4_4 = password.hashWithCost("costtest", 4)
check("hashWithCost(4) has cost 04", strings.substring(h4_4, 4, 6) == "04")
check("hashWithCost(4) verify works", password.verify("costtest", h4_4) == true)

let h4_10 = password.hashWithCost("costtest", 10)
check("hashWithCost(10) has cost 10", strings.substring(h4_10, 4, 6) == "10")
check("hashWithCost(10) verify works", password.verify("costtest", h4_10) == true)

io.println("")

// Section 5: Edge Cases
io.println("--- Section 5: Edge Cases ---")

let h5_empty = password.hash("")
check("empty password hash length 60", strings.length(h5_empty) == 60)
check("empty password verify works", password.verify("", h5_empty) == true)
check("empty verify non-empty fails", password.verify("x", h5_empty) == false)

let h5_num = password.hash("1234567890")
check("numeric password hash length 60", strings.length(h5_num) == 60)
check("numeric password verify works", password.verify("1234567890", h5_num) == true)

io.println("")

// Section 6: Long Passwords
io.println("--- Section 6: Long Passwords ---")

let long60 = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
let h6_60 = password.hash(long60)
check("60-char hash length 60", strings.length(h6_60) == 60)
check("60-char verify works", password.verify(long60, h6_60) == true)

io.println("")

// Section 7: password.hashInfo
io.println("--- Section 7: password.hashInfo ---")

let info7 = password.hashInfo(h1)
check("hashInfo valid is true", info7.valid == true)
check("hashInfo algorithm is bcrypt", info7.algorithm == "bcrypt")
check("hashInfo cost is 12", info7.cost == 12)

let info7_invalid = password.hashInfo("invalidhash")
check("hashInfo invalid valid is false", info7_invalid.valid == false)

io.println("")

// Section 8: password.needsRehash
io.println("--- Section 8: password.needsRehash ---")

check("needsRehash(12, min 12) false", password.needsRehash(h1, 12) == false)
check("needsRehash(12, min 13) true", password.needsRehash(h1, 13) == true)
check("needsRehash(4, min 12) true", password.needsRehash(h4_4, 12) == true)
check("needsRehash(invalid, min 12) true", password.needsRehash("invalid", 12) == true)

io.println("")

// Section 9: Test Vectors
io.println("--- Section 9: Test Vectors ---")

let tv_hash = password.hashWithCost("password", 4)
check("test vector hash length 60", strings.length(tv_hash) == 60)
check("test vector starts with $2b$04$", strings.substring(tv_hash, 0, 7) == "$2b$04$")
check("test vector verify works", password.verify("password", tv_hash) == true)
check("test vector wrong fails", password.verify("Password", tv_hash) == false)

io.println("")

// Section 10: Stability
io.println("--- Section 10: Stability (10 cycles) ---")

let stable_ok = true
let si = 0
while (si < 10) {
    let hp = password.hash("stability" + si)
    if (password.verify("stability" + si, hp) != true) { stable_ok = false }
    if (password.verify("wrong" + si, hp) != false) { stable_ok = false }
    si = si + 1
}
check("10 hash/verify cycles pass", stable_ok == true)

io.println("")

// Summary
io.println("============================================================")
io.println("P1-02 Password Hashing Gate - Summary")
io.println("============================================================")
io.println("PASS: " + pass)
io.println("FAIL: " + fail)
io.println("Total: " + (pass + fail))
if (fail == 0) {
    io.println("RESULT: ALL TESTS PASSED")
} else {
    io.println("RESULT: SOME TESTS FAILED")
}
io.println("============================================================")
