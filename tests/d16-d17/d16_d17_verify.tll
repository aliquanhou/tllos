// D16 Error & Exception + D17 Concurrency Comprehensive Verification
// 含错误传播/资源清理/协程/通道/Future/Race 测试

from "../../stdlib/task" import createChannel, sendChannel, recvChannel, tryRecvChannel, lenChannel, closeChannel
from "../../stdlib/future" import future_create, future_resolve, future_reject, future_await, future_isDone, future_isOk, future_getValue

// 顶层函数（避免前向引用问题）
fn d16_throw_custom() {
    throw {"type": "CustomError", "code": 1001, "message": "Something went wrong"}
}

fn d16_caller() {
    d16_throw_custom()
}

fn d16_nested_inner() {
    throw {"type": "InnerError", "message": "inner"}
}

fn d16_nested_outer() {
    try {
        d16_nested_inner()
    } catch e {
        // 重新抛出
        throw {"type": "OuterError", "message": "outer wrapped", "cause": e}
    }
}

fn d16_finally_return() {
    try {
        return "try_value"
    } finally {
        // finally 在 return 后执行
    }
}

fn d16_finally_throw() {
    try {
        throw {"type": "TryError", "message": "from try"}
    } finally {
        // finally 在 throw 后执行
    }
}

fn main() -> void {
    io.println("=== D16 Error & Exception Test ===")

    // ============================================
    // D16-1: 基本 throw/catch
    // ============================================
    let caught1 = false
    try {
        throw "basic error"
    } catch e {
        caught1 = true
        if e != "basic error" { throw "D16: basic catch value fail" }
    }
    if caught1 != true { throw "D16: basic catch not caught" }
    io.println("  D16-1 基本 throw/catch: PASS")

    // ============================================
    // D16-2: 自定义错误类型（map 模拟）
    // ============================================
    let caught2 = false
    try {
        d16_throw_custom()
    } catch e {
        caught2 = true
        if e["type"] != "CustomError" { throw "D16: custom error type fail" }
        if e["code"] != 1001 { throw "D16: custom error code fail" }
        if e["message"] != "Something went wrong" { throw "D16: custom error message fail" }
    }
    if caught2 != true { throw "D16: custom error not caught" }
    io.println("  D16-2 自定义错误类型: PASS")

    // ============================================
    // D16-3: 错误值携带
    // ============================================
    let caught3 = false
    try {
        throw {"type": "DataError", "data": [1, 2, 3], "metadata": {"key": "value"}}
    } catch e {
        caught3 = true
        if e["data"][1] != 2 { throw "D16: error data carry fail" }
        if e["metadata"]["key"] != "value" { throw "D16: error metadata fail" }
    }
    if caught3 != true { throw "D16: data error not caught" }
    io.println("  D16-3 错误值携带: PASS")

    // ============================================
    // D16-4: 异常跨函数传播
    // ============================================
    let caught4 = false
    try {
        d16_caller()
    } catch e {
        caught4 = true
        if e["type"] != "CustomError" { throw "D16: cross-function propagation fail" }
    }
    if caught4 != true { throw "D16: cross-function not caught" }
    io.println("  D16-4 异常跨函数传播: PASS")

    // ============================================
    // D16-5: Nested try/catch
    // ============================================
    let caught5 = false
    try {
        d16_nested_outer()
    } catch e {
        caught5 = true
        if e["type"] != "OuterError" { throw "D16: nested outer type fail" }
        if e["cause"]["type"] != "InnerError" { throw "D16: nested cause fail" }
    }
    if caught5 != true { throw "D16: nested not caught" }
    io.println("  D16-5 Nested try/catch: PASS")

    // ============================================
    // D16-6: finally + return
    // ============================================
    let finallyExecuted6 = false
    // 注意：TLL 的 finally 可能需要特殊语法
    // 这里验证基本的 try/finally 结构
    try {
        let x = 1
    } finally {
        finallyExecuted6 = true
    }
    if finallyExecuted6 != true { throw "D16: finally basic fail" }
    io.println("  D16-6 finally 基本执行: PASS")

    // ============================================
    // D16-7: finally + throw
    // ============================================
    let finallyExecuted7 = false
    let caught7 = false
    try {
        try {
            throw "test"
        } finally {
            finallyExecuted7 = true
        }
    } catch e {
        caught7 = true
    }
    if finallyExecuted7 != true { throw "D16: finally with throw not executed" }
    if caught7 != true { throw "D16: finally with throw not caught" }
    io.println("  D16-7 finally + throw: PASS")

    // ============================================
    // D16-8: 资源清理模式
    // ============================================
    let resourceCleaned = false
    let resource = {"open": true, "data": "important"}
    try {
        // 使用资源
        if resource["open"] != true { throw "D16: resource not open" }
    } finally {
        // 清理资源
        resource["open"] = false
        resourceCleaned = true
    }
    if resourceCleaned != true { throw "D16: resource not cleaned" }
    if resource["open"] != false { throw "D16: resource still open" }
    io.println("  D16-8 资源清理模式: PASS")

    // ============================================
    // D16-9: catch 后恢复执行
    // ============================================
    let recovered = false
    try {
        throw "recoverable"
    } catch e {
        // 处理错误，恢复执行
        recovered = true
    }
    if recovered != true { throw "D16: recovery fail" }
    // catch 后继续执行
    let afterCatch = "continued"
    if afterCatch != "continued" { throw "D16: after catch fail" }
    io.println("  D16-9 catch 后恢复执行: PASS")

    // ============================================
    // D16-10: 错误信息诊断
    // ============================================
    let errorMessage = ""
    try {
        throw {"type": "DiagnosticError", "message": "line 42: undefined variable 'x'"}
    } catch e {
        errorMessage = e["message"]
    }
    if errorMessage != "line 42: undefined variable 'x'" { throw "D16: diagnostic message fail" }
    io.println("  D16-10 错误信息诊断: PASS")

    io.println("=== D16-ERROR-EXCEPTION-PASS ===")

    // ============================================
    // D17 Concurrency Test
    // ============================================
    io.println("=== D17 Concurrency Test ===")

    // ============================================
    // D17-1: coroutine.spawn 基本使用
    // ============================================
    let co1Result = 0
    let co1 = coroutine.spawn(fn() {
        co1Result = 42
    })
    // 等待协程执行（协程是协作式，需要 yield/sleep）
    coroutine.sleep(10)
    if co1Result != 42 { throw "D17: coroutine spawn basic fail" }
    io.println("  D17-1 coroutine.spawn 基本使用: PASS")

    // ============================================
    // D17-2: coroutine.sleep
    // ============================================
    let sleepStart = 0
    let sleepEnd = 0
    // 简单验证 sleep 不崩溃
    coroutine.sleep(5)
    io.println("  D17-2 coroutine.sleep: PASS")

    // ============================================
    // D17-3: Channel 基本 producer/consumer
    // ============================================
    let ch1 = createChannel()
    let producer1 = coroutine.spawn(fn() {
        sendChannel(ch1, "hello")
        sendChannel(ch1, "world")
    })
    coroutine.sleep(5)
    let msg1 = recvChannel(ch1)
    let msg2 = recvChannel(ch1)
    if msg1 != "hello" { throw "D17: channel msg1 fail" }
    if msg2 != "world" { throw "D17: channel msg2 fail" }
    io.println("  D17-3 Channel producer/consumer: PASS")

    // ============================================
    // D17-4: Channel 多 producer
    // ============================================
    let ch2 = createChannel()
    let p1 = coroutine.spawn(fn() {
        sendChannel(ch2, "from_p1")
    })
    let p2 = coroutine.spawn(fn() {
        sendChannel(ch2, "from_p2")
    })
    coroutine.sleep(10)
    let mpMsg1 = recvChannel(ch2)
    let mpMsg2 = recvChannel(ch2)
    // 顺序可能不确定，检查两个消息都收到
    let gotP1 = false
    let gotP2 = false
    if mpMsg1 == "from_p1" || mpMsg2 == "from_p1" { gotP1 = true }
    if mpMsg1 == "from_p2" || mpMsg2 == "from_p2" { gotP2 = true }
    if gotP1 != true { throw "D17: multi producer p1 fail" }
    if gotP2 != true { throw "D17: multi producer p2 fail" }
    io.println("  D17-4 Channel 多 producer: PASS")

    // ============================================
    // D17-5: Channel tryRecv 非阻塞
    // ============================================
    let ch3 = createChannel()
    let tryResult = tryRecvChannel(ch3)
    // 空通道 tryRecv 应该返回空或标记
    // 记录实际行为
    io.println("  D17-5 Channel tryRecv 非阻塞: PASS (no crash)")

    // ============================================
    // D17-6: Channel len
    // ============================================
    let ch4 = createChannel()
    sendChannel(ch4, 1)
    sendChannel(ch4, 2)
    sendChannel(ch4, 3)
    let ch4Len = lenChannel(ch4)
    if ch4Len != 3 { throw "D17: channel len fail" }
    io.println("  D17-6 Channel len: PASS")

    // ============================================
    // D17-7: Channel close
    // ============================================
    let ch5 = createChannel()
    sendChannel(ch5, "before_close")
    closeChannel(ch5)
    // 关闭后仍可读取已发送的数据
    let closeMsg = recvChannel(ch5)
    if closeMsg != "before_close" { throw "D17: channel close read fail" }
    io.println("  D17-7 Channel close: PASS")

    // ============================================
    // D17-8: Future 基本使用
    // ============================================
    let fut1 = future_create()
    let futProducer = coroutine.spawn(fn() {
        coroutine.sleep(5)
        future_resolve(fut1, "future_result")
    })
    let futResult = future_await(fut1)
    if futResult != "future_result" { throw "D17: future basic fail" }
    if future_isDone(fut1) != true { throw "D17: future isDone fail" }
    if future_isOk(fut1) != true { throw "D17: future isOk fail" }
    io.println("  D17-8 Future 基本使用: PASS")

    // ============================================
    // D17-9: Future reject
    // ============================================
    let fut2 = future_create()
    let fut2Producer = coroutine.spawn(fn() {
        coroutine.sleep(5)
        future_reject(fut2, {"type": "FutureError", "message": "rejected"})
    })
    let fut2Caught = false
    try {
        future_await(fut2)
    } catch e {
        fut2Caught = true
    }
    if future_isDone(fut2) != true { throw "D17: future reject isDone fail" }
    if future_isOk(fut2) != false { throw "D17: future reject isOk fail" }
    io.println("  D17-9 Future reject: PASS")

    // ============================================
    // D17-10: N coroutines + shared state + channel synchronization (Race)
    // ============================================
    let raceCh = createChannel()
    let raceCount = 0
    let workerCount = 5
    let wi = 0
    while wi < workerCount {
        coroutine.spawn(fn() {
            // 每个 worker 发送消息
            sendChannel(raceCh, wi)
        })
        wi = wi + 1
    }
    coroutine.sleep(20)
    // 收集所有 worker 的消息
    let raceResults = []
    let ri = 0
    while ri < workerCount {
        let msg = recvChannel(raceCh)
        arrays.push(raceResults, msg)
        ri = ri + 1
    }
    if raceResults.length != workerCount { throw "D17: race result count fail" }
    io.println("  D17-10 N coroutines + Channel 同步: PASS")

    // ============================================
    // D17-11: Coroutine lifecycle（spawn → sleep → complete）
    // ============================================
    let lifecycleCh = createChannel()
    let lifecycleCo = coroutine.spawn(fn() {
        sendChannel(lifecycleCh, "started")
        coroutine.sleep(5)
        sendChannel(lifecycleCh, "completed")
    })
    coroutine.sleep(10)
    let lcMsg1 = recvChannel(lifecycleCh)
    let lcMsg2 = recvChannel(lifecycleCh)
    if lcMsg1 != "started" { throw "D17: lifecycle started fail" }
    if lcMsg2 != "completed" { throw "D17: lifecycle completed fail" }
    io.println("  D17-11 Coroutine lifecycle: PASS")

    // ============================================
    // D17-12: VM 全局锁说明（非真正多线程并行）
    // ============================================
    // TLL VM 当前有全局锁，协程是单线程协作式并发
    // 这是已知的架构设计，记录为 ARCHITECTURE GAP
    io.println("  D17-12 VM 并发模型: 协作式协程（单线程，全局锁）")

    io.println("=== D17-CONCURRENCY-PASS ===")
    io.println("=== D16-D17-ALL-PASS ===")
}
main()
