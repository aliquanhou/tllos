// FFI Test: load msvcrt.dll, call strlen("hello") -> 5
let lib = ffi.load("msvcrt.dll")
io.println("library handle: " + lib)

let strlenPtr = ffi.symbol(lib, "strlen")
io.println("strlen pointer: " + strlenPtr)

let argTypes = [7]  // 7 = cstring
let args = ["hello"]
let result = ffi.call(strlenPtr, 2, argTypes, args)  // 2 = int64 return
io.println("strlen(\"hello\") = " + result)

if result == 5 {
    io.println("FFI TEST PASS")
} else {
    io.println("FFI TEST FAIL: expected 5, got " + result)
}
