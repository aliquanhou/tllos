// P0-RUNTIME-08-R2 FINAL CLOSURE-3: Connect Timeout Deterministic Test
// Verifies that connectWithTimeout() provides a TRUE runtime-level hard bound.
// Uses non-blocking connect + waitWriteWithTimeout + getsockopt(SO_ERROR).
// FINAL CLOSURE-3: Added Test C (real successful connection) to prove
// successful connections are NOT killed by timeout heuristic.

from "../stdlib/p2p" import connectWithTimeout

io.println("=== Connect Timeout Deterministic Test ===")

// Test A: Connect to non-existent port with 2500ms timeout
// This tests the "immediate failure" path: connectNonBlocking returns -1
io.println("")
io.println("Test A: connect to closed port, timeout=2500ms")
let startA = time.nowMs()
let fdA = connectWithTimeout("127.0.0.1", 19998, 2500)
let elapsedA = time.nowMs() - startA
io.println("  fd=" + convert.toString(fdA) + " elapsed=" + convert.toString(elapsedA) + "ms")

let passA = true
if fdA >= 0 {
    io.println("  FAIL: should return -1 for closed port")
    passA = false
} else {
    io.println("  OK: returned -1 (immediate failure path)")
}
if elapsedA < 1500 || elapsedA > 5000 {
    io.println("  FAIL: elapsed " + convert.toString(elapsedA) + "ms out of bounds [1500, 5000]")
    passA = false
} else {
    io.println("  OK: elapsed " + convert.toString(elapsedA) + "ms within bounds")
}

// Test B: Connect to non-existent port with 1000ms timeout
// This tests the "pending connect timeout" path:
// connectNonBlocking returns fd (EINPROGRESS), waitWriteWithTimeout times out
io.println("")
io.println("Test B: connect to closed port, timeout=1000ms")
let startB = time.nowMs()
let fdB = connectWithTimeout("127.0.0.1", 19997, 1000)
let elapsedB = time.nowMs() - startB
io.println("  fd=" + convert.toString(fdB) + " elapsed=" + convert.toString(elapsedB) + "ms")

let passB = true
if fdB >= 0 {
    io.println("  FAIL: should return -1")
    passB = false
} else {
    io.println("  OK: returned -1 (timeout path)")
}
if elapsedB < 800 || elapsedB > 3000 {
    io.println("  FAIL: elapsed " + convert.toString(elapsedB) + "ms out of bounds [800, 3000]")
    passB = false
} else {
    io.println("  OK: elapsed " + convert.toString(elapsedB) + "ms within bounds")
}

// Test C: Real successful connection
// This proves that successful connections are NOT killed by timeout heuristic.
// Create a local listener, connect to it, verify fd >= 0 and elapsed is small.
io.println("")
io.println("Test C: real successful connection to local listener")
let listenFd = tcp.listen("127.0.0.1", 19996)
if listenFd < 0 {
    io.println("  FAIL: could not create listener")
} else {
    io.println("  listener created on port 19996")
    let startC = time.nowMs()
    let fdC = connectWithTimeout("127.0.0.1", 19996, 2500)
    let elapsedC = time.nowMs() - startC
    io.println("  fd=" + convert.toString(fdC) + " elapsed=" + convert.toString(elapsedC) + "ms")

    let passC = true
    if fdC < 0 {
        io.println("  FAIL: should return valid fd for successful connection")
        passC = false
    } else {
        io.println("  OK: returned valid fd (successful connection)")
    }
    // Successful connection should be fast (much less than timeout)
    if elapsedC > 1000 {
        io.println("  FAIL: elapsed " + convert.toString(elapsedC) + "ms too slow for local connection")
        passC = false
    } else {
        io.println("  OK: elapsed " + convert.toString(elapsedC) + "ms (fast, not killed by timeout)")
    }

    // Accept the connection on the listener side
    let acceptedFd = tcp.accept(listenFd)
    if acceptedFd >= 0 {
        io.println("  OK: listener accepted connection")
        tcp.close(acceptedFd)
    }
    tcp.close(fdC)

    if !passC {
        // Mark overall failure
        passA = false
    }
    tcp.close(listenFd)
}

// Summary
io.println("")
io.println("=== Summary ===")
if passA && passB {
    io.println("PASS: Connect timeout is truly bounded at runtime level")
    io.println("PASS: Successful connections are not killed by timeout heuristic")
    io.println("TEST_RESULT: PASS")
} else {
    io.println("TEST_RESULT: FAIL")
}
