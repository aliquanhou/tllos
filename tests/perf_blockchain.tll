// P0-15.18.6: Performance Benchmark - Blockchain core operations
from "../../stdlib/blockchain" import createBlockchain, createTransaction, signTransaction, addTransaction, minePendingTransactions, getLatestBlock, calculateMerkleRoot, calculateBlockHash, arrays

io.println("=== Benchmark: Blockchain Core ===")

// Test 1: Transaction creation + signing (1000 tx)
let start1 = time.nowMs()
let txs: list = []
let ti = 0
while ti < 1000 {
    let tx = createTransaction("addrA", "addrB", 100 + ti, 1, ti, time.nowMs(), "keyA")
    tx = signTransaction(tx, "privateA")
    arrays.push(txs, tx)
    ti = ti + 1
}
let end1 = time.nowMs()
let dur1 = end1 - start1
io.println("  1000 transactions created+signed in " + convert.toString(dur1) + "ms")
io.println("  PASS: transaction creation")

// Test 2: Merkle root calculation (100 blocks of 10 tx)
let start2 = time.nowMs()
let mi = 0
while mi < 100 {
    let blockTxs: list = []
    let bj = 0
    while bj < 10 {
        arrays.push(blockTxs, txs[mi * 10 + bj])
        bj = bj + 1
    }
    let root = calculateMerkleRoot(blockTxs)
    mi = mi + 1
}
let end2 = time.nowMs()
let dur2 = end2 - start2
io.println("  100 merkle roots (10 tx each) in " + convert.toString(dur2) + "ms")
io.println("  PASS: merkle root")

// Test 3: Block hash calculation (1000 blocks)
let start3 = time.nowMs()
let hi = 0
while hi < 1000 {
    let hash = calculateBlockHash(hi, "0000000000000000", "merkle" + convert.toString(hi), time.nowMs(), 0, 1)
    hi = hi + 1
}
let end3 = time.nowMs()
let dur3 = end3 - start3
io.println("  1000 block hashes in " + convert.toString(dur3) + "ms")
io.println("  PASS: block hash")

// Test 4: Full blockchain mining (10 blocks, 5 tx each, difficulty=1)
let chain = createBlockchain(1, 100)
let start4 = time.nowMs()
let bi = 0
while bi < 10 {
    let bj = 0
    while bj < 5 {
        let tx = createTransaction("addrA", "addrB", 100 + bi * 5 + bj, 1, bi * 5 + bj, time.nowMs(), "keyA")
        tx = signTransaction(tx, "privateA")
        addTransaction(chain, tx)
        bj = bj + 1
    }
    minePendingTransactions(chain, "minerA", time.nowMs())
    bi = bi + 1
}
let end4 = time.nowMs()
let dur4 = end4 - start4
let height4 = arrays.length(chain.chain)
let latest4 = getLatestBlock(chain)
let valid4 = latest4.index == 10
io.println("  10 blocks mined (5 tx each, diff=1) in " + convert.toString(dur4) + "ms")
io.println("  height=" + convert.toString(height4) + " latestIndex=" + convert.toString(latest4.index) + " valid=" + convert.toString(valid4))
if height4 == 11 && valid4 {
    io.println("  PASS: full blockchain mining")
} else {
    io.println("  FAIL: mining, expected height=11 valid=true")
}

io.println("")
io.println("=== Blockchain Performance Summary ===")
io.println("  Transaction creation: " + convert.toString(dur1) + "ms/1000")
io.println("  Merkle root: " + convert.toString(dur2) + "ms/100")
io.println("  Block hash: " + convert.toString(dur3) + "ms/1000")
io.println("  Full mining: " + convert.toString(dur4) + "ms/10 blocks")
io.println("PERF_BLOCKCHAIN_PASS")
