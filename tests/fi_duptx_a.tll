// P0-15.18.4 Fault Injection: Duplicate Transaction Storm - Node A
// Creates 1 transaction, submits once normally, then directly broadcasts 99 duplicates
// Verifies that receiving nodes dedupe via knownTxIds + mempoolContains
from "../../stdlib/blockchain_node" import createBlockchainNode, startNode, stopNode, submitTransaction, mineBlockFromMempool, printNodeStatus, getNodeStatus
from "../../stdlib/blockchain" import createTransaction, signTransaction
from "../../stdlib/p2p" import p2pBroadcast

let node = createBlockchainNode("nodeA", "127.0.0.1", 19401, 1, 50)
startNode(node)

io.println("=== Node A Waiting for 3 peers ===")
let waitTicks = 0
while waitTicks < 60 {
    coroutine.sleep(100)
    waitTicks = waitTicks + 1
    if node.p2p.peers.length >= 3 { break }
}
io.println("=== Node A peers=" + convert.toString(node.p2p.peers.length) + " ===")

// Create ONE transaction
let tx = createTransaction("addrA", "addrB", 100, 1, 0, time.nowMs(), "keyA")
tx = signTransaction(tx, "privateA")

// Submit once normally (adds to mempool + broadcasts)
let result = submitTransaction(node, tx)
io.println("=== Normal submit result=" + convert.toString(result) + " ===")

// Wait for initial propagation
coroutine.sleep(2000)

// Duplicate storm: directly broadcast the SAME transaction 99 more times
// This bypasses submitTransaction's local dedup, testing receiver-side dedup
io.println("=== Starting duplicate tx storm: 99 direct broadcasts ===")
let dupCount = 0
while dupCount < 99 {
    p2pBroadcast(node.p2p, "transaction", tx)
    dupCount = dupCount + 1
    if (dupCount % 33) == 0 {
        coroutine.sleep(200)
    }
}
io.println("=== Duplicate storm complete: 99 broadcasts sent ===")

// Wait for all duplicates to be processed
coroutine.sleep(5000)

// Mine a block (should contain exactly 1 unique transaction)
let block = mineBlockFromMempool(node, "minerA")
io.println("=== Mined block with " + convert.toString(arrays.length(block.transactions)) + " txs ===")

// Wait for block propagation
coroutine.sleep(8000)

printNodeStatus(node)
let status = getNodeStatus(node)
io.println("RESULT_NODE_A height=" + convert.toString(status.height) + " tip=" + status.tipHash + " valid=" + convert.toString(status.chainValid) + " mempool=" + convert.toString(node.mempool.count))
io.println("DUP_TX_UNIQUE=" + convert.toString(arrays.length(block.transactions)))
io.println("DUP_TX_BROADCAST_TOTAL=100")

coroutine.sleep(1000)
stopNode(node)
io.println("=== Node A Done ===")
