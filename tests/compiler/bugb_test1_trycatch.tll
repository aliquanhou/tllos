// BUG-B Test 1: function + coroutine + try/catch + closure capture (FAIL scenario)
fn testWithTryCatch() {
    let result = "initial"
    fn coroBody() {
        try {
            throw "test"
        } catch e {
            result = "modified"
        }
    }
    coroutine.spawn(coroBody)
    coroutine.yield()
    coroutine.yield()
    return result
}
io.println(testWithTryCatch())
