// P0-COMPILER-06 Async / Concurrency Capability Probe (v2)
// Tests TLL coroutine, channel, future, and concurrency capabilities.

from "../../stdlib/task" import createChannel, sendChannel, recvChannel, tryRecvChannel

let probeTotal = 0
let probePassed = 0
let probeFailed = 0

fn probeAssert(cond, name) {
    probeTotal = probeTotal + 1
    if cond {
        probePassed = probePassed + 1
        io.println("PASS: " + name)
    } else {
        probeFailed = probeFailed + 1
        io.println("FAIL: " + name)
    }
}

// ============================================================
// Section 1: Basic Coroutine Spawn
// ============================================================
io.println("--- Section 1: Basic Coroutine Spawn ---")

let s1_1 = false
coroutine.spawn(fn() {
    s1_1 = true
})
coroutine.yield()
coroutine.yield()
probeAssert(s1_1, "1.1 basic spawn runs coroutine")

let s1_2 = 0
coroutine.spawn(fn(x) {
    s1_2 = x * 2
}, 21)
coroutine.yield()
coroutine.yield()
probeAssert(s1_2 == 42, "1.2 spawn with argument")

let s1_3 = 0
coroutine.spawn(fn(a, b, c) {
    s1_3 = a + b + c
}, 10, 20, 30)
coroutine.yield()
coroutine.yield()
probeAssert(s1_3 == 60, "1.3 spawn with multiple arguments")

// ============================================================
// Section 2: Yield and Scheduling
// ============================================================
io.println("--- Section 2: Yield and Scheduling ---")

let s2_order: list = []
coroutine.spawn(fn() {
    arrays.push(s2_order, "A1")
    coroutine.yield()
    arrays.push(s2_order, "A2")
})
coroutine.spawn(fn() {
    arrays.push(s2_order, "B1")
    coroutine.yield()
    arrays.push(s2_order, "B2")
})
coroutine.yield()
coroutine.yield()
coroutine.yield()
probeAssert(arrays.length(s2_order) == 4 && s2_order[0] == "A1" && s2_order[1] == "B1", "2.1 yield enables round-robin scheduling")

let s2_count = 0
coroutine.spawn(fn() {
    s2_count = s2_count + 1
    coroutine.yield()
    s2_count = s2_count + 1
    coroutine.yield()
    s2_count = s2_count + 1
})
coroutine.yield()
let after1 = s2_count
coroutine.yield()
let after2 = s2_count
coroutine.yield()
let after3 = s2_count
probeAssert(after1 == 1 && after2 == 2 && after3 == 3, "2.2 multiple yields progress coroutine")

// ============================================================
// Section 3: Sleep
// ============================================================
io.println("--- Section 3: Sleep ---")

let s3_other = false
coroutine.spawn(fn() {
    coroutine.sleep(50)
})
coroutine.spawn(fn() {
    s3_other = true
})
coroutine.yield()
coroutine.yield()
probeAssert(s3_other, "3.1 sleep yields to other coroutines")

let s3_done = false
coroutine.spawn(fn() {
    coroutine.sleep(30)
    s3_done = true
})
// Use coroutine.sleep() in main to wait for sleeper (standard pattern in existing tests)
coroutine.sleep(50)
probeAssert(s3_done, "3.2 sleep coroutine eventually completes")

// ============================================================
// Section 4: Channel Communication
// ============================================================
io.println("--- Section 4: Channel Communication ---")

let s4_ch1 = createChannel()
let s4_received = null
coroutine.spawn(fn() {
    s4_received = recvChannel(s4_ch1)
})
coroutine.yield()
sendChannel(s4_ch1, "hello")
coroutine.yield()
coroutine.yield()
probeAssert(s4_received == "hello", "4.1 basic channel send/recv")

let s4_ch2 = createChannel()
let s4_results: list = []
coroutine.spawn(fn() {
    arrays.push(s4_results, recvChannel(s4_ch2))
    arrays.push(s4_results, recvChannel(s4_ch2))
    arrays.push(s4_results, recvChannel(s4_ch2))
})
coroutine.yield()
sendChannel(s4_ch2, 1)
sendChannel(s4_ch2, 2)
sendChannel(s4_ch2, 3)
coroutine.yield()
coroutine.yield()
probeAssert(arrays.length(s4_results) == 3 && s4_results[0] == 1 && s4_results[1] == 2 && s4_results[2] == 3, "4.2 channel multiple messages in order")

let s4_ch3 = createChannel()
sendChannel(s4_ch3, "buffered")
let s4_buf = recvChannel(s4_ch3)
probeAssert(s4_buf == "buffered", "4.3 channel buffered send/recv")

// ============================================================
// Section 5: Coroutine Lifecycle
// ============================================================
io.println("--- Section 5: Coroutine Lifecycle ---")

let s5_1 = false
coroutine.spawn(fn() {
    let x = 1 + 1
    s5_1 = x == 2
})
coroutine.yield()
coroutine.yield()
probeAssert(s5_1, "5.1 coroutine completes normally")

let s5_2 = 0
coroutine.spawn(fn() {
    s5_2 = 100
})
coroutine.yield()
coroutine.yield()
probeAssert(s5_2 == 100, "5.2 coroutine can set shared state")

let s5_3 = false
coroutine.spawn(fn() {
    coroutine.spawn(fn() {
        s5_3 = true
    })
    coroutine.yield()
})
coroutine.yield()
coroutine.yield()
coroutine.yield()
probeAssert(s5_3, "5.3 nested spawn from within coroutine")

// ============================================================
// Section 6: Concurrency Stress
// ============================================================
io.println("--- Section 6: Concurrency Stress ---")

let s6_counter = 0
let si = 0
while si < 20 {
    coroutine.spawn(fn() {
        s6_counter = s6_counter + 1
    })
    si = si + 1
}
let sj = 0
while sj < 30 {
    coroutine.yield()
    sj = sj + 1
}
probeAssert(s6_counter == 20, "6.1 20 coroutines all execute")

let s6_ch1 = createChannel()
let s6_ch2 = createChannel()
let s6_pings = 0
let s6_pongs = 0
coroutine.spawn(fn() {
    let i = 0
    while i < 5 {
        sendChannel(s6_ch1, "ping")
        recvChannel(s6_ch2)
        s6_pings = s6_pings + 1
        i = i + 1
    }
})
coroutine.spawn(fn() {
    let i = 0
    while i < 5 {
        recvChannel(s6_ch1)
        sendChannel(s6_ch2, "pong")
        s6_pongs = s6_pongs + 1
        i = i + 1
    }
})
let sk = 0
while sk < 50 {
    coroutine.yield()
    sk = sk + 1
}
probeAssert(s6_pings == 5 && s6_pongs == 5, "6.2 channel ping-pong 5 rounds")

// ============================================================
// Section 7: Error Handling in Coroutines
// ============================================================
io.println("--- Section 7: Error Handling in Coroutines ---")

// NOTE: Known issue - closure variable capture from function-scoped coroutines
// may not propagate to outer function scope. Using module-level variables for testing.
let s7_caught = false
coroutine.spawn(fn() {
    try {
        throw "coroutine error"
    } catch e {
        s7_caught = true
    }
})
coroutine.yield()
coroutine.yield()
probeAssert(s7_caught, "7.1 try/catch works inside coroutine")

let s7_finally = false
coroutine.spawn(fn() {
    try {
        throw "error"
    } catch e {
        // ignore
    } finally {
        s7_finally = true
    }
})
coroutine.yield()
coroutine.yield()
probeAssert(s7_finally, "7.2 finally works inside coroutine")

// ============================================================
// Section 8: Shared State
// ============================================================
io.println("--- Section 8: Shared State ---")

let s8_array: list = []
coroutine.spawn(fn() {
    arrays.push(s8_array, "from A")
})
coroutine.spawn(fn() {
    arrays.push(s8_array, "from B")
})
coroutine.yield()
coroutine.yield()
coroutine.yield()
probeAssert(arrays.length(s8_array) == 2, "8.1 coroutines share array state")

let s8_map = {}
coroutine.spawn(fn() {
    s8_map["A"] = 1
})
coroutine.spawn(fn() {
    s8_map["B"] = 2
})
coroutine.yield()
coroutine.yield()
coroutine.yield()
probeAssert(s8_map["A"] == 1 && s8_map["B"] == 2, "8.2 coroutines share map state")

// ============================================================
// Section 9: Known Issues / Limitations
// ============================================================
io.println("--- Section 9: Known Issues ---")

// Issue: closure variable capture from function-scoped coroutines
// This is a known limitation - coroutines spawned inside a function
// may not properly capture and modify the function's local variables.
io.println("KNOWN ISSUE: closure variable capture from function-scoped coroutines")
io.println("  - Coroutines spawned at module level work correctly")
io.println("  - Coroutines spawned inside functions may not modify outer locals")
io.println("  - This requires further investigation in compiler/codegen")

// ============================================================
// Final Results
// ============================================================
io.println("")
io.println("============================================================")
io.println("P0-COMPILER-06 Async / Concurrency Probe Results")
io.println("============================================================")
io.println("Total: " + probeTotal)
io.println("Passed: " + probePassed)
io.println("Failed: " + probeFailed)
if probeFailed == 0 {
    io.println("ALL ASYNC / CONCURRENCY PROBES PASSED")
} else {
    io.println("SOME PROBES FAILED")
}
