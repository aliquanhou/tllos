// P0-COMPILER-03: Data & Type Capability Probe Matrix
// Probes data types and type operations through full pipeline

let probeTotal = 0
let probePassed = 0
let probeFailed = 0

fn probeAssert(cond, name) {
    probeTotal = probeTotal + 1
    if cond {
        probePassed = probePassed + 1
    } else {
        probeFailed = probeFailed + 1
        io.println("PROBE FAIL: " + name)
    }
}

fn probeEq(actual, expected, name) {
    probeAssert(actual == expected, name + " (expected=" + convert.toString(expected) + " got=" + convert.toString(actual) + ")")
}

// ============================================================
// SECTION 1: PRIMITIVE TYPES
// ============================================================
io.println("--- Section 1: Primitive Types ---")

// 1.1 int
io.println("  1.1 int")
probeEq(42, 42, "1.1.1 int literal equality")
probeEq(42 + 8, 50, "1.1.2 int addition")
probeEq(42 - 8, 34, "1.1.3 int subtraction")
probeEq(6 * 7, 42, "1.1.4 int multiplication")
// Note: TLL division always returns float (3.33333), not truncated int
probeEq(10 / 3 > 3.0, true, "1.1.5 int division returns float")
probeEq(10 % 3, 1, "1.1.6 int modulo")
probeEq(-42, -42, "1.1.7 negative int")

// 1.2 float
io.println("  1.2 float")
probeEq(3.14 > 3.0, true, "1.2.1 float literal comparison")
probeEq(1.5 + 2.5, 4.0, "1.2.2 float addition")
probeEq(2.0 * 3.0, 6.0, "1.2.3 float multiplication")

// 1.3 bool
io.println("  1.3 bool")
probeEq(true, true, "1.3.1 true literal")
probeEq(false, false, "1.3.2 false literal")
probeEq(!true, false, "1.3.3 bool negation")
probeEq(!false, true, "1.3.4 bool negation false")
probeEq(true and false, false, "1.3.5 bool and")
probeEq(true or false, true, "1.3.6 bool or")

// 1.4 string
io.println("  1.4 string")
probeEq("hello", "hello", "1.4.1 string literal equality")
probeEq("hello" + " " + "world", "hello world", "1.4.2 string concatenation")
probeEq(convert.toString(42), "42", "1.4.3 int to string")
probeEq(convert.toString(true), "true", "1.4.4 bool to string")

// 1.5 null
io.println("  1.5 null")
fn returnNull() {
    let x = null
    return x
}
probeEq(returnNull() == null, true, "1.5.1 null return and equality")

// 1.6 bytes (hex escape)
io.println("  1.6 bytes")
fn testBytes() {
    let b = "\x00\x01\x80\xff"
    return convert.toString(b)
}
let bytesResult = testBytes()
probeAssert(bytesResult != null, "1.6.1 bytes hex escape compiles and runs")

// ============================================================
// SECTION 2: COLLECTIONS
// ============================================================
io.println("--- Section 2: Collections ---")

// 2.1 array
io.println("  2.1 array")
fn arraySum(arr) {
    let sum = 0
    let i = 0
    while i < arrays.length(arr) {
        sum = sum + arrays.get(arr, i)
        i = i + 1
    }
    return sum
}
probeEq(arraySum([1, 2, 3, 4, 5]), 15, "2.1.1 array sum via index")
probeEq(arrays.length([1, 2, 3]), 3, "2.1.2 array length")
probeEq(arrays.get([10, 20, 30], 1), 20, "2.1.3 array get index")

fn arrayMutation() {
    let arr = [1, 2, 3]
    arr[1] = 99
    return arr[1]
}
probeEq(arrayMutation(), 99, "2.1.4 array mutation via index assignment")

// 2.2 nested array
io.println("  2.2 nested array")
fn nestedArraySum(matrix) {
    let sum = 0
    let i = 0
    while i < arrays.length(matrix) {
        let row = arrays.get(matrix, i)
        let j = 0
        while j < arrays.length(row) {
            sum = sum + arrays.get(row, j)
            j = j + 1
        }
        i = i + 1
    }
    return sum
}
probeEq(nestedArraySum([[1, 2], [3, 4], [5, 6]]), 21, "2.2.1 nested array sum")

// 2.3 map
io.println("  2.3 map")
fn mapTest() {
    let m = {}
    m["name"] = "Alice"
    m["age"] = 30
    return m["name"]
}
probeEq(mapTest(), "Alice", "2.3.1 map set and get string")

fn mapIntTest() {
    let m = {}
    m["count"] = 42
    return m["count"]
}
probeEq(mapIntTest(), 42, "2.3.2 map set and get int")

// 2.4 nested map
io.println("  2.4 nested map")
fn nestedMapTest() {
    let outer = {}
    let inner = {}
    inner["city"] = "Beijing"
    outer["address"] = inner
    let addr = outer["address"]
    return addr["city"]
}
probeEq(nestedMapTest(), "Beijing", "2.4.1 nested map access")

// 2.5 mixed structures
io.println("  2.5 mixed structures")
fn mixedTest() {
    let m = {}
    m["items"] = [1, 2, 3]
    let items = m["items"]
    return items[1]
}
probeEq(mixedTest(), 2, "2.5.1 map containing array")

// ============================================================
// SECTION 3: STRUCT / OBJECT
// ============================================================
io.println("--- Section 3: Struct / Object ---")

// 3.1 struct definition and construction
io.println("  3.1 struct definition")
struct Point {
    x
    y
}
fn createPoint() {
    let p = Point{x: 10, y: 20}
    return p
}
let pt = createPoint()
probeAssert(pt != null, "3.1.1 struct construction")

// 3.2 field read
io.println("  3.2 field read")
probeEq(pt.x, 10, "3.2.1 struct field read x")
probeEq(pt.y, 20, "3.2.2 struct field read y")

// 3.3 field write
io.println("  3.3 field write")
fn fieldWriteTest() {
    let p = Point{x: 1, y: 2}
    p.x = 100
    p.y = 200
    return p.x + p.y
}
probeEq(fieldWriteTest(), 300, "3.3.1 struct field write")

// 3.4 nested struct
io.println("  3.4 nested struct")
struct Rectangle {
    topLeft
    bottomRight
}
fn nestedStructTest() {
    let r = Rectangle{topLeft: Point{x: 0, y: 0}, bottomRight: Point{x: 10, y: 20}}
    return r.bottomRight.x
}
probeEq(nestedStructTest(), 10, "3.4.1 nested struct field access")

// 3.5 struct as function parameter
io.println("  3.5 struct as parameter")
fn pointDistance(p1, p2) {
    let dx = p1.x - p2.x
    let dy = p1.y - p2.y
    return dx * dx + dy * dy
}
let p1 = Point{x: 0, y: 0}
let p2 = Point{x: 3, y: 4}
probeEq(pointDistance(p1, p2), 25, "3.5.1 struct as function parameter")

// 3.6 struct as return value
io.println("  3.6 struct as return")
fn movePoint(p, dx, dy) {
    p.x = p.x + dx
    p.y = p.y + dy
    return p
}
let p3 = Point{x: 5, y: 5}
let p4 = movePoint(p3, 10, 20)
probeEq(p4.x, 15, "3.6.1 struct return value x")
probeEq(p4.y, 25, "3.6.2 struct return value y")

// ============================================================
// SECTION 4: TYPE OPERATIONS
// ============================================================
io.println("--- Section 4: Type Operations ---")

// 4.1 equality
io.println("  4.1 equality")
probeEq(42 == 42, true, "4.1.1 int equality true")
probeEq(42 == 43, false, "4.1.2 int equality false")
probeEq("abc" == "abc", true, "4.1.3 string equality true")
probeEq("abc" == "abd", false, "4.1.4 string equality false")
probeEq(true == true, true, "4.1.5 bool equality true")
probeEq(null == null, true, "4.1.6 null equality")

// 4.2 comparison
io.println("  4.2 comparison")
probeEq(10 > 5, true, "4.2.1 greater than true")
probeEq(5 > 10, false, "4.2.2 greater than false")
probeEq(5 < 10, true, "4.2.3 less than true")
probeEq(10 >= 10, true, "4.2.4 greater equal")
probeEq(5 <= 5, true, "4.2.5 less equal")

// 4.3 arithmetic
io.println("  4.3 arithmetic")
probeEq(2 + 3 * 4, 14, "4.3.1 operator precedence")
probeEq((2 + 3) * 4, 20, "4.3.2 parentheses")
probeEq(10 - 3 - 2, 5, "4.3.3 left associativity")

// 4.4 indexing
io.println("  4.4 indexing")
fn indexTest() {
    let arr = [10, 20, 30]
    return arr[0] + arr[2]
}
probeEq(indexTest(), 40, "4.4.1 array indexing")

// 4.5 function parameter types
io.println("  4.5 function parameter/return types")
fn addInts(a, b) {
    return a + b
}
probeEq(addInts(3, 4), 7, "4.5.1 int parameters and return")

fn concatStrings(a, b) {
    return a + b
}
probeEq(concatStrings("foo", "bar"), "foobar", "4.5.2 string parameters and return")

// ============================================================
// SECTION 5: MEMORY / VALUE SEMANTICS
// ============================================================
io.println("--- Section 5: Memory / Value Semantics ---")

// 5.1 assignment
io.println("  5.1 assignment")
fn assignmentTest() {
    let a = 10
    let b = a
    a = 20
    return b
}
probeEq(assignmentTest(), 10, "5.1.1 int assignment is value copy")

// 5.2 array aliasing
io.println("  5.2 array aliasing")
fn arrayAliasingTest() {
    let a = [1, 2, 3]
    let b = a
    b[0] = 99
    return a[0]
}
probeEq(arrayAliasingTest(), 99, "5.2.1 array assignment is reference (aliasing)")

// 5.3 map aliasing
io.println("  5.3 map aliasing")
fn mapAliasingTest() {
    let a = {}
    a["key"] = "original"
    let b = a
    b["key"] = "modified"
    return a["key"]
}
probeEq(mapAliasingTest(), "modified", "5.3.1 map assignment is reference (aliasing)")

// 5.4 function passing (array)
io.println("  5.4 function passing (array)")
fn modifyArray(arr) {
    arr[0] = 100
}
fn arrayPassTest() {
    let a = [1, 2, 3]
    modifyArray(a)
    return a[0]
}
probeEq(arrayPassTest(), 100, "5.4.1 array passed by reference to function")

// 5.5 function passing (int - value)
io.println("  5.5 function passing (int)")
fn modifyInt(x) {
    x = 100
}
fn intPassTest() {
    let a = 10
    modifyInt(a)
    return a
}
probeEq(intPassTest(), 10, "5.5.1 int passed by value to function")

// 5.6 struct aliasing
io.println("  5.6 struct aliasing")
fn structAliasingTest() {
    let a = Point{x: 1, y: 2}
    let b = a
    b.x = 99
    return a.x
}
probeEq(structAliasingTest(), 99, "5.6.1 struct assignment is reference (aliasing)")

// ============================================================
// SUMMARY
// ============================================================
io.println("")
io.println("============================================================")
io.println("P0-COMPILER-03 Data & Type Capability Probe Results")
io.println("============================================================")
io.println("Total: " + convert.toString(probeTotal))
io.println("Passed: " + convert.toString(probePassed))
io.println("Failed: " + convert.toString(probeFailed))
if probeFailed == 0 {
    io.println("ALL DATA & TYPE PROBES PASSED")
} else {
    io.println("SOME DATA & TYPE PROBES FAILED")
}
