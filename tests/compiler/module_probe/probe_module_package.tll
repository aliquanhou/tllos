// P0-COMPILER-04: Module / Package Capability Probe
// Tests module definition, import, export, alias, transitive deps, circular deps, nested modules

let probeTotal = 0
let probePassed = 0
let probeFailed = 0

fn probeAssert(cond, name) {
    probeTotal = probeTotal + 1
    if cond {
        probePassed = probePassed + 1
    } else {
        probeFailed = probeFailed + 1
        io.println("PROBE FAIL: " + name)
    }
}

fn probeEq(actual, expected, name) {
    probeAssert(actual == expected, name + " (expected=" + convert.toString(expected) + " got=" + convert.toString(actual) + ")")
}

// ============================================================
// SECTION 1: Basic Module Import
// ============================================================
io.println("--- Section 1: Basic Module Import ---")

from "./module_a" import addA, multiplyA, MODULE_A_CONST, moduleAVar, PointA, createPointA

probeEq(addA(3, 4), 7, "1.1 cross-module function call addA")
probeEq(multiplyA(3, 4), 12, "1.2 cross-module function call multiplyA")
probeEq(MODULE_A_CONST, 42, "1.3 cross-module const import")
probeEq(moduleAVar, 100, "1.4 cross-module let import")

let p = createPointA(10, 20)
probeEq(p.x, 10, "1.5 cross-module struct field x")
probeEq(p.y, 20, "1.6 cross-module struct field y")

let p2 = PointA{x: 5, y: 15}
probeEq(p2.x, 5, "1.7 cross-module struct construction")

// ============================================================
// SECTION 2: Transitive Dependency (A -> B -> C)
// ============================================================
io.println("--- Section 2: Transitive Dependency ---")

from "./module_b" import addB, getConstB, MODULE_B_CONST, createPointB
from "./module_c" import addC, getConstC, createPointC

probeEq(addB(3, 4), 17, "2.1 transitive: addB calls addA")
probeEq(getConstB(), 42, "2.2 transitive: getConstB returns MODULE_A_CONST")
probeEq(MODULE_B_CONST, 200, "2.3 module B const")
probeEq(addC(3, 4), 117, "2.4 transitive: addC calls addB calls addA")
probeEq(getConstC(), 242, "2.5 transitive: getConstC = getConstB + MODULE_B_CONST")

let pb = createPointB(7, 8)
probeEq(pb.x, 7, "2.6 transitive struct through B")

let pc = createPointC(9, 10)
probeEq(pc.x, 9, "2.7 transitive struct through C")

// ============================================================
// SECTION 3: Import Alias
// ============================================================
io.println("--- Section 3: Import Alias ---")

from "./module_d" import useAlias

probeEq(useAlias(), 58, "3.1 alias import: adderA(5,3) + multiplierA(2,4) + constA = 8+8+42")

// ============================================================
// SECTION 4: Circular Dependency
// ============================================================
io.println("--- Section 4: Circular Dependency ---")

from "./module_e" import funcE, callF
from "./module_f" import funcF

probeEq(funcE(5), 6, "4.1 circular: funcE(5) = 6")
probeEq(funcF(5), 12, "4.2 circular: funcF(5) = funcE(5)*2 = 12")
probeEq(callF(10), 22, "4.3 circular: callF(10) = funcF(10) = funcE(10)*2 = 22")

// ============================================================
// SECTION 5: Duplicate Import
// ============================================================
io.println("--- Section 5: Duplicate Import ---")

from "./module_g" import duplicateImportTest

probeEq(duplicateImportTest(), 15, "5.1 duplicate import: addA(1,2) + multiplyA(3,4) = 3+12")

// ============================================================
// SECTION 6: Nested Module (subdirectory)
// ============================================================
io.println("--- Section 6: Nested Module ---")

from "./nested/module_h" import nestedFunc, NESTED_CONST

probeEq(nestedFunc(), "nested module works", "6.1 nested module function call")
probeEq(NESTED_CONST, 999, "6.2 nested module const")

// ============================================================
// SECTION 7: Module-level Variable Mutation
// ============================================================
io.println("--- Section 7: Module-level State ---")

// Note: TLL module imports may be value copies, not references
// This tests whether imported variables are accessible

probeEq(moduleAVar, 100, "7.1 imported module variable initial value")

// ============================================================
// SUMMARY
// ============================================================
io.println("")
io.println("============================================================")
io.println("P0-COMPILER-04 Module / Package Capability Probe Results")
io.println("============================================================")
io.println("Total: " + convert.toString(probeTotal))
io.println("Passed: " + convert.toString(probePassed))
io.println("Failed: " + convert.toString(probeFailed))
if probeFailed == 0 {
    io.println("ALL MODULE PROBES PASSED")
} else {
    io.println("SOME MODULE PROBES FAILED")
}
