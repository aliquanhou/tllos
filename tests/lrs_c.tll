// P0-15.18.5: Long-Run Stability Test - Node C (passive receiver, long run)
from "../../stdlib/blockchain_node" import createBlockchainNode, startNode, stopNode, connectToPeer, getNodeStatus, printNodeStatus

let node = createBlockchainNode("nodeC", "127.0.0.1", 19303, 1, 50)
startNode(node)

io.println("=== LRS Node C Connecting to Node A ===")
let connectRetry = 0
while connectRetry < 10 {
    connectToPeer(node, "127.0.0.1", 19301)
    coroutine.sleep(500)
    if node.p2p.peers.length >= 1 { break }
    connectRetry = connectRetry + 1
    io.println("  Retry connect " + convert.toString(connectRetry) + "/10")
}
coroutine.sleep(1000)

io.println("=== LRS Node C Waiting for 3 peers ===")
let waitTicks = 0
while waitTicks < 60 {
    coroutine.sleep(100)
    waitTicks = waitTicks + 1
    if node.p2p.peers.length >= 3 { break }
}
io.println("=== LRS Node C peers=" + convert.toString(node.p2p.peers.length) + " ===")

let runTicks = 0
let lastHeight = 0
while runTicks < 120 {
    coroutine.sleep(1000)
    runTicks = runTicks + 1
    let status = getNodeStatus(node)
    if status.height != lastHeight {
        io.println("LRS Node C tick=" + convert.toString(runTicks) + " height=" + convert.toString(status.height) + " valid=" + convert.toString(status.chainValid))
        lastHeight = status.height
    }
}

printNodeStatus(node)
let finalStatus = getNodeStatus(node)
io.println("RESULT_NODE_C height=" + convert.toString(finalStatus.height) + " tip=" + finalStatus.tipHash + " valid=" + convert.toString(finalStatus.chainValid))

coroutine.sleep(1000)
stopNode(node)
io.println("=== LRS Node C Done ===")
