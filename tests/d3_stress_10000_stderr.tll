let target_count = 10000
fn short_task(id: int) -> int {
    let i = 0
    while i < 10 { i = i + 1 }
    return 0
}
fn main() -> void {
    io.eprintln("=== D3 Stress: 10000 tasks ===")
    let rc = runtime.startWorkers(2)
    io.eprintln("startWorkers(2)=" + convert.toString(rc))
    let i = 0
    while i < target_count {
        let co = coroutine.spawn(fn() { short_task(i) })
        runtime.submitCoroutine(co)
        i = i + 1
    }
    io.eprintln("Submitted 10000 tasks, waiting...")
    let waited = 0
    while waited < 200 {
        let j = 0
        while j < 100000 { j = j + 1 }
        waited = waited + 1
    }
    io.eprintln("waited=" + convert.toString(waited))
    io.eprintln("DONE before shutdown")
    runtime.shutdownWorkers()
    io.eprintln("DONE after shutdown")
}
main()