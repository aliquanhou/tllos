// P0-15.17.1: Auto-sync test - Node B (starts late, connects, should auto-sync 3 blocks)
from "../../stdlib/blockchain_node" import createBlockchainNode, startNode, stopNode, connectToPeer, printNodeStatus, getNodeStatus

let node = createBlockchainNode("nodeB", "127.0.0.1", 19302, 1, 50)
startNode(node)

io.println("=== Node B connecting to Node A (should auto-sync) ===")
connectToPeer(node, "127.0.0.1", 19301)

// Wait for auto-sync to complete
let waitTicks = 0
while waitTicks < 100 {
    coroutine.sleep(100)
    waitTicks = waitTicks + 1
}

printNodeStatus(node)
let status = getNodeStatus(node)
io.println("RESULT_NODE_B height=" + convert.toString(status.height) + " tip=" + status.tipHash + " valid=" + convert.toString(status.chainValid) + " peers=" + convert.toString(status.peerCount))

coroutine.sleep(500)
stopNode(node)
io.println("=== Node B Done ===")
