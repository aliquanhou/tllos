// P0-15.17: 4-Node Blockchain Network Test - Node A (Leader)
from "../../stdlib/blockchain_node" import createBlockchainNode, startNode, stopNode, connectToPeer, submitTransaction, mineBlockFromMempool, printNodeStatus, getNodeStatus
from "../../stdlib/blockchain" import createTransaction, signTransaction

let node = createBlockchainNode("nodeA", "127.0.0.1", 19101, 1, 50)
startNode(node)

io.println("=== Node A Waiting for peers ===")
let waitTicks = 0
while waitTicks < 60 {
    coroutine.sleep(100)
    waitTicks = waitTicks + 1
    if node.p2p.peers.length >= 3 { break }
}
io.println("=== Node A peers=" + convert.toString(node.p2p.peers.length) + " ===")

let tx = createTransaction("addrA", "addrB", 100, 1, 1, time.nowMs(), "keyA")
tx = signTransaction(tx, "privateA")
submitTransaction(node, tx)

coroutine.sleep(500)
mineBlockFromMempool(node, "minerA")

coroutine.sleep(3000)

printNodeStatus(node)
let status = getNodeStatus(node)
io.println("RESULT_NODE_A height=" + convert.toString(status.height) + " tip=" + status.tipHash + " valid=" + convert.toString(status.chainValid))

coroutine.sleep(1000)
stopNode(node)
io.println("=== Node A Done ===")