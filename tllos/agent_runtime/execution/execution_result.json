{
  "result_name": "TLL OS Execution Result",
  "result_version": "1.0.0",
  "result_date": "2026-09-11",
  "result_description": "Agent 执行任务后的结果格式。必须包含证据。",

  "required_fields": {
    "request_id": {
      "type": "string",
      "description": "对应的请求 ID",
      "required": true
    },
    "task_id": {
      "type": "string",
      "description": "任务 ID",
      "required": true
    },
    "agent_id": {
      "type": "string",
      "description": "Agent ID",
      "required": true
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILURE", "PERMISSION_DENIED", "SCOPE_VIOLATION"],
      "description": "执行状态",
      "required": true
    },
    "output": {
      "type": "object",
      "description": "输出结果",
      "required": false
    },
    "evidence": {
      "type": "object",
      "description": "证据",
      "required": true
    },
    "error": {
      "type": "string",
      "description": "错误信息（如有）",
      "required": false
    },
    "executed_at": {
      "type": "string",
      "format": "date-time",
      "description": "执行时间",
      "required": true
    }
  },

  "example": {
    "request_id": "exec-req-001",
    "task_id": "P2-03.2-TEST-001",
    "agent_id": "doubao-a",
    "status": "SUCCESS",
    "output": {
      "file_written": "docs/evidence/P2-03.2-TEST.md"
    },
    "evidence": {
      "file_hash": "sha256:abc123...",
      "commit_sha": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    "executed_at": "2026-09-11T10:05:00Z"
  },

  "validation_rules": [
    "无 evidence 的结果无效",
    "status 必须是规定的 4 个值之一",
    "FAILURE 必须包含 error 字段",
    "SUCCESS 必须包含 evidence 字段"
  ]
}
