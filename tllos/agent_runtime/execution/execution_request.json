{
  "request_name": "TLL OS Execution Request",
  "request_version": "1.0.0",
  "request_date": "2026-09-11",
  "request_description": "Agent 执行任务时的请求格式。必须通过 Permission Check 后才能创建。",

  "required_fields": {
    "request_id": {
      "type": "string",
      "description": "请求唯一标识符",
      "required": true
    },
    "task_id": {
      "type": "string",
      "description": "任务 ID",
      "required": true
    },
    "agent_id": {
      "type": "string",
      "description": "Agent ID",
      "required": true
    },
    "permission_id": {
      "type": "string",
      "description": "权限 ID（必须是 approved 状态）",
      "required": true
    },
    "action": {
      "type": "string",
      "description": "要执行的动作",
      "required": true
    },
    "input": {
      "type": "object",
      "description": "输入参数",
      "required": true
    },
    "required_evidence": {
      "type": "boolean",
      "description": "是否必须提供证据",
      "required": true
    }
  },

  "example": {
    "request_id": "exec-req-001",
    "task_id": "P2-03.2-TEST-001",
    "agent_id": "doubao-a",
    "permission_id": "perm-001",
    "action": "write_evidence",
    "input": {
      "file_path": "docs/evidence/P2-03.2-TEST.md",
      "content": "Test content"
    },
    "required_evidence": true
  },

  "validation_rules": [
    "permission_id 必须是 approved 状态",
    "action 必须在 task scope 内",
    "required_evidence 必须为 true",
    "无 permission_id 的请求无效"
  ]
}
