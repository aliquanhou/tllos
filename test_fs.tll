// Minimal fs.writeFile test
io.println("=== fs.writeFile test ===")

// Test 1: relative path
fs.writeFile("test_output_relative.txt", "hello from relative path")
io.println("write relative done, exists=" + convert.toString(fs.exists("test_output_relative.txt")))

// Test 2: check cwd
let files = fs.listDir(".")
io.println("dir count=" + convert.toString(arrays.length(files)))
let i = 0
while i < arrays.length(files) {
    io.println("  " + arrays.get(files, i))
    i = i + 1
}

io.println("=== done ===")
