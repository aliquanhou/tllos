// Anonymous function (lambda) test
io.println("=== Anonymous Function Test ===")

// Test 1: basic anonymous function assignment and call
let add = fn(a, b) { return a + b }
let result = add(3, 4)
io.println("Test 1 add(3,4)=" + convert.toString(result))

// Test 2: anonymous function as parameter
fn applyTwice(f, x) {
    let r1 = f(x)
    let r2 = f(r1)
    return r2
}
let double = fn(n) { return n * 2 }
let r2 = applyTwice(double, 5)
io.println("Test 2 applyTwice(double,5)=" + convert.toString(r2))

// Test 3: inline anonymous function
let r3 = applyTwice(fn(n) { return n + 1 }, 10)
io.println("Test 3 inline +1 twice=" + convert.toString(r3))

// Test 4: anonymous function with no params
let greet = fn() { return "hello from lambda" }
io.println("Test 4: " + greet())

// Test 5: anonymous function returning function
let makeAdder = fn(base) {
    return fn(x) { return base + x }
}
let add5 = makeAdder(5)
io.println("Test 5 makeAdder(5)(10)=" + convert.toString(add5(10)))

io.println("=== All Tests Done ===")
