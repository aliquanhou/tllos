// SHA-256 and HMAC-SHA256 implementation in TLL (P0-15 blockchain dogfooding)
// Uses bitwise operations: &, |, ^, ~, <<, >>

fn rotr(x: int, n: int) -> int {
    let ux = x & 0xFFFFFFFF
    let un = n & 31
    return ((ux >> un) | (ux << (32 - un))) & 0xFFFFFFFF
}

// Pad raw byte array to 512-bit blocks
fn sha256_pad_bytes(rawBytes: list) -> list {
    let bytes: list = []
    let i = 0
    let len = arrays.length(rawBytes)
    while i < len {
        bytes[i] = rawBytes[i] & 0xFF
        i = i + 1
    }
    let bitLen = len * 8
    bytes[arrays.length(bytes)] = 0x80
    while (arrays.length(bytes) % 64) != 56 {
        bytes[arrays.length(bytes)] = 0
    }
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = (bitLen >> 24) & 0xFF
    bytes[arrays.length(bytes)] = (bitLen >> 16) & 0xFF
    bytes[arrays.length(bytes)] = (bitLen >> 8) & 0xFF
    bytes[arrays.length(bytes)] = bitLen & 0xFF
    return bytes
}

// Core SHA-256: takes padded byte array, returns hex hash string
fn sha256_core(bytes: list) -> string {
    let K = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
    let H = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]
    let numBlocks = arrays.length(bytes) / 64
    let block = 0
    while block < numBlocks {
        let words: list = []
        let wi = 0
        while wi < 16 {
            let bi = block * 64 + wi * 4
            words[wi] = ((bytes[bi] << 24) | (bytes[bi + 1] << 16) | (bytes[bi + 2] << 8) | bytes[bi + 3]) & 0xFFFFFFFF
            wi = wi + 1
        }
        let t = 16
        while t < 64 {
            let w15 = words[t - 15]
            let w2 = words[t - 2]
            let s0 = rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3)
            let s1 = rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10)
            words[t] = (words[t - 16] + s0 + words[t - 7] + s1) & 0xFFFFFFFF
            t = t + 1
        }
        let a = H[0]
        let b = H[1]
        let c = H[2]
        let d = H[3]
        let e = H[4]
        let f = H[5]
        let g = H[6]
        let h = H[7]
        let i = 0
        while i < 64 {
            let S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch = (e & f) ^ ((0xFFFFFFFF ^ e) & g)
            let temp1 = (h + S1 + ch + K[i] + words[i]) & 0xFFFFFFFF
            let S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let temp2 = (S0 + maj) & 0xFFFFFFFF
            h = g
            g = f
            f = e
            e = (d + temp1) & 0xFFFFFFFF
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & 0xFFFFFFFF
            i = i + 1
        }
        H[0] = (H[0] + a) & 0xFFFFFFFF
        H[1] = (H[1] + b) & 0xFFFFFFFF
        H[2] = (H[2] + c) & 0xFFFFFFFF
        H[3] = (H[3] + d) & 0xFFFFFFFF
        H[4] = (H[4] + e) & 0xFFFFFFFF
        H[5] = (H[5] + f) & 0xFFFFFFFF
        H[6] = (H[6] + g) & 0xFFFFFFFF
        H[7] = (H[7] + h) & 0xFFFFFFFF
        block = block + 1
    }
    let hex = "0123456789abcdef"
    let result = ""
    let hi = 0
    while hi < 8 {
        let val = H[hi]
        result = result + strings.charAt(hex, (val >> 28) & 0xF)
        result = result + strings.charAt(hex, (val >> 24) & 0xF)
        result = result + strings.charAt(hex, (val >> 20) & 0xF)
        result = result + strings.charAt(hex, (val >> 16) & 0xF)
        result = result + strings.charAt(hex, (val >> 12) & 0xF)
        result = result + strings.charAt(hex, (val >> 8) & 0xF)
        result = result + strings.charAt(hex, (val >> 4) & 0xF)
        result = result + strings.charAt(hex, val & 0xF)
        hi = hi + 1
    }
    return result
}

// SHA-256 from string
fn sha256(message: string) -> string {
    let rawBytes: list = []
    let i = 0
    let len = strings.length(message)
    while i < len {
        rawBytes[i] = strings.charCodeAt(message, i) & 0xFF
        i = i + 1
    }
    let bytes = sha256_pad_bytes(rawBytes)
    return sha256_core(bytes)
}

// SHA-256 from raw byte array
fn sha256Bytes(rawBytes: list) -> string {
    let bytes = sha256_pad_bytes(rawBytes)
    return sha256_core(bytes)
}

// Convert hex char to value (0-15)
fn hexCharVal(c: string) -> int {
    let code = strings.charCodeAt(c, 0)
    if code >= 48 && code <= 57 { return code - 48 }
    if code >= 97 && code <= 102 { return code - 97 + 10 }
    if code >= 65 && code <= 70 { return code - 65 + 10 }
    return 0
}

// Convert hex string to byte array
fn hexToBytes(hex: string) -> list {
    let bytes: list = []
    let i = 0
    while i < strings.length(hex) {
        let highVal = hexCharVal(strings.charAt(hex, i))
        let lowVal = hexCharVal(strings.charAt(hex, i + 1))
        bytes[arrays.length(bytes)] = (highVal * 16 + lowVal) & 0xFF
        i = i + 2
    }
    return bytes
}

// HMAC-SHA256
fn hmacSha256(key: string, message: string) -> string {
    let blockSize = 64
    let keyBytes: list = []
    let i = 0
    while i < strings.length(key) {
        keyBytes[i] = strings.charCodeAt(key, i) & 0xFF
        i = i + 1
    }
    if arrays.length(keyBytes) > blockSize {
        let hashedKey = sha256Bytes(keyBytes)
        keyBytes = hexToBytes(hashedKey)
    }
    while arrays.length(keyBytes) < blockSize {
        keyBytes[arrays.length(keyBytes)] = 0
    }
    let ipad: list = []
    let opad: list = []
    let k = 0
    while k < blockSize {
        ipad[k] = (keyBytes[k] ^ 0x36) & 0xFF
        opad[k] = (keyBytes[k] ^ 0x5c) & 0xFF
        k = k + 1
    }
    let innerBytes: list = []
    let m = 0
    while m < blockSize {
        innerBytes[m] = ipad[m]
        m = m + 1
    }
    let n = 0
    while n < strings.length(message) {
        innerBytes[arrays.length(innerBytes)] = strings.charCodeAt(message, n) & 0xFF
        n = n + 1
    }
    let innerHash = sha256Bytes(innerBytes)
    let outerBytes: list = []
    let p = 0
    while p < blockSize {
        outerBytes[p] = opad[p]
        p = p + 1
    }
    let hashBytes = hexToBytes(innerHash)
    let q = 0
    while q < arrays.length(hashBytes) {
        outerBytes[arrays.length(outerBytes)] = hashBytes[q]
        q = q + 1
    }
    return sha256Bytes(outerBytes)
}

// Constant-time string comparison
fn constantTimeEquals(a: string, b: string) -> bool {
    if strings.length(a) != strings.length(b) { return false }
    let result = 0
    let i = 0
    while i < strings.length(a) {
        result = result | (strings.charCodeAt(a, i) ^ strings.charCodeAt(b, i))
        i = i + 1
    }
    return result == 0
}
