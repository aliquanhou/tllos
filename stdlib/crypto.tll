// SHA-256 and HMAC-SHA256 implementation in TLL (P0-15 blockchain dogfooding)
// Uses bitwise operations: &, |, ^, ~, <<, >>

fn rotr(x: int, n: int) -> int {
    let ux = x & 0xFFFFFFFF
    let un = n & 31
    return ((ux >> un) | (ux << (32 - un))) & 0xFFFFFFFF
}

// Pad raw byte array to 512-bit blocks
fn sha256_pad_bytes(rawBytes: list) -> list {
    let bytes: list = []
    let i = 0
    let len = arrays.length(rawBytes)
    while i < len {
        bytes[i] = rawBytes[i] & 0xFF
        i = i + 1
    }
    let bitLen = len * 8
    bytes[arrays.length(bytes)] = 0x80
    while (arrays.length(bytes) % 64) != 56 {
        bytes[arrays.length(bytes)] = 0
    }
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = (bitLen >> 24) & 0xFF
    bytes[arrays.length(bytes)] = (bitLen >> 16) & 0xFF
    bytes[arrays.length(bytes)] = (bitLen >> 8) & 0xFF
    bytes[arrays.length(bytes)] = bitLen & 0xFF
    return bytes
}

// Core SHA-256: takes padded byte array, returns hex hash string
fn sha256_core(bytes: list) -> string {
    let K = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
    let H = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]
    let numBlocks = arrays.length(bytes) / 64
    let block = 0
    while block < numBlocks {
        let words: list = []
        let wi = 0
        while wi < 16 {
            let bi = block * 64 + wi * 4
            words[wi] = ((bytes[bi] << 24) | (bytes[bi + 1] << 16) | (bytes[bi + 2] << 8) | bytes[bi + 3]) & 0xFFFFFFFF
            wi = wi + 1
        }
        let t = 16
        while t < 64 {
            let w15 = words[t - 15]
            let w2 = words[t - 2]
            let s0 = rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3)
            let s1 = rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10)
            words[t] = (words[t - 16] + s0 + words[t - 7] + s1) & 0xFFFFFFFF
            t = t + 1
        }
        let a = H[0]
        let b = H[1]
        let c = H[2]
        let d = H[3]
        let e = H[4]
        let f = H[5]
        let g = H[6]
        let h = H[7]
        let i = 0
        while i < 64 {
            let S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch = (e & f) ^ ((0xFFFFFFFF ^ e) & g)
            let temp1 = (h + S1 + ch + K[i] + words[i]) & 0xFFFFFFFF
            let S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let temp2 = (S0 + maj) & 0xFFFFFFFF
            h = g
            g = f
            f = e
            e = (d + temp1) & 0xFFFFFFFF
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & 0xFFFFFFFF
            i = i + 1
        }
        H[0] = (H[0] + a) & 0xFFFFFFFF
        H[1] = (H[1] + b) & 0xFFFFFFFF
        H[2] = (H[2] + c) & 0xFFFFFFFF
        H[3] = (H[3] + d) & 0xFFFFFFFF
        H[4] = (H[4] + e) & 0xFFFFFFFF
        H[5] = (H[5] + f) & 0xFFFFFFFF
        H[6] = (H[6] + g) & 0xFFFFFFFF
        H[7] = (H[7] + h) & 0xFFFFFFFF
        block = block + 1
    }
    let hex = "0123456789abcdef"
    let result = ""
    let hi = 0
    while hi < 8 {
        let val = H[hi]
        result = result + strings.charAt(hex, (val >> 28) & 0xF)
        result = result + strings.charAt(hex, (val >> 24) & 0xF)
        result = result + strings.charAt(hex, (val >> 20) & 0xF)
        result = result + strings.charAt(hex, (val >> 16) & 0xF)
        result = result + strings.charAt(hex, (val >> 12) & 0xF)
        result = result + strings.charAt(hex, (val >> 8) & 0xF)
        result = result + strings.charAt(hex, (val >> 4) & 0xF)
        result = result + strings.charAt(hex, val & 0xF)
        hi = hi + 1
    }
    return result
}

// SHA-256 from string
fn sha256(message: string) -> string {
    let rawBytes: list = []
    let i = 0
    let len = strings.length(message)
    while i < len {
        rawBytes[i] = strings.charCodeAt(message, i) & 0xFF
        i = i + 1
    }
    let bytes = sha256_pad_bytes(rawBytes)
    return sha256_core(bytes)
}

// SHA-256 from raw byte array
fn sha256Bytes(rawBytes: list) -> string {
    let bytes = sha256_pad_bytes(rawBytes)
    return sha256_core(bytes)
}

// Convert hex char to value (0-15)
fn hexCharVal(c: string) -> int {
    let code = strings.charCodeAt(c, 0)
    if code >= 48 && code <= 57 { return code - 48 }
    if code >= 97 && code <= 102 { return code - 97 + 10 }
    if code >= 65 && code <= 70 { return code - 65 + 10 }
    return 0
}

// Convert hex string to byte array
fn hexToBytes(hex: string) -> list {
    let bytes: list = []
    let i = 0
    while i < strings.length(hex) {
        let highVal = hexCharVal(strings.charAt(hex, i))
        let lowVal = hexCharVal(strings.charAt(hex, i + 1))
        bytes[arrays.length(bytes)] = (highVal * 16 + lowVal) & 0xFF
        i = i + 2
    }
    return bytes
}

// HMAC-SHA256
fn hmacSha256(key: string, message: string) -> string {
    let blockSize = 64
    let keyBytes: list = []
    let i = 0
    while i < strings.length(key) {
        keyBytes[i] = strings.charCodeAt(key, i) & 0xFF
        i = i + 1
    }
    if arrays.length(keyBytes) > blockSize {
        let hashedKey = sha256Bytes(keyBytes)
        keyBytes = hexToBytes(hashedKey)
    }
    while arrays.length(keyBytes) < blockSize {
        keyBytes[arrays.length(keyBytes)] = 0
    }
    let ipad: list = []
    let opad: list = []
    let k = 0
    while k < blockSize {
        ipad[k] = (keyBytes[k] ^ 0x36) & 0xFF
        opad[k] = (keyBytes[k] ^ 0x5c) & 0xFF
        k = k + 1
    }
    let innerBytes: list = []
    let m = 0
    while m < blockSize {
        innerBytes[m] = ipad[m]
        m = m + 1
    }
    let n = 0
    while n < strings.length(message) {
        innerBytes[arrays.length(innerBytes)] = strings.charCodeAt(message, n) & 0xFF
        n = n + 1
    }
    let innerHash = sha256Bytes(innerBytes)
    let outerBytes: list = []
    let p = 0
    while p < blockSize {
        outerBytes[p] = opad[p]
        p = p + 1
    }
    let hashBytes = hexToBytes(innerHash)
    let q = 0
    while q < arrays.length(hashBytes) {
        outerBytes[arrays.length(outerBytes)] = hashBytes[q]
        q = q + 1
    }
    return sha256Bytes(outerBytes)
}

// Constant-time string comparison
fn constantTimeEquals(a: string, b: string) -> bool {
    if strings.length(a) != strings.length(b) { return false }
    let result = 0
    let i = 0
    while i < strings.length(a) {
        result = result | (strings.charCodeAt(a, i) ^ strings.charCodeAt(b, i))
        i = i + 1
    }
    return result == 0
}

// ============================================================
// SHA-512 implementation (P0-15.19)
// TLL int is signed 64-bit, so we need logical right shift helper.
// ============================================================

// 64-bit logical right shift (TLL >> is arithmetic)
fn shr64(x: int, n: int) -> int {
    if n <= 0 { return x }
    if n >= 64 { return 0 }
    let result = x
    let i = 0
    while i < n {
        result = (result >> 1) & 0x7FFFFFFFFFFFFFFF
        i = i + 1
    }
    return result
}

// 64-bit rotate right
fn rotr64(x: int, n: int) -> int {
    let un = n & 63
    if un == 0 { return x }
    return (shr64(x, un) | (x << (64 - un)))
}

// Pad raw byte array to 1024-bit blocks (128 bytes)
fn sha512_pad_bytes(rawBytes: list) -> list {
    let bytes: list = []
    let i = 0
    let len = arrays.length(rawBytes)
    while i < len {
        bytes[i] = rawBytes[i] & 0xFF
        i = i + 1
    }
    let bitLenLow = (len * 8) & 0xFFFFFFFF
    bytes[arrays.length(bytes)] = 0x80
    while (arrays.length(bytes) % 128) != 112 {
        bytes[arrays.length(bytes)] = 0
    }
    // Append 128-bit length (high 64 bits = 0, low 64 bits = bitLen)
    let j = 0
    while j < 8 {
        bytes[arrays.length(bytes)] = 0
        j = j + 1
    }
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = 0
    bytes[arrays.length(bytes)] = (bitLenLow >> 24) & 0xFF
    bytes[arrays.length(bytes)] = (bitLenLow >> 16) & 0xFF
    bytes[arrays.length(bytes)] = (bitLenLow >> 8) & 0xFF
    bytes[arrays.length(bytes)] = bitLenLow & 0xFF
    return bytes
}

// Core SHA-512: takes padded byte array, returns hex hash string
fn sha512_core(bytes: list) -> string {
    let K = [
        0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
        0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
        0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
        0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
        0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
        0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
        0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
        0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
        0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
        0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
        0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
        0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
        0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
        0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
        0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
        0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
        0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
        0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
        0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
        0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
    ]
    let H = [
        0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
        0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
    ]
    let numBlocks = arrays.length(bytes) / 128
    let block = 0
    while block < numBlocks {
        let words: list = []
        let wi = 0
        while wi < 16 {
            let bi = block * 128 + wi * 8
            words[wi] = ((bytes[bi] << 56) | (bytes[bi + 1] << 48) | (bytes[bi + 2] << 40) | (bytes[bi + 3] << 32) | (bytes[bi + 4] << 24) | (bytes[bi + 5] << 16) | (bytes[bi + 6] << 8) | bytes[bi + 7])
            wi = wi + 1
        }
        let t = 16
        while t < 80 {
            let w15 = words[t - 15]
            let w2 = words[t - 2]
            let s0 = rotr64(w15, 1) ^ rotr64(w15, 8) ^ shr64(w15, 7)
            let s1 = rotr64(w2, 19) ^ rotr64(w2, 61) ^ shr64(w2, 6)
            words[t] = words[t - 16] + s0 + words[t - 7] + s1
            t = t + 1
        }
        let a = H[0]
        let b = H[1]
        let c = H[2]
        let d = H[3]
        let e = H[4]
        let f = H[5]
        let g = H[6]
        let h = H[7]
        let i = 0
        while i < 80 {
            let S1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
            let ch = (e & f) ^ ((~e) & g)
            let temp1 = h + S1 + ch + K[i] + words[i]
            let S0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let temp2 = S0 + maj
            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
            i = i + 1
        }
        H[0] = H[0] + a
        H[1] = H[1] + b
        H[2] = H[2] + c
        H[3] = H[3] + d
        H[4] = H[4] + e
        H[5] = H[5] + f
        H[6] = H[6] + g
        H[7] = H[7] + h
        block = block + 1
    }
    let hex = "0123456789abcdef"
    let result = ""
    let hi = 0
    while hi < 8 {
        let val = H[hi]
        result = result + strings.charAt(hex, (val >> 60) & 0xF)
        result = result + strings.charAt(hex, (val >> 56) & 0xF)
        result = result + strings.charAt(hex, (val >> 52) & 0xF)
        result = result + strings.charAt(hex, (val >> 48) & 0xF)
        result = result + strings.charAt(hex, (val >> 44) & 0xF)
        result = result + strings.charAt(hex, (val >> 40) & 0xF)
        result = result + strings.charAt(hex, (val >> 36) & 0xF)
        result = result + strings.charAt(hex, (val >> 32) & 0xF)
        result = result + strings.charAt(hex, (val >> 28) & 0xF)
        result = result + strings.charAt(hex, (val >> 24) & 0xF)
        result = result + strings.charAt(hex, (val >> 20) & 0xF)
        result = result + strings.charAt(hex, (val >> 16) & 0xF)
        result = result + strings.charAt(hex, (val >> 12) & 0xF)
        result = result + strings.charAt(hex, (val >> 8) & 0xF)
        result = result + strings.charAt(hex, (val >> 4) & 0xF)
        result = result + strings.charAt(hex, val & 0xF)
        hi = hi + 1
    }
    return result
}

// SHA-512 from string
fn sha512(message: string) -> string {
    let rawBytes: list = []
    let i = 0
    let len = strings.length(message)
    while i < len {
        rawBytes[i] = strings.charCodeAt(message, i) & 0xFF
        i = i + 1
    }
    let bytes = sha512_pad_bytes(rawBytes)
    return sha512_core(bytes)
}

// SHA-512 from raw byte array
// SHA-512 from raw byte array, returns 64-byte array
fn sha512Bytes(rawBytes: list) -> list {
    let bytes = sha512_pad_bytes(rawBytes)
    let hex = sha512_core(bytes)
    let result: list = []
    let i = 0
    while i < 64 {
        let high = hex_char_val(strings.charAt(hex, i * 2))
        let low = hex_char_val(strings.charAt(hex, i * 2 + 1))
        result[i] = (high << 4) | low
        i = i + 1
    }
    return result
}

// Helper: convert hex character to 0-15
fn hex_char_val(c: string) -> int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    if c == "a" || c == "A" { return 10 }
    if c == "b" || c == "B" { return 11 }
    if c == "c" || c == "C" { return 12 }
    if c == "d" || c == "D" { return 13 }
    if c == "e" || c == "E" { return 14 }
    return 15
}
