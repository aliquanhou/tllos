// TLL Event-driven Reactor + Channel (P0-15.13 refactored)
//
// ARCHITECTURE DECISION:
// This module provides an Event-driven Reactor pattern (select + timers + callbacks)
// and Channel (inter-callback data queue).
//
// NOTE: A true cooperative Task scheduler (with yield/resume) requires VM-level
// coroutine support. Without VM yield, a "Task" is just a callback that runs to
// completion — that is not real concurrency and was rolled back.
//
// The Reactor pattern here is the correct layer for now:
//   - IO events (tcp.select) dispatch to callbacks
//   - Timer events dispatch to callbacks
//   - Channels pass data between callbacks
//   - Single-threaded, event-driven, no preemption
//
// When TLL gains VM-level coroutines, a true Task layer can be built on top.

// === Channel ===
// O(1) ring buffer FIFO queue for passing data between coroutines/callbacks.
// P0-15.15: Replaced O(n) array-shift recv with O(1) circular buffer.
// Internal layout: { buf, head, tail, count, capacity, closed }
fn createChannel() -> map {
    let cap = 16
    let buf: list = []
    let _cci = 0
    while _cci < cap {
        arrays.push(buf, null)
        _cci = _cci + 1
    }
    return { buf: buf, head: 0, tail: 0, count: 0, capacity: cap, closed: false }
}

// Grow the ring buffer to double capacity. O(n) but amortized O(1) per send.
fn channel_grow(ch: map) -> void {
    let _cg_oldCap = ch.capacity
    let _cg_newCap = _cg_oldCap * 2
    let _cg_newBuf: list = []
    let _cgi = 0
    while _cgi < _cg_newCap {
        arrays.push(_cg_newBuf, null)
        _cgi = _cgi + 1
    }
    // Copy elements in order from old buffer starting at head
    let _cgj = 0
    while _cgj < ch.count {
        let _cg_idx = (ch.head + _cgj) % _cg_oldCap
        _cg_newBuf[_cgj] = ch.buf[_cg_idx]
        _cgj = _cgj + 1
    }
    ch.buf = _cg_newBuf
    ch.head = 0
    ch.tail = ch.count
    ch.capacity = _cg_newCap
}

fn sendChannel(ch: map, value) -> bool {
    if ch.closed { return false }
    if ch.count >= ch.capacity {
        channel_grow(ch)
    }
    ch.buf[ch.tail] = value
    ch.tail = (ch.tail + 1) % ch.capacity
    ch.count = ch.count + 1
    // P0-15.16: Wake any coroutine waiting on this channel
    coroutine.wakeChannel(ch)
    return true
}

fn recvChannel(ch: map) {
    // P0-15.16: If channel is empty, suspend until a sender wakes us.
    // This is true await, not polling.
    while ch.count == 0 {
        if ch.closed { return null }
        coroutine.waitChannel(ch)
    }
    let val = ch.buf[ch.head]
    ch.buf[ch.head] = null  // clear reference for GC
    ch.head = (ch.head + 1) % ch.capacity
    ch.count = ch.count - 1
    return val
}

fn tryRecvChannel(ch: map) -> map {
    if ch.count == 0 {
        return { ok: false, value: null }
    }
    return { ok: true, value: recvChannel(ch) }
}

fn lenChannel(ch: map) -> int {
    return ch.count
}

fn closeChannel(ch: map) -> void {
    ch.closed = true
    // P0-15.16: Wake all waiting consumers so they can observe closed state
    coroutine.wakeChannel(ch)
}

// === Event Reactor ===
// Single-threaded event loop: tcp.select for IO + timer callbacks.
fn createReactor() -> map {
    return {
        ioHandlers: [],   // { fd, ioType, onAccept, onData, onClose }
        timerHandlers: [], // { intervalMs, lastRun, callback }
        running: false,
        tickCount: 0
    }
}

// Register a server socket: when a connection arrives, onAccept(newFd) is called.
fn onServerEvent(reactor: map, fd: int, onAcceptFn) -> void {
    arrays.push(reactor.ioHandlers, { fd: fd, ioType: "server", onAccept: onAcceptFn })
}

// Register a client socket: when data arrives, onData(ctx); when closed, onClose(ctx).
fn onIOEvent(reactor: map, fd: int, onDataFn, onCloseFn) -> void {
    arrays.push(reactor.ioHandlers, { fd: fd, ioType: "client", onData: onDataFn, onClose: onCloseFn })
}

// Register a periodic timer: callback is called every intervalMs.
fn onTimerEvent(reactor: map, intervalMs: int, callback) -> void {
    arrays.push(reactor.timerHandlers, { intervalMs: intervalMs, lastRun: 0, callback: callback })
}

// Remove all handlers for a given fd (called when a connection closes).
fn removeFdHandlers(reactor: map, fd: int) -> void {
    let _rfh_newHandlers: list = []
    let _rfh_i = 0
    while _rfh_i < arrays.length(reactor.ioHandlers) {
        if arrays.get(reactor.ioHandlers, _rfh_i).fd != fd {
            arrays.push(_rfh_newHandlers, arrays.get(reactor.ioHandlers, _rfh_i))
        }
        _rfh_i = _rfh_i + 1
    }
    reactor.ioHandlers = _rfh_newHandlers
}

// Run one reactor tick: process due timers, then select on IO fds, dispatch events.
// Returns true if any event was processed.
fn reactorTick(reactor: map, selectTimeoutMs: int) -> bool {
    reactor.tickCount = reactor.tickCount + 1
    let _rt_now = time.nowMs()
    let _rt_any = false

    // 1. Process due timers
    let _rt_ti = 0
    while _rt_ti < arrays.length(reactor.timerHandlers) {
        let _rt_timer = arrays.get(reactor.timerHandlers, _rt_ti)
        if now - timer.lastRun >= timer.intervalMs {
            timer.lastRun = now
            timer.callback({ tick: reactor.tickCount, now: now })
            _rt_any = true
        }
        _rt_ti = _rt_ti + 1
    }

    // 2. Build fd list and select
    if arrays.length(reactor.ioHandlers) > 0 {
        let _rt_fdList: list = []
        let _rt_fi = 0
        while _rt_fi < arrays.length(reactor.ioHandlers) {
            arrays.push(_rt_fdList, arrays.get(reactor.ioHandlers, _rt_fi).fd)
            _rt_fi = _rt_fi + 1
        }
        let _rt_ready = tcp.select(_rt_fdList, selectTimeoutMs)

        // 3. Dispatch ready fds
        let _rt_ri = 0
        while _rt_ri < arrays.length(_rt_ready) {
            let _rt_rfd = arrays.get(_rt_ready, _rt_ri)
            let _rt_fi2 = 0
            while _rt_fi2 < arrays.length(reactor.ioHandlers) {
                let _rt_handler = arrays.get(reactor.ioHandlers, _rt_fi2)
                if _rt_handler.fd == _rt_rfd {
                    if _rt_handler.ioType == "server" {
                        // Server fd: accept new connection
                        let _rt_newFd = tcp.accept(_rt_rfd)
                        if _rt_newFd >= 0 {
                            tcp.setTimeout(_rt_newFd, 100)
                            _rt_handler.onAccept({ fd: _rt_newFd, serverFd: _rt_rfd, tick: reactor.tickCount })
                            _rt_any = true
                        }
                    } else {
                        // Client fd: recv data
                        let _rt_data = tcp.recv(_rt_rfd, 65536)
                        if strings.length(_rt_data) > 0 {
                            _rt_handler.onData({ fd: _rt_rfd, data: _rt_data, tick: reactor.tickCount })
                            _rt_any = true
                        } else {
                            // Connection closed
                            if _rt_handler.onClose != null {
                                _rt_handler.onClose({ fd: _rt_rfd, tick: reactor.tickCount })
                            }
                            tcp.close(_rt_rfd)
                            removeFdHandlers(reactor, _rt_rfd)
                        }
                    }
                }
                _rt_fi2 = _rt_fi2 + 1
            }
            _rt_ri = _rt_ri + 1
        }
    }

    return _rt_any
}

// Run the reactor for maxTicks ticks. Each tick waits up to selectTimeoutMs for IO.
fn runReactor(reactor: map, maxTicks: int, selectTimeoutMs: int) -> void {
    reactor.running = true
    let _rr_tick = 0
    while _rr_tick < maxTicks && reactor.running {
        reactorTick(reactor, selectTimeoutMs)
        _rr_tick = _rr_tick + 1
    }
    reactor.running = false
}

fn stopReactor(reactor: map) -> void {
    reactor.running = false
}
