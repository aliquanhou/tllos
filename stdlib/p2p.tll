// TLL P2P Network Layer - P0-15.17 4-Node Real Blockchain Network
// Architecture: per-peer coroutine + coroutine.waitRead (non-blocking IO yield)
// Message framing: 4-byte length prefix (big-endian ASCII hex) + JSON payload
// Fix v2: peer.alive flag to prevent fd-reuse race (old receive loop killing new connection)
// Fix v1: use fd as stable peer identifier (indices shift after removal), double-check EOF

// Create a new P2P node
fn createP2PNode(nodeId: string, host: string, port: int) -> map {
    return {
        nodeId: nodeId,
        host: host,
        port: port,
        serverFd: -1,
        peers: [],        // list of { nodeId, host, port, fd, lastSeen, recvBuffer, alive }
        messageHandlers: {},  // type -> handler function(msg, peer)
        running: false,
        onDisconnect: null  // optional callback(peerNodeId) invoked when a peer disconnects
    }
}

// Convert integer to 4-digit hex string
fn intToHex4(n: int) -> string {
    let _ih_hex = "0123456789abcdef"
    let _ih_result = ""
    let _ih_i = 0
    while _ih_i < 4 {
        let _ih_digit = n % 16
        _ih_result = strings.charAt(_ih_hex, _ih_digit) + _ih_result
        n = convert.toInt(n / 16)
        _ih_i = _ih_i + 1
    }
    return _ih_result
}

// Convert hex string to integer
fn hexToInt(hex: string) -> int {
    let _hi_result = 0
    let _hi_i = 0
    let _hi_len = strings.length(hex)
    while _hi_i < _hi_len {
        let _hi_c = strings.charAt(hex, _hi_i)
        let _hi_digit = 0
        if _hi_c == "0" { _hi_digit = 0 }
        else if _hi_c == "1" { _hi_digit = 1 }
        else if _hi_c == "2" { _hi_digit = 2 }
        else if _hi_c == "3" { _hi_digit = 3 }
        else if _hi_c == "4" { _hi_digit = 4 }
        else if _hi_c == "5" { _hi_digit = 5 }
        else if _hi_c == "6" { _hi_digit = 6 }
        else if _hi_c == "7" { _hi_digit = 7 }
        else if _hi_c == "8" { _hi_digit = 8 }
        else if _hi_c == "9" { _hi_digit = 9 }
        else if _hi_c == "a" || _hi_c == "A" { _hi_digit = 10 }
        else if _hi_c == "b" || _hi_c == "B" { _hi_digit = 11 }
        else if _hi_c == "c" || _hi_c == "C" { _hi_digit = 12 }
        else if _hi_c == "d" || _hi_c == "D" { _hi_digit = 13 }
        else if _hi_c == "e" || _hi_c == "E" { _hi_digit = 14 }
        else if _hi_c == "f" || _hi_c == "F" { _hi_digit = 15 }
        _hi_result = _hi_result * 16 + _hi_digit
        _hi_i = _hi_i + 1
    }
    return _hi_result
}

// Encode message with length prefix framing
fn encodeMessage(msgType: string, payload: map) -> string {
    let _em_envelope = {
        type: msgType,
        payload: payload
    }
    let _em_jsonStr = json.stringify(_em_envelope)
    let _em_len = strings.length(_em_jsonStr)
    let _em_lenHex = intToHex4(_em_len)
    return _em_lenHex + _em_jsonStr
}

// Decode messages from raw data (may contain partial or multiple messages)
// Returns { messages: [], remaining: "" }
fn decodeMessages(rawData: string) -> map {
    let _dm_result = { messages: [], remaining: rawData }
    let _dm_data = rawData
    while strings.length(_dm_data) >= 4 {
        let _dm_lenHex = strings.substring(_dm_data, 0, 4)
        let _dm_msgLen = hexToInt(_dm_lenHex)
        if _dm_msgLen <= 0 || _dm_msgLen > 1048576 {
            break  // invalid or oversized message (1MB max)
        }
        if strings.length(_dm_data) < 4 + _dm_msgLen {
            break  // partial message, wait for more data
        }
        let _dm_jsonStr = strings.substring(_dm_data, 4, 4 + _dm_msgLen)
        let _dm_msg = json.parse(_dm_jsonStr)
        arrays.push(_dm_result.messages, _dm_msg)
        _dm_data = strings.substring(_dm_data, 4 + _dm_msgLen, strings.length(_dm_data))
    }
    _dm_result.remaining = _dm_data
    return _dm_result
}

// Start listening for incoming connections
fn p2pListen(node: map) -> bool {
    let _pl_fd = tcp.listen(node.host, node.port)
    if _pl_fd < 0 {
        io.println("[" + node.nodeId + "] Failed to listen on " + node.host + ":" + convert.toString(node.port))
        return false
    }
    node.serverFd = _pl_fd
    io.println("[" + node.nodeId + "] Listening on " + node.host + ":" + convert.toString(node.port))
    return true
}

// Connect to a peer (uses non-blocking waitRead for handshake response)
fn p2pConnect(node: map, host: string, port: int) -> bool {
    let _pc_fd = tcp.connect(host, port)
    if _pc_fd < 0 {
        io.println("[" + node.nodeId + "] Failed to connect to " + host + ":" + convert.toString(port))
        return false
    }
    tcp.setTimeout(_pc_fd, 5000)
    // Send handshake
    let _pc_handshake = {
        nodeId: node.nodeId,
        host: node.host,
        port: node.port,
        version: "0.1.0"
    }
    let _pc_msg = encodeMessage("handshake", _pc_handshake)
    tcp.send(_pc_fd, _pc_msg)
    // Non-blocking wait for handshake response (yields coroutine)
    coroutine.waitRead(_pc_fd)
    let _pc_resp = tcp.tryRecv(_pc_fd, 65536)
    let _pc_decoded = decodeMessages(_pc_resp)
    if arrays.length(_pc_decoded.messages) > 0 {
        let _pc_respMsg = _pc_decoded.messages[0]
        if _pc_respMsg.type == "handshake" {
            let _pc_peer = {
                nodeId: _pc_respMsg.payload.nodeId,
                host: host,
                port: port,
                fd: _pc_fd,
                lastSeen: time.nowMs(),
                recvBuffer: _pc_decoded.remaining,
                alive: true
            }
            arrays.push(node.peers, _pc_peer)
            let _pc_peerIdx = arrays.length(node.peers) - 1
            io.println("[" + node.nodeId + "] Connected to peer " + _pc_peer.nodeId + " (" + host + ":" + convert.toString(port) + ")")
            // Start per-peer receive coroutine (pass fd, not index - indices shift after removal)
            if node.running {
                coroutine.spawn(p2pPeerReceiveLoop, node, _pc_fd)
            }
            return true
        }
    }
    tcp.close(_pc_fd)
    return false
}

// Register a message handler
fn p2pRegisterHandler(node: map, msgType: string, handler) -> void {
    node.messageHandlers[msgType] = handler
}

// Send message to a specific peer
fn p2pSendToPeer(node: map, peerIndex: int, msgType: string, payload: map) -> bool {
    if peerIndex < 0 || peerIndex >= arrays.length(node.peers) { return false }
    let _psp_peer = node.peers[peerIndex]
    if !_psp_peer.alive { return false }
    let _psp_msg = encodeMessage(msgType, payload)
    let _psp_sent = tcp.send(_psp_peer.fd, _psp_msg)
    if _psp_sent > 0 {
        _psp_peer.lastSeen = time.nowMs()
        return true
    }
    return false
}

// Broadcast message to all peers
fn p2pBroadcast(node: map, msgType: string, payload: map) -> int {
    let _pb_sent = 0
    let _pb_i = 0
    while _pb_i < arrays.length(node.peers) {
        if node.peers[_pb_i].alive && p2pSendToPeer(node, _pb_i, msgType, payload) {
            _pb_sent = _pb_sent + 1
        }
        _pb_i = _pb_i + 1
    }
    return _pb_sent
}

// Process received data for one peer: append to buffer, decode messages, dispatch handlers
// Returns true if peer is still connected, false if disconnected
fn p2pProcessPeerData(node: map, peerIndex: int, data: string) -> bool {
    if peerIndex < 0 || peerIndex >= arrays.length(node.peers) { return false }
    let _ppd_peer = node.peers[peerIndex]
    if !_ppd_peer.alive { return false }
    // Check for connection close (empty data from tryRecv means connection closed or would-block)
    if strings.length(data) == 0 {
        return true  // would-block, not a disconnect
    }
    // Append to receive buffer
    _ppd_peer.recvBuffer = _ppd_peer.recvBuffer + data
    _ppd_peer.lastSeen = time.nowMs()
    // Decode all complete messages
    let _ppd_decoded = decodeMessages(_ppd_peer.recvBuffer)
    _ppd_peer.recvBuffer = _ppd_decoded.remaining
    // Dispatch each message
    let _ppd_i = 0
    while _ppd_i < arrays.length(_ppd_decoded.messages) {
        let _ppd_msg = _ppd_decoded.messages[_ppd_i]
        let _ppd_handler = node.messageHandlers[_ppd_msg.type]
        if _ppd_handler != null {
            _ppd_handler(_ppd_msg, _ppd_peer, node)
        } else {
            io.println("[" + node.nodeId + "] No handler for message type: " + _ppd_msg.type)
        }
        _ppd_i = _ppd_i + 1
    }
    return true
}

// Internal: find peer index by fd (stable identifier, since indices shift after removal)
fn _p2pFindPeerByFd(node: map, fd: int) -> int {
    let _fpf_i = 0
    while _fpf_i < arrays.length(node.peers) {
        if node.peers[_fpf_i].fd == fd { return _fpf_i }
        _fpf_i = _fpf_i + 1
    }
    return -1
}

// Per-peer receive loop (runs as a coroutine, uses non-blocking waitRead)
// Fix v2: checks peer.alive every iteration to prevent fd-reuse race
// Fix v1: takes fd (stable) instead of peerIndex (unstable), re-looks-up index each iteration
fn p2pPeerReceiveLoop(node: map, peerFd: int) -> void {
    while node.running {
        // Re-lookup current index by fd every iteration (indices shift after peer removal)
        let _pprl_idx = _p2pFindPeerByFd(node, peerFd)
        if _pprl_idx < 0 { break }
        let _pprl_peer = node.peers[_pprl_idx]
        if _pprl_peer == null { break }
        // CRITICAL: check alive flag - if this peer was disconnected (even if fd was reused
        // by a new connection, the new peer will have alive=true and a different map identity)
        if !_pprl_peer.alive {
            io.println("[" + node.nodeId + "] Receive loop exiting for dead peer fd=" + convert.toString(peerFd))
            break
        }
        // Non-blocking wait for data (yields coroutine, VM can run other coroutines)
        coroutine.waitRead(_pprl_peer.fd)
        if !node.running { break }
        // Re-verify peer still exists and is alive after waitRead
        let _pprl_idx2 = _p2pFindPeerByFd(node, peerFd)
        if _pprl_idx2 < 0 { break }
        let _pprl_peer2 = node.peers[_pprl_idx2]
        if !_pprl_peer2.alive { break }
        // Non-blocking receive
        let _pprl_data = tcp.tryRecv(_pprl_peer2.fd, 65536)
        if strings.length(_pprl_data) == 0 {
            // Empty could mean EOF or spurious wakeup. Double-check after short sleep.
            coroutine.sleep(5)
            if !node.running { break }
            let _pprl_retryIdx = _p2pFindPeerByFd(node, peerFd)
            if _pprl_retryIdx < 0 { break }
            let _pprl_retryPeer = node.peers[_pprl_retryIdx]
            if !_pprl_retryPeer.alive { break }
            let _pprl_data2 = tcp.tryRecv(_pprl_retryPeer.fd, 65536)
            if strings.length(_pprl_data2) == 0 {
                // Confirmed EOF - mark dead FIRST (before removal), so fd-reuse race is safe
                _pprl_retryPeer.alive = false
                io.println("[" + node.nodeId + "] Peer " + _pprl_retryPeer.nodeId + " disconnected (EOF)")
                tcp.close(_pprl_retryPeer.fd)
                // Invoke disconnect callback if registered (for blockchain node disconnectCount etc.)
                if node.onDisconnect != null {
                    node.onDisconnect(node, _pprl_retryPeer.nodeId)
                }
                let _pprl_removeIdx = _p2pFindPeerByFd(node, peerFd)
                if _pprl_removeIdx >= 0 {
                    _p2pRemovePeerAt(node, _pprl_removeIdx)
                }
                break
            }
            _pprl_data = _pprl_data2
        }
        // Process data (use current re-looked-up index)
        let _pprl_curIdx = _p2pFindPeerByFd(node, peerFd)
        if _pprl_curIdx < 0 { break }
        let _pprl_curPeer = node.peers[_pprl_curIdx]
        if !_pprl_curPeer.alive { break }
        let _pprl_alive = p2pProcessPeerData(node, _pprl_curIdx, _pprl_data)
        if !_pprl_alive { break }
    }
}

// Server accept loop (runs as a coroutine, uses non-blocking waitRead)
fn p2pAcceptLoop(node: map) -> void {
    while node.running && node.serverFd >= 0 {
        // Non-blocking wait for incoming connection (yields coroutine)
        coroutine.waitRead(node.serverFd)
        if !node.running { break }
        // Non-blocking accept
        let _pal_clientFd = tcp.tryAccept(node.serverFd, 0)
        if _pal_clientFd < 0 { continue }
        tcp.setTimeout(_pal_clientFd, 5000)
        // Non-blocking wait for handshake data
        coroutine.waitRead(_pal_clientFd)
        if !node.running { tcp.close(_pal_clientFd); break }
        let _pal_data = tcp.tryRecv(_pal_clientFd, 65536)
        if strings.length(_pal_data) == 0 {
            tcp.close(_pal_clientFd)
            continue
        }
        // Process handshake
        let _pal_decoded = decodeMessages(_pal_data)
        if arrays.length(_pal_decoded.messages) > 0 {
            let _pal_msg = _pal_decoded.messages[0]
            if _pal_msg.type == "handshake" {
                let _pal_peer = {
                    nodeId: _pal_msg.payload.nodeId,
                    host: _pal_msg.payload.host,
                    port: _pal_msg.payload.port,
                    fd: _pal_clientFd,
                    lastSeen: time.nowMs(),
                    recvBuffer: _pal_decoded.remaining,
                    alive: true
                }
                arrays.push(node.peers, _pal_peer)
                io.println("[" + node.nodeId + "] Peer connected: " + _pal_peer.nodeId)
                // Send handshake response
                let _pal_resp = {
                    nodeId: node.nodeId,
                    host: node.host,
                    port: node.port,
                    version: "0.1.0"
                }
                tcp.send(_pal_clientFd, encodeMessage("handshake", _pal_resp))
                // Start per-peer receive coroutine (pass fd, not index)
                coroutine.spawn(p2pPeerReceiveLoop, node, _pal_clientFd)
                continue
            }
        }
        tcp.close(_pal_clientFd)
    }
}

// Start the node: launch accept loop + per-peer receive loops
fn p2pStart(node: map) -> void {
    if node.running { return }
    node.running = true
    if node.serverFd >= 0 {
        coroutine.spawn(p2pAcceptLoop, node)
    }
    let _ps_i = 0
    while _ps_i < arrays.length(node.peers) {
        if node.peers[_ps_i].alive {
            coroutine.spawn(p2pPeerReceiveLoop, node, node.peers[_ps_i].fd)
        }
        _ps_i = _ps_i + 1
    }
    io.println("[" + node.nodeId + "] Node started (accept loop + " + convert.toString(arrays.length(node.peers)) + " peer loops)")
}

// Send ping to all peers
fn p2pPingAll(node: map) -> int {
    let _pp_ping = { timestamp: time.nowMs() }
    return p2pBroadcast(node, "ping", _pp_ping)
}

// Internal: remove peer at index (arrays.remove does not exist in TLL stdlib)
fn _p2pRemovePeerAt(node: map, index: int) -> void {
    if index < 0 || index >= arrays.length(node.peers) { return }
    let _rpa_newPeers: list = []
    let _rpa_i = 0
    while _rpa_i < arrays.length(node.peers) {
        if _rpa_i != index { arrays.push(_rpa_newPeers, node.peers[_rpa_i]) }
        _rpa_i = _rpa_i + 1
    }
    node.peers = _rpa_newPeers
}

// Disconnect from a peer
fn p2pDisconnect(node: map, peerIndex: int) -> void {
    if peerIndex < 0 || peerIndex >= arrays.length(node.peers) { return }
    let _pd_peer = node.peers[peerIndex]
    // Mark dead FIRST (before close/removal), so any receive loop still running will exit
    // safely even if fd is reused by a new connection
    _pd_peer.alive = false
    io.println("[" + node.nodeId + "] Disconnecting peer " + _pd_peer.nodeId)
    tcp.close(_pd_peer.fd)
    _p2pRemovePeerAt(node, peerIndex)
}

// Get peer count
fn p2pPeerCount(node: map) -> int {
    return arrays.length(node.peers)
}

// Find peer by nodeId
fn p2pFindPeer(node: map, nodeId: string) -> int {
    let _pf_i = 0
    while _pf_i < arrays.length(node.peers) {
        if node.peers[_pf_i].nodeId == nodeId { return _pf_i }
        _pf_i = _pf_i + 1
    }
    return -1
}

// Reconnect to a peer by host/port (closes existing if any)
fn p2pReconnect(node: map, host: string, port: int) -> bool {
    let _pr_i = 0
    while _pr_i < arrays.length(node.peers) {
        if node.peers[_pr_i].host == host && node.peers[_pr_i].port == port {
            let _pr_oldPeerId = node.peers[_pr_i].nodeId
            node.peers[_pr_i].alive = false
            tcp.close(node.peers[_pr_i].fd)
            // Invoke disconnect callback for the old connection
            if node.onDisconnect != null {
                node.onDisconnect(node, _pr_oldPeerId)
            }
            _p2pRemovePeerAt(node, _pr_i)
            break
        }
        _pr_i = _pr_i + 1
    }
    return p2pConnect(node, host, port)
}

// Stop the node: set running=false, disconnect all peers, close server
fn p2pStop(node: map) -> void {
    io.println("[" + node.nodeId + "] Stopping node...")
    node.running = false
    // Mark all peers dead first (so receive loops exit safely)
    let _ps_i = 0
    while _ps_i < arrays.length(node.peers) {
        node.peers[_ps_i].alive = false
        _ps_i = _ps_i + 1
    }
    // Disconnect all peers
    while arrays.length(node.peers) > 0 {
        p2pDisconnect(node, 0)
    }
    // Close server
    if node.serverFd >= 0 {
        tcp.close(node.serverFd)
        node.serverFd = -1
    }
    io.println("[" + node.nodeId + "] Node stopped")
}
