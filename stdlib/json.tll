// TLL Standard Library - JSON operations
// Implemented in TLL itself
// Note: Uses builtin json.parse/json.stringify for core operations,
// adds helper functions built on top.

// Parse JSON string to TLL value
fn json_parse(s: string) -> any {
    return json.parse(s)
}

// Stringify TLL value to JSON string
fn json_stringify(value: any) -> string {
    return json.stringify(value)
}

// Get nested value by path (array of keys)
fn json_get(obj: any, path: list) -> any {
    let current = obj
    let i = 0
    while i < arrays.length(path) {
        let key = arrays.get(path, i)
        if convert.typeOf(current) == "map" {
            current = current[key]
        } else if convert.typeOf(current) == "array" {
            current = arrays.get(current, convert.toInt(key))
        } else {
            return null
        }
        i = i + 1
    }
    return current
}

// Check if key exists in object
fn json_hasKey(obj: map, key: string) -> bool {
    let keys = json_objectKeys(obj)
    let i = 0
    while i < arrays.length(keys) {
        if arrays.get(keys, i) == key {
            return true
        }
        i = i + 1
    }
    return false
}

// Get all keys of an object
fn json_objectKeys(obj: map) -> list {
    // Use stringify + parse trick to enumerate keys
    let s = json.stringify(obj)
    let result: list = []
    // Simple key extraction: find "key": patterns
    let i = 0
    while i < strings.length(s) {
        if strings.charAt(s, i) == "\"" {
            // Find end of key
            let j = i + 1
            let key = ""
            while j < strings.length(s) && strings.charAt(s, j) != "\"" {
                key = key + strings.charAt(s, j)
                j = j + 1
            }
            // Check if followed by :
            if j + 1 < strings.length(s) && strings.charAt(s, j + 1) == ":" {
                arrays.push(result, key)
            }
            i = j + 1
        } else {
            i = i + 1
        }
    }
    return result
}

// Merge two objects (shallow, second overrides first)
fn json_merge(a: map, b: map) -> map {
    let s1 = json.stringify(a)
    let s2 = json.stringify(b)
    // Simple merge: parse both and combine
    let result = json.parse(s1)
    let keys = json_objectKeys(b)
    let i = 0
    while i < arrays.length(keys) {
        let key = arrays.get(keys, i)
        result[key] = b[key]
        i = i + 1
    }
    return result
}

// Deep clone via JSON round-trip
fn json_clone(obj: any) -> any {
    return json.parse(json.stringify(obj))
}

// Pretty print JSON with indentation
fn json_pretty(value: any, indent: int) -> string {
    let raw = json.stringify(value)
    // Simple pretty printer
    let result = ""
    let level = 0
    let i = 0
    while i < strings.length(raw) {
        let c = strings.charAt(raw, i)
        if c == "{" || c == "[" {
            result = result + c + "\n"
            level = level + 1
            let j = 0
            while j < level * indent {
                result = result + " "
                j = j + 1
            }
        } else if c == "}" || c == "]" {
            level = level - 1
            result = result + "\n"
            let j = 0
            while j < level * indent {
                result = result + " "
                j = j + 1
            }
            result = result + c
        } else if c == "," {
            result = result + c + "\n"
            let j = 0
            while j < level * indent {
                result = result + " "
                j = j + 1
            }
        } else {
            result = result + c
        }
        i = i + 1
    }
    return result
}
