// TLL Commerce Dogfood - Product Vertical Slice (DEBUG STEP 4)
// Test array literals with db_insert

from "./core/database" import db_open, db_exec, db_query, db_insert

let db = db_open("product_debug4.db")

db_exec(db, "CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, price REAL, stock INTEGER)")

// Test array literal first
io.println("Testing array literal...")
let testArr = ["hello", "world"]
io.println("Array length: " + convert.toString(arrays.length(testArr)))
io.println("Array[0]: " + testArr[0])
io.println("Array[1]: " + testArr[1])

// Test db_insert with array literal and ? placeholders
io.println("Testing db_insert with array literal...")
let id1 = db_insert(db, "INSERT INTO products (name, price, stock) VALUES (?, ?, ?)", ["Widget", 9.99, 100])
io.println("Inserted id1: " + convert.toString(id1))
let id2 = db_insert(db, "INSERT INTO products (name, price, stock) VALUES (?, ?, ?)", ["Gadget", 19.99, 50])
io.println("Inserted id2: " + convert.toString(id2))

io.println("Database initialized with array literals")

fn productHandler(req) {
    if req.path == "/products" && req.method == "GET" {
        let rows = db_query(db, "SELECT id, name, price, stock FROM products ORDER BY id")
        let count = arrays.length(rows)
        io.println("Products query: count=" + convert.toString(count))
        let jsonStr = json.stringify(rows)
        return {status: 200, contentType: "application/json", body: jsonStr}
    }

    if req.path == "/health" && req.method == "GET" {
        return {status: 200, contentType: "text/plain", body: "OK"}
    }

    return {status: 404, contentType: "text/plain", body: "Not Found: " + req.path}
}

io.println("=== Product Debug Step 4 Server starting on :8088 ===")
http.serve("0.0.0.0:8088", productHandler)
