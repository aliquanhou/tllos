// TLL Commerce Dogfood - Product Vertical Slice (DEBUG STEP 2)
// Add json.stringify to test JSON serialization

from "./core/database" import db_open, db_exec, db_query

let db = db_open("product_debug2.db")

db_exec(db, "CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY, name TEXT, price REAL, stock INTEGER)")
db_exec(db, "INSERT OR IGNORE INTO products (id, name, price, stock) VALUES (1, 'Widget', 9.99, 100)")
db_exec(db, "INSERT OR IGNORE INTO products (id, name, price, stock) VALUES (2, 'Gadget', 19.99, 50)")

io.println("Database initialized")

fn productHandler(req) {
    if req.path == "/products" && req.method == "GET" {
        let rows = db_query(db, "SELECT id, name, price, stock FROM products ORDER BY id")
        let count = arrays.length(rows)
        io.println("Products query: count=" + convert.toString(count))
        // Test json.stringify
        let jsonStr = json.stringify(rows)
        io.println("JSON string length: " + convert.toString(strings.length(jsonStr)))
        io.println("JSON preview: " + jsonStr)
        return {status: 200, contentType: "application/json", body: jsonStr}
    }

    if req.path == "/health" && req.method == "GET" {
        return {status: 200, contentType: "text/plain", body: "OK"}
    }

    return {status: 404, contentType: "text/plain", body: "Not Found: " + req.path}
}

io.println("=== Product Debug Step 2 Server starting on :8088 ===")
http.serve("0.0.0.0:8088", productHandler)
