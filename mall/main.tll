        "<div style='text-align:center;padding:20px;background:#f9f9f9;border-radius:8px'><h2 style='color:#ff4400'>" + convert.toString(cartCount.cnt) + "</h2><p>购物车</p><a href='/cart' class='btn btn-outline'>去购物车</a></div>" +
        "</div>" +
        "<div class='card'><h3>快捷操作</h3><p><a href='/user/address'>地址管理</a></p><p><a href='/orders'>订单管理</a></p></div>" +
        "</div>"
    return res_html(html_page("用户中心", body))
})

// --- Address Management ---
router_get(mallRouter, "/user/address", fn(req) {
    let sessionId = cookie_getSessionId(req)
    let currentUser = auth_currentUser(sessionId)
    if (currentUser == null) { return res_redirect("/login") }

    let addresses = db_query(req.db, "SELECT * FROM user_addresses WHERE user_id=" + convert.toString(currentUser.id) + " ORDER BY is_default DESC")

    let addrHtml = ""
    if (arrays.length(addresses) == 0) {
        addrHtml = "<div class='empty'>暂无收货地址</div>"
    } else {
        addrHtml = "<table class='table'><thead><tr><th>收货人</th><th>电话</th><th>地址</th><th>默认</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(addresses)) {
            let a = addresses[i]
            let isDefaultText = "否"
            if (a.is_default == 1) { isDefaultText = "是" }
            addrHtml = addrHtml + "<tr><td>" + a.name + "</td><td>" + a.phone + "</td><td>" + a.province + a.city + a.district + a.detail + "</td>" +
                "<td>" + isDefaultText + "</td>" +
                "<td><a href='#' onclick='deleteAddr(" + convert.toString(a.id) + ");return false' style='color:#ff4400'>删除</a></td></tr>"
            i = i + 1
        }
        addrHtml = addrHtml + "</tbody></table>"
    }

    let body = html_header(currentUser) +
        "<div class='container'><div class='breadcrumb'><a href='/user'>用户中心</a> / 地址管理</div>" +
        "<div class='card'><h3>新增地址</h3>" +
        "<div class='form-group'><label>收货人</label><input type='text' id='addrName'></div>" +
        "<div class='form-group'><label>电话</label><input type='text' id='addrPhone'></div>" +
        "<div class='form-group'><label>省份</label><input type='text' id='addrProvince'></div>" +
        "<div class='form-group'><label>城市</label><input type='text' id='addrCity'></div>" +
        "<div class='form-group'><label>区县</label><input type='text' id='addrDistrict'></div>" +
        "<div class='form-group'><label>详细地址</label><input type='text' id='addrDetail'></div>" +
        "<button class='btn' onclick='addAddr()'>添加地址</button></div>" +
        "<div class='card'><h3>地址列表</h3>" + addrHtml + "</div></div>" +
        "<script>function addAddr(){let data={name:document.getElementById('addrName').value,phone:document.getElementById('addrPhone').value,province:document.getElementById('addrProvince').value,city:document.getElementById('addrCity').value,district:document.getElementById('addrDistrict').value,detail:document.getElementById('addrDetail').value};" +
        "fetch('/user/address/add',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).then(r=>r.json()).then(d=>{if(d.success){location.reload();}else{alert(d.error);}});}" +
        "function deleteAddr(id){fetch('/user/address/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})}).then(()=>location.reload());}</script>"

    return res_html(html_page("地址管理", body))
})

// --- Add Address API ---
router_post(mallRouter, "/user/address/add", fn(req) {
    let sessionId = cookie_getSessionId(req)
    let currentUser = auth_currentUser(sessionId)
    if (currentUser == null) { return res_json({error: "请先登录"}, 401) }
    let body = req_getJsonBody(req)
    db_exec(req.db, "INSERT INTO user_addresses (user_id, name, phone, province, city, district, detail) VALUES (" + convert.toString(currentUser.id) + ",'" + body.name + "','" + body.phone + "','" + body.province + "','" + body.city + "','" + body.district + "','" + body.detail + "')")
    return res_json({success: true})
})

// --- Delete Address API ---
router_post(mallRouter, "/user/address/delete", fn(req) {
    let sessionId = cookie_getSessionId(req)
    let currentUser = auth_currentUser(sessionId)
    if (currentUser == null) { return res_json({error: "请先登录"}, 401) }
    let body = req_getJsonBody(req)
    db_exec(req.db, "DELETE FROM user_addresses WHERE id=" + convert.toString(body.id) + " AND user_id=" + convert.toString(currentUser.id))
    return res_json({success: true})
})

