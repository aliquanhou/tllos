// TLL Mall - New Admin Modules (5 missing modules)
// 9. 装修管理, 11. 权限管理, 13. 组织管理, 14. 渠道设置, 15. 开发工具

from "./database" import db_query, db_queryOne, db_exec, db_insert
from "./router" import res_html, res_json, res_notFound, req_getJsonBody, req_getQuery
from "./admin_layout" import admin_layout_page
from "./auth" import auth_currentUser, cookie_getSessionId

// ============================================
// 9. 装修管理 (Decoration)
// ============================================

fn decoration_registerRoutes(router) {
    // 页面装修
    router_get(router, "/admin/decoration/pages", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let pages = db_query(req.db, "SELECT * FROM decoration_pages ORDER BY sort_order, id DESC")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>页面列表</h3><a href='/admin/decoration/page/add' class='btn'>添加页面</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>页面名称</th><th>类型</th><th>状态</th><th>排序</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(pages)) {
            let p = pages[i]
            let statusTag = "<span class='tag tag-success'>启用</span>"
            if (p.status != "active") { statusTag = "<span class='tag tag-danger'>禁用</span>" }
            html = html + "<tr><td>" + convert.toString(p.id) + "</td><td>" + p.name + "</td><td>" + p.page_type + "</td><td>" + statusTag + "</td><td>" + convert.toString(p.sort_order) + "</td><td><a href='/admin/decoration/page/edit/" + convert.toString(p.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("页面装修", "decoration_pages", html, currentUser))
    })

    // 模板管理
    router_get(router, "/admin/decoration/templates", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let templates = db_query(req.db, "SELECT * FROM decoration_templates ORDER BY id DESC")
        let html = "<div class='card'><h3>模板列表</h3><div style='display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px'>"
        let i = 0
        while (i < arrays.length(templates)) {
            let t = templates[i]
            html = html + "<div style='border:1px solid #e8e8e8;border-radius:8px;padding:20px;text-align:center'><div style='height:120px;background:#f5f5f5;border-radius:4px;margin-bottom:10px;display:flex;align-items:center;justify-content:center;color:#999'>模板预览</div><h4>" + t.name + "</h4><p style='color:#999;font-size:12px'>" + t.description + "</p><button class='btn'>应用模板</button></div>"
            i = i + 1
        }
        if (arrays.length(templates) == 0) {
            html = html + "<div class='empty'>暂无模板，系统默认使用基础模板</div>"
        }
        html = html + "</div></div>"
        return res_html(admin_layout_page("模板管理", "decoration_templates", html, currentUser))
    })

    // 轮播图管理
    router_get(router, "/admin/decoration/banners", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let banners = db_query(req.db, "SELECT * FROM banners ORDER BY sort_order, id DESC")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>轮播图列表</h3><a href='/admin/decoration/banner/add' class='btn'>添加轮播图</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>标题</th><th>图片</th><th>链接</th><th>状态</th><th>排序</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(banners)) {
            let b = banners[i]
            let statusTag = "<span class='tag tag-success'>显示</span>"
            if (b.status != "active") { statusTag = "<span class='tag tag-danger'>隐藏</span>" }
            html = html + "<tr><td>" + convert.toString(b.id) + "</td><td>" + b.title + "</td><td><div style='width:60px;height:30px;background:#f0f0f0;border-radius:4px'></div></td><td>" + b.link_url + "</td><td>" + statusTag + "</td><td>" + convert.toString(b.sort_order) + "</td><td><a href='/admin/decoration/banner/edit/" + convert.toString(b.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("轮播图管理", "decoration_banners", html, currentUser))
    })

    // 导航图标管理
    router_get(router, "/admin/decoration/navs", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let navs = db_query(req.db, "SELECT * FROM nav_icons ORDER BY sort_order, id DESC")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>导航图标列表</h3><a href='/admin/decoration/nav/add' class='btn'>添加图标</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>名称</th><th>图标</th><th>链接</th><th>状态</th><th>排序</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(navs)) {
            let n = navs[i]
            let statusTag = "<span class='tag tag-success'>显示</span>"
            if (n.status != "active") { statusTag = "<span class='tag tag-danger'>隐藏</span>" }
            html = html + "<tr><td>" + convert.toString(n.id) + "</td><td>" + n.name + "</td><td><div style='width:40px;height:40px;background:#e6f7ff;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#1890ff'>★</div></td><td>" + n.link_url + "</td><td>" + statusTag + "</td><td>" + convert.toString(n.sort_order) + "</td><td><a href='/admin/decoration/nav/edit/" + convert.toString(n.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("导航图标管理", "decoration_navs", html, currentUser))
    })
}

// ============================================
// 11. 权限管理 (Permissions)
// ============================================

fn permissions_registerRoutes(router) {
    // 角色管理
    router_get(router, "/admin/permissions/roles", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let roles = db_query(req.db, "SELECT * FROM admin_roles ORDER BY id DESC")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>角色列表</h3><a href='/admin/permissions/role/add' class='btn'>添加角色</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>角色名称</th><th>角色标识</th><th>描述</th><th>状态</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(roles)) {
            let r = roles[i]
            let statusTag = "<span class='tag tag-success'>启用</span>"
            if (r.status != "active") { statusTag = "<span class='tag tag-danger'>禁用</span>" }
            html = html + "<tr><td>" + convert.toString(r.id) + "</td><td>" + r.name + "</td><td>" + r.role_key + "</td><td>" + r.description + "</td><td>" + statusTag + "</td><td><a href='/admin/permissions/role/edit/" + convert.toString(r.id) + "' class='btn'>编辑</a> <a href='/admin/permissions/role/permissions/" + convert.toString(r.id) + "' class='btn btn-success'>分配权限</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("角色管理", "perm_roles", html, currentUser))
    })

    // 菜单管理
    router_get(router, "/admin/permissions/menus", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let menus = db_query(req.db, "SELECT * FROM admin_menus ORDER BY parent_id, sort_order, id")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>菜单列表</h3><a href='/admin/permissions/menu/add' class='btn'>添加菜单</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>菜单名称</th><th>父级ID</th><th>路径</th><th>图标</th><th>排序</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(menus)) {
            let m = menus[i]
            html = html + "<tr><td>" + convert.toString(m.id) + "</td><td>" + m.name + "</td><td>" + convert.toString(m.parent_id) + "</td><td>" + m.path + "</td><td>" + m.icon + "</td><td>" + convert.toString(m.sort_order) + "</td><td><a href='/admin/permissions/menu/edit/" + convert.toString(m.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("菜单管理", "perm_menus", html, currentUser))
    })

    // 管理员管理
    router_get(router, "/admin/permissions/admins", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let admins = db_query(req.db, "SELECT a.*, r.name as role_name FROM admin_users a LEFT JOIN admin_roles r ON a.role_id=r.id ORDER BY a.id DESC")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>管理员列表</h3><a href='/admin/permissions/admin/add' class='btn'>添加管理员</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>用户名</th><th>姓名</th><th>角色</th><th>状态</th><th>最后登录</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(admins)) {
            let a = admins[i]
            let statusTag = "<span class='tag tag-success'>正常</span>"
            if (a.status != "active") { statusTag = "<span class='tag tag-danger'>禁用</span>" }
            html = html + "<tr><td>" + convert.toString(a.id) + "</td><td>" + a.username + "</td><td>" + a.real_name + "</td><td>" + a.role_name + "</td><td>" + statusTag + "</td><td>" + a.last_login_at + "</td><td><a href='/admin/permissions/admin/edit/" + convert.toString(a.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("管理员管理", "perm_admins", html, currentUser))
    })

    // 操作日志
    router_get(router, "/admin/permissions/logs", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let logs = db_query(req.db, "SELECT * FROM operation_logs ORDER BY id DESC LIMIT 100")
        let html = "<div class='card'><h3>操作日志（最近100条）</h3>"
        html = html + "<table><thead><tr><th>ID</th><th>管理员</th><th>操作</th><th>模块</th><th>IP</th><th>时间</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(logs)) {
            let l = logs[i]
            html = html + "<tr><td>" + convert.toString(l.id) + "</td><td>" + l.admin_username + "</td><td>" + l.action + "</td><td>" + l.module + "</td><td>" + l.ip_address + "</td><td>" + l.created_at + "</td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("操作日志", "perm_logs", html, currentUser))
    })
}

// ============================================
// 13. 组织管理 (Organization)
// ============================================

fn organization_registerRoutes(router) {
    // 部门管理
    router_get(router, "/admin/org/departments", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let depts = db_query(req.db, "SELECT * FROM departments ORDER BY parent_id, sort_order, id")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>部门列表</h3><a href='/admin/org/department/add' class='btn'>添加部门</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>部门名称</th><th>父级部门</th><th>负责人</th><th>排序</th><th>状态</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(depts)) {
            let d = depts[i]
            let statusTag = "<span class='tag tag-success'>正常</span>"
            if (d.status != "active") { statusTag = "<span class='tag tag-danger'>停用</span>" }
            html = html + "<tr><td>" + convert.toString(d.id) + "</td><td>" + d.name + "</td><td>" + convert.toString(d.parent_id) + "</td><td>" + d.leader + "</td><td>" + convert.toString(d.sort_order) + "</td><td>" + statusTag + "</td><td><a href='/admin/org/department/edit/" + convert.toString(d.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("部门管理", "org_departments", html, currentUser))
    })

    // 岗位管理
    router_get(router, "/admin/org/positions", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let positions = db_query(req.db, "SELECT p.*, d.name as dept_name FROM positions p LEFT JOIN departments d ON p.department_id=d.id ORDER BY p.id DESC")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>岗位列表</h3><a href='/admin/org/position/add' class='btn'>添加岗位</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>岗位名称</th><th>所属部门</th><th>岗位编码</th><th>排序</th><th>状态</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(positions)) {
            let p = positions[i]
            let statusTag = "<span class='tag tag-success'>正常</span>"
            if (p.status != "active") { statusTag = "<span class='tag tag-danger'>停用</span>" }
            html = html + "<tr><td>" + convert.toString(p.id) + "</td><td>" + p.name + "</td><td>" + p.dept_name + "</td><td>" + p.position_code + "</td><td>" + convert.toString(p.sort_order) + "</td><td>" + statusTag + "</td><td><a href='/admin/org/position/edit/" + convert.toString(p.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("岗位管理", "org_positions", html, currentUser))
    })
}

// ============================================
// 14. 渠道设置 (Channels)
// ============================================

fn channels_registerRoutes(router) {
    // 公众号菜单
    router_get(router, "/admin/channel/wechat/menu", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let menus = db_query(req.db, "SELECT * FROM wechat_menus ORDER BY parent_id, sort_order, id")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>公众号菜单</h3><div><a href='/admin/channel/wechat/menu/add' class='btn'>添加菜单</a> <button class='btn btn-success'>发布到微信</button></div></div>"
        html = html + "<table><thead><tr><th>ID</th><th>菜单名称</th><th>父级ID</th><th>类型</th><th>值</th><th>排序</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(menus)) {
            let m = menus[i]
            html = html + "<tr><td>" + convert.toString(m.id) + "</td><td>" + m.name + "</td><td>" + convert.toString(m.parent_id) + "</td><td>" + m.menu_type + "</td><td>" + m.menu_value + "</td><td>" + convert.toString(m.sort_order) + "</td><td><a href='/admin/channel/wechat/menu/edit/" + convert.toString(m.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("公众号菜单", "channel_wechat_menu", html, currentUser))
    })

    // 自动回复
    router_get(router, "/admin/channel/wechat/reply", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let replies = db_query(req.db, "SELECT * FROM wechat_auto_replies ORDER BY id DESC")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>自动回复规则</h3><a href='/admin/channel/wechat/reply/add' class='btn'>添加规则</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>规则名称</th><th>关键词</th><th>匹配模式</th><th>回复类型</th><th>状态</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(replies)) {
            let r = replies[i]
            let statusTag = "<span class='tag tag-success'>启用</span>"
            if (r.status != "active") { statusTag = "<span class='tag tag-danger'>禁用</span>" }
            html = html + "<tr><td>" + convert.toString(r.id) + "</td><td>" + r.name + "</td><td>" + r.keyword + "</td><td>" + r.match_mode + "</td><td>" + r.reply_type + "</td><td>" + statusTag + "</td><td><a href='/admin/channel/wechat/reply/edit/" + convert.toString(r.id) + "' class='btn'>编辑</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("自动回复", "channel_wechat_reply", html, currentUser))
    })

    // 推广渠道
    router_get(router, "/admin/channel/channels", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let channels = db_query(req.db, "SELECT * FROM promotion_channels ORDER BY id DESC")
        let html = "<div class='card'><div style='display:flex;justify-content:space-between;margin-bottom:15px'><h3>推广渠道列表</h3><a href='/admin/channel/add' class='btn'>添加渠道</a></div>"
        html = html + "<table><thead><tr><th>ID</th><th>渠道名称</th><th>渠道编码</th><th>访问量</th><th>注册量</th><th>下单量</th><th>状态</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(channels)) {
            let c = channels[i]
            let statusTag = "<span class='tag tag-success'>正常</span>"
            if (c.status != "active") { statusTag = "<span class='tag tag-danger'>停用</span>" }
            html = html + "<tr><td>" + convert.toString(c.id) + "</td><td>" + c.name + "</td><td>" + c.channel_code + "</td><td>" + convert.toString(c.visit_count) + "</td><td>" + convert.toString(c.register_count) + "</td><td>" + convert.toString(c.order_count) + "</td><td>" + statusTag + "</td><td><a href='/admin/channel/edit/" + convert.toString(c.id) + "' class='btn'>编辑</a> <a href='/admin/channel/stats/" + convert.toString(c.id) + "' class='btn btn-success'>统计</a></td></tr>"
            i = i + 1
        }
        html = html + "</tbody></table></div>"
        return res_html(admin_layout_page("推广渠道", "channel_list", html, currentUser))
    })
}

// ============================================
// 15. 开发工具 (Developer)
// ============================================

fn developer_registerRoutes(router) {
    // 代码生成器
    router_get(router, "/admin/dev/generator", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let tables = db_query(req.db, "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
        let html = "<div class='card'><h3>代码生成器</h3><p style='color:#666;margin-bottom:20px'>选择数据表，自动生成 CRUD 代码（Model/Controller/View）</p>"
        html = html + "<div class='form-group'><label>选择数据表</label><select name='table' multiple style='height:200px'>"
        let i = 0
        while (i < arrays.length(tables)) {
            html = html + "<option value='" + tables[i].name + "'>" + tables[i].name + "</option>"
            i = i + 1
        }
        html = html + "</select></div>"
        html = html + "<div class='form-group'><label>模块名称</label><input type='text' name='module' placeholder='如：product'></div>"
        html = html + "<div class='form-group'><label>业务名称</label><input type='text' name='business' placeholder='如：商品'></div>"
        html = html + "<button class='btn btn-success'>生成代码</button></div>"
        return res_html(admin_layout_page("代码生成器", "dev_generator", html, currentUser))
    })

    // 数据导出
    router_get(router, "/admin/dev/export", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let tables = db_query(req.db, "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
        let html = "<div class='card'><h3>数据导出</h3><p style='color:#666;margin-bottom:20px'>选择数据表，导出为 CSV / Excel / SQL 格式</p>"
        html = html + "<div class='form-group'><label>选择数据表（可多选）</label><select name='tables' multiple style='height:200px'>"
        let i = 0
        while (i < arrays.length(tables)) {
            html = html + "<option value='" + tables[i].name + "'>" + tables[i].name + "</option>"
            i = i + 1
        }
        html = html + "</select></div>"
        html = html + "<div class='form-group'><label>导出格式</label><select name='format'><option value='csv'>CSV</option><option value='excel'>Excel</option><option value='sql'>SQL</option></select></div>"
        html = html + "<button class='btn btn-success'>开始导出</button></div>"
        return res_html(admin_layout_page("数据导出", "dev_export", html, currentUser))
    })

    // 数据导入
    router_get(router, "/admin/dev/import", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let html = "<div class='card'><h3>数据导入</h3><p style='color:#666;margin-bottom:20px'>上传 CSV / Excel 文件，导入数据到指定数据表</p>"
        html = html + "<div class='form-group'><label>目标数据表</label><select name='table'><option value='products'>商品表</option><option value='users'>用户表</option><option value='orders'>订单表</option><option value='categories'>分类表</option></select></div>"
        html = html + "<div class='form-group'><label>上传文件</label><input type='file' name='file' accept='.csv,.xlsx,.xls'></div>"
        html = html + "<div class='form-group'><label>导入模式</label><select name='mode'><option value='append'>追加（保留原有数据）</option><option value='replace'>替换（清空后导入）</option><option value='update'>更新（按主键更新）</option></select></div>"
        html = html + "<button class='btn btn-success'>开始导入</button></div>"
        return res_html(admin_layout_page("数据导入", "dev_import", html, currentUser))
    })

    // API文档
    router_get(router, "/admin/dev/api", fn(req) {
        let sessionId = cookie_getSessionId(req)
        let currentUser = auth_currentUser(sessionId)
        let html = "<div class='card'><h3>API 文档</h3><p style='color:#666;margin-bottom:20px'>TLL OS 商城 API 接口文档（自动生成）</p>"
        html = html + "<div style='background:#f6f8fa;padding:15px;border-radius:4px;margin-bottom:20px'><strong>基础地址：</strong> http://127.0.0.1:8090<br><strong>认证方式：</strong> Session Cookie / Bearer Token<br><strong>数据格式：</strong> JSON</div>"
        html = html + "<h4>接口分类</h4><ul style='line-height:2'>"
        html = html + "<li><strong>用户模块</strong>（12个接口）：注册、登录、登出、用户信息、地址管理等</li>"
        html = html + "<li><strong>商品模块</strong>（15个接口）：商品列表、详情、分类、品牌、搜索等</li>"
        html = html + "<li><strong>订单模块</strong>（10个接口）：创建订单、订单列表、详情、支付、取消等</li>"
        html = html + "<li><strong>购物车</strong>（5个接口）：加购、列表、修改数量、删除、结算</li>"
        html = html + "<li><strong>营销模块</strong>（8个接口）：优惠券、秒杀、拼团、会员折扣</li>"
        html = html + "<li><strong>支付模块</strong>（6个接口）：微信支付、支付宝、余额支付、退款、回调</li>"
        html = html + "<li><strong>后台管理</strong>（50+接口）：商品、订单、用户、商家、分销、财务等</li>"
        html = html + "</ul>"
        html = html + "<div style='margin-top:20px'><a href='/admin/dev/api/download' class='btn'>下载完整 API 文档 (JSON)</a></div></div>"
        return res_html(admin_layout_page("API文档", "dev_api", html, currentUser))
    })
}

// Register all new module routes
fn new_modules_registerAll(router) {
    decoration_registerRoutes(router)
    permissions_registerRoutes(router)
    organization_registerRoutes(router)
    channels_registerRoutes(router)
    developer_registerRoutes(router)
}
