// ============================================
// 4. Orders API
// ============================================
fn api_registerOrderRoutes(router) {
    router_get(router, "/api/admin/orders", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let orders = db_query(req.db, "SELECT * FROM orders ORDER BY id DESC LIMIT 100")
        return api_success(orders, "Order list")
    })

    router_get(router, "/api/admin/orders/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let order = db_queryOne(req.db, "SELECT * FROM orders WHERE id=" + convert.toString(id))
        if (order == null) { return api_error("Order not found", 404) }
        let items = db_query(req.db, "SELECT * FROM order_items WHERE order_id=" + convert.toString(id))
        return api_success({order: order, items: items}, "Order detail")
    })

    // Ship order
    router_post(router, "/api/admin/orders/:id/ship", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let body = req_getJsonBody(req)
        let trackingCompany = ""
        if (body.tracking_company != null) { trackingCompany = api_escape(body.tracking_company) }
        let trackingNumber = ""
        if (body.tracking_number != null) { trackingNumber = api_escape(body.tracking_number) }
        db_exec(req.db, "UPDATE orders SET status='shipped', tracking_company='" + trackingCompany + "', tracking_number='" + trackingNumber + "', shipped_at=datetime('now') WHERE id=" + convert.toString(id))
        return api_success(null, "Order shipped successfully")
    })

    // Cancel order
    router_post(router, "/api/admin/orders/:id/cancel", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let order = db_queryOne(req.db, "SELECT * FROM orders WHERE id=" + convert.toString(id))
        if (order == null) { return api_error("Order not found", 404) }
        // Rollback stock
        let items = db_query(req.db, "SELECT * FROM order_items WHERE order_id=" + convert.toString(id))
        let i = 0
        while (i < arrays.length(items)) {
            let item = items[i]
            if (item.sku_id != null) {
                db_exec(req.db, "UPDATE product_skus SET stock=stock+" + convert.toString(item.quantity) + " WHERE id=" + convert.toString(item.sku_id))
            }
            db_exec(req.db, "UPDATE products SET stock=stock+" + convert.toString(item.quantity) + ", sales=sales-" + convert.toString(item.quantity) + " WHERE id=" + convert.toString(item.product_id))
            i = i + 1
        }
        db_exec(req.db, "UPDATE orders SET status='cancelled' WHERE id=" + convert.toString(id))
        return api_success(null, "Order cancelled, stock rolled back")
    })

    // Complete order
    router_post(router, "/api/admin/orders/:id/complete", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        db_exec(req.db, "UPDATE orders SET status='completed', completed_at=datetime('now') WHERE id=" + convert.toString(id))
        return api_success(null, "Order completed successfully")
    })

    // Update order remark
    router_put(router, "/api/admin/orders/:id/remark", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let body = req_getJsonBody(req)
        let remark = ""
        if (body.remark != null) { remark = api_escape(body.remark) }
        db_exec(req.db, "UPDATE orders SET admin_remark='" + remark + "' WHERE id=" + convert.toString(id))
        return api_success(null, "Order remark updated")
    })
}

// ============================================
// 5. Users API
// ============================================
fn api_registerUserRoutes(router) {
    router_get(router, "/api/admin/users", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let users = db_query(req.db, "SELECT id, username, email, role, status, created_at FROM users ORDER BY id DESC LIMIT 100")
        return api_success(users, "User list")
    })

    router_get(router, "/api/admin/users/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let user = db_queryOne(req.db, "SELECT id, username, email, role, status, phone, created_at FROM users WHERE id=" + convert.toString(id))
        if (user == null) { return api_error("User not found", 404) }
        let orders = db_query(req.db, "SELECT COUNT(*) as cnt FROM orders WHERE user_id=" + convert.toString(id))
        let addresses = db_query(req.db, "SELECT * FROM user_addresses WHERE user_id=" + convert.toString(id))
        return api_success({user: user, orderCount: orders[0].cnt, addresses: addresses}, "User detail")
    })

    // Update user
    router_put(router, "/api/admin/users/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let body = req_getJsonBody(req)
        let sets = []
        if (body.email != null) { sets.push("email='" + api_escape(body.email) + "'") }
        if (body.phone != null) { sets.push("phone='" + api_escape(body.phone) + "'") }
        if (body.role != null) { sets.push("role='" + body.role + "'") }
        if (arrays.length(sets) > 0) {
            db_exec(req.db, "UPDATE users SET " + strings.join(sets, ",") + " WHERE id=" + convert.toString(id))
        }
        return api_success(null, "User updated successfully")
    })

    // Disable user
    router_post(router, "/api/admin/users/:id/disable", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        db_exec(req.db, "UPDATE users SET status='disabled' WHERE id=" + convert.toString(id))
        return api_success(null, "User disabled")
    })

    // Enable user
    router_post(router, "/api/admin/users/:id/enable", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        db_exec(req.db, "UPDATE users SET status='active' WHERE id=" + convert.toString(id))
        return api_success(null, "User enabled")
    })

    // Adjust balance
    router_post(router, "/api/admin/users/:id/balance", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let body = req_getJsonBody(req)
        let amount = 0
        if (body.amount != null) { amount = body.amount }
        let user = db_queryOne(req.db, "SELECT * FROM users WHERE id=" + convert.toString(id))
        if (user == null) { return api_error("User not found", 404) }
        db_exec(req.db, "UPDATE users SET balance=balance+" + convert.toString(amount) + " WHERE id=" + convert.toString(id))
        db_exec(req.db, "INSERT INTO account_logs (user_id, type, amount, balance_after, description) VALUES (" + convert.toString(id) + ",'admin_adjust'," + convert.toString(amount) + "," + convert.toString(user.balance + amount) + ",'Admin balance adjustment')")
        return api_success(null, "Balance adjusted")
    })
}

// ============================================
// 6. Coupons API
// ============================================
fn api_registerCouponRoutes(router) {
    router_get(router, "/api/admin/coupons", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let coupons = db_query(req.db, "SELECT * FROM coupons ORDER BY id DESC")
        return api_success(coupons, "Coupon list")
    })

    router_post(router, "/api/admin/coupons", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let body = req_getJsonBody(req)
        let name = api_escape(body.name)
        let couponType = "fixed"
        if (body.type != null) { couponType = body.type }
        let value = 0
        if (body.value != null) { value = body.value }
        let minAmount = 0
        if (body.min_amount != null) { minAmount = body.min_amount }
        let totalCount = 100
        if (body.total_count != null) { totalCount = body.total_count }
        db_exec(req.db, "INSERT INTO coupons (name, type, value, min_amount, total_count, used_count, status) VALUES ('" + name + "','" + couponType + "'," + convert.toString(value) + "," + convert.toString(minAmount) + "," + convert.toString(totalCount) + ",0,'active')")
        return api_success(null, "Coupon created successfully")
    })

    router_put(router, "/api/admin/coupons/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let body = req_getJsonBody(req)
        let sets = []
        if (body.name != null) { sets.push("name='" + api_escape(body.name) + "'") }
        if (body.value != null) { sets.push("value=" + convert.toString(body.value)) }
        if (body.min_amount != null) { sets.push("min_amount=" + convert.toString(body.min_amount)) }
        if (body.status != null) { sets.push("status='" + body.status + "'") }
        if (arrays.length(sets) > 0) {
            db_exec(req.db, "UPDATE coupons SET " + strings.join(sets, ",") + " WHERE id=" + convert.toString(id))
        }
        return api_success(null, "Coupon updated successfully")
    })

    router_delete(router, "/api/admin/coupons/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        db_exec(req.db, "DELETE FROM coupons WHERE id=" + convert.toString(id))
        return api_success(null, "Coupon deleted successfully")
    })
}

