// TLL Mall - Admin RESTful API (Complete CRUD for all 17 modules)
// Provides full Create/Read/Update/Delete APIs for all backend modules

from "./database" import db_exec, db_query, db_queryOne, db_insert
from "./router" import router_get, router_post, router_put, router_delete, res_json, res_notFound
from "./auth" import auth_currentUser, cookie_getSessionId

// === API Response Helpers ===
fn api_success(data, message) {
    let msg = "success"
    if (message != null) { msg = message }
    return res_json({code: 200, success: true, message: msg, data: data})
}

fn api_error(message, code) {
    let c = 400
    if (code != null) { c = code }
    return res_json({code: c, success: false, message: message, data: null})
}

fn api_checkAdmin(req) {
    let sessionId = cookie_getSessionId(req)
    let user = auth_currentUser(sessionId)
    if (user == null) { return api_error("Please login", 401) }
    if (user.role != "admin") { return api_error("Admin permission required", 403) }
    req.currentUser = user
    return null
}

fn api_escape(s) {
    if (s == null) { return "" }
    return strings.replace(s, "'", "''")
}

// ============================================
// 1. Products API
// ============================================
fn api_registerProductRoutes(router) {
    // List products
    router_get(router, "/api/admin/products", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let products = db_query(req.db, "SELECT * FROM products ORDER BY id DESC LIMIT 100")
        return api_success(products, "Product list")
    })

    // Get product detail
    router_get(router, "/api/admin/products/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let product = db_queryOne(req.db, "SELECT * FROM products WHERE id=" + convert.toString(id))
        if (product == null) { return api_error("Product not found", 404) }
        let skus = db_query(req.db, "SELECT * FROM product_skus WHERE product_id=" + convert.toString(id))
        return api_success({product: product, skus: skus}, "Product detail")
    })

    // Create product
    router_post(router, "/api/admin/products", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let body = req_getJsonBody(req)
        let name = api_escape(body.name)
        let price = 0
        if (body.price != null) { price = body.price }
        let stock = 0
        if (body.stock != null) { stock = body.stock }
        let categoryId = 0
        if (body.category_id != null) { categoryId = body.category_id }
        let brandId = 0
        if (body.brand_id != null) { brandId = body.brand_id }
        let status = "on"
        if (body.status != null) { status = body.status }
        let description = ""
        if (body.description != null) { description = api_escape(body.description) }
        let mainImage = ""
        if (body.main_image != null) { mainImage = api_escape(body.main_image) }
        db_exec(req.db, "INSERT INTO products (name, price, stock, category_id, brand_id, status, description, main_image, sales, sort_order) VALUES ('" + name + "'," + convert.toString(price) + "," + convert.toString(stock) + "," + convert.toString(categoryId) + "," + convert.toString(brandId) + ",'" + status + "','" + description + "','" + mainImage + "',0,0)")
        return api_success(null, "Product created successfully")
    })

    // Update product
    router_put(router, "/api/admin/products/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let body = req_getJsonBody(req)
        let product = db_queryOne(req.db, "SELECT * FROM products WHERE id=" + convert.toString(id))
        if (product == null) { return api_error("Product not found", 404) }
        let sets = []
        if (body.name != null) { sets.push("name='" + api_escape(body.name) + "'") }
        if (body.price != null) { sets.push("price=" + convert.toString(body.price)) }
        if (body.stock != null) { sets.push("stock=" + convert.toString(body.stock)) }
        if (body.category_id != null) { sets.push("category_id=" + convert.toString(body.category_id)) }
        if (body.brand_id != null) { sets.push("brand_id=" + convert.toString(body.brand_id)) }
        if (body.status != null) { sets.push("status='" + body.status + "'") }
        if (body.description != null) { sets.push("description='" + api_escape(body.description) + "'") }
        if (arrays.length(sets) > 0) {
            let setStr = strings.join(sets, ",")
            db_exec(req.db, "UPDATE products SET " + setStr + " WHERE id=" + convert.toString(id))
        }
        return api_success(null, "Product updated successfully")
    })

    // Delete product
    router_delete(router, "/api/admin/products/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        db_exec(req.db, "DELETE FROM products WHERE id=" + convert.toString(id))
        db_exec(req.db, "DELETE FROM product_skus WHERE product_id=" + convert.toString(id))
        return api_success(null, "Product deleted successfully")
    })

    // Toggle product status
    router_post(router, "/api/admin/products/:id/toggle", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let product = db_queryOne(req.db, "SELECT * FROM products WHERE id=" + convert.toString(id))
        if (product == null) { return api_error("Product not found", 404) }
        let newStatus = "off"
        if (product.status == "off") { newStatus = "on" }
        db_exec(req.db, "UPDATE products SET status='" + newStatus + "' WHERE id=" + convert.toString(id))
        return api_success({status: newStatus}, "Product status toggled")
    })
}

// ============================================
// 2. Categories API
// ============================================
fn api_registerCategoryRoutes(router) {
    router_get(router, "/api/admin/categories", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let categories = db_query(req.db, "SELECT * FROM categories ORDER BY parent_id, sort_order, id")
        return api_success(categories, "Category list")
    })

    router_post(router, "/api/admin/categories", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let body = req_getJsonBody(req)
        let name = api_escape(body.name)
        let parentId = 0
        if (body.parent_id != null) { parentId = body.parent_id }
        let sortOrder = 0
        if (body.sort_order != null) { sortOrder = body.sort_order }
        db_exec(req.db, "INSERT INTO categories (name, parent_id, sort_order, status) VALUES ('" + name + "'," + convert.toString(parentId) + "," + convert.toString(sortOrder) + ",'active')")
        return api_success(null, "Category created successfully")
    })

    router_put(router, "/api/admin/categories/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        let body = req_getJsonBody(req)
        let sets = []
        if (body.name != null) { sets.push("name='" + api_escape(body.name) + "'") }
        if (body.parent_id != null) { sets.push("parent_id=" + convert.toString(body.parent_id)) }
        if (body.sort_order != null) { sets.push("sort_order=" + convert.toString(body.sort_order)) }
        if (body.status != null) { sets.push("status='" + body.status + "'") }
        if (arrays.length(sets) > 0) {
            db_exec(req.db, "UPDATE categories SET " + strings.join(sets, ",") + " WHERE id=" + convert.toString(id))
        }
        return api_success(null, "Category updated successfully")
    })

    router_delete(router, "/api/admin/categories/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        db_exec(req.db, "DELETE FROM categories WHERE id=" + convert.toString(id))
        return api_success(null, "Category deleted successfully")
    })
}

