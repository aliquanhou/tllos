// ============================================
// 17. Dashboard Statistics API
// ============================================
fn api_registerDashboardRoutes(router) {
    router_get(router, "/api/admin/dashboard/stats", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let totalProducts = db_queryOne(req.db, "SELECT COUNT(*) as cnt FROM products")
        let totalOrders = db_queryOne(req.db, "SELECT COUNT(*) as cnt FROM orders")
        let totalUsers = db_queryOne(req.db, "SELECT COUNT(*) as cnt FROM users")
        let totalMerchants = db_queryOne(req.db, "SELECT COUNT(*) as cnt FROM merchants")
        let totalSales = db_queryOne(req.db, "SELECT COALESCE(SUM(total_amount),0) as total FROM orders WHERE status IN ('paid','shipped','completed')")
        let pendingOrders = db_queryOne(req.db, "SELECT COUNT(*) as cnt FROM orders WHERE status='pending'")
        let pendingShip = db_queryOne(req.db, "SELECT COUNT(*) as cnt FROM orders WHERE status='paid'")
        let pendingAftersale = db_queryOne(req.db, "SELECT COUNT(*) as cnt FROM after_sales WHERE status='pending'")
        return api_success({
            totalProducts: totalProducts.cnt,
            totalOrders: totalOrders.cnt,
            totalUsers: totalUsers.cnt,
            totalMerchants: totalMerchants.cnt,
            totalSales: totalSales.total,
            pendingOrders: pendingOrders.cnt,
            pendingShip: pendingShip.cnt,
            pendingAftersale: pendingAftersale.cnt
        }, "Dashboard statistics")
    })
}

// ============================================
// Register All Admin API Routes
// ============================================
fn api_registerAll(router) {
    api_registerProductRoutes(router)
    api_registerCategoryRoutes(router)
    api_registerBrandRoutes(router)
    api_registerOrderRoutes(router)
    api_registerUserRoutes(router)
    api_registerCouponRoutes(router)
    api_registerArticleRoutes(router)
    api_registerAnnouncementRoutes(router)
    api_registerSensitiveRoutes(router)
    api_registerMemberLevelRoutes(router)
    api_registerDecorationRoutes(router)
    api_registerPermissionRoutes(router)
    api_registerOrganizationRoutes(router)
    api_registerChannelRoutes(router)
    api_registerSystemConfigRoutes(router)
    api_registerMerchantRoutes(router)
    api_registerDashboardRoutes(router)
}
