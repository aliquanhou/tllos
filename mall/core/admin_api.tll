// ============================================
// 9. Sensitive Words API
// ============================================
fn api_registerSensitiveRoutes(router) {
    router_get(router, "/api/admin/sensitive", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let items = db_query(req.db, "SELECT * FROM sensitive_words ORDER BY id DESC")
        return api_success(items, "Sensitive word list")
    })

    router_post(router, "/api/admin/sensitive", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let body = req_getJsonBody(req)
        let word = api_escape(body.word)
        let replaceWith = "***"
        if (body.replace_with != null) { replaceWith = api_escape(body.replace_with) }
        db_exec(req.db, "INSERT INTO sensitive_words (word, replace_with, status) VALUES ('" + word + "','" + replaceWith + "','active')")
        return api_success(null, "Sensitive word created successfully")
    })

    router_delete(router, "/api/admin/sensitive/:id", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let id = req.params.id
        db_exec(req.db, "DELETE FROM sensitive_words WHERE id=" + convert.toString(id))
        return api_success(null, "Sensitive word deleted successfully")
    })
}

