// ============================================
// 15. System Config API
// ============================================
fn api_registerSystemConfigRoutes(router) {
    router_get(router, "/api/admin/system/config", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let configs = db_query(req.db, "SELECT * FROM system_config ORDER BY id")
        return api_success(configs, "System config list")
    })

    router_put(router, "/api/admin/system/config", fn(req) {
        let auth = api_checkAdmin(req)
        if (auth != null) { return auth }
        let body = req_getJsonBody(req)
        let keys = objects.keys(body)
        let i = 0
        while (i < arrays.length(keys)) {
            let key = keys[i]
            let value = api_escape(body[key])
            let existing = db_queryOne(req.db, "SELECT * FROM system_config WHERE config_key='" + key + "'")
            if (existing == null) {
                db_exec(req.db, "INSERT INTO system_config (config_key, config_value) VALUES ('" + key + "','" + value + "')")
            } else {
                db_exec(req.db, "UPDATE system_config SET config_value='" + value + "' WHERE config_key='" + key + "'")
            }
            i = i + 1
        }
        return api_success(null, "System config updated successfully")
    })
}

