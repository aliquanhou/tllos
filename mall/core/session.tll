// TLL Mall - Session & Cookie & Cache
// Database-backed session store (fixes multi-thread session loss)
// Simple TTL cache layer

from "./database" import db_get, db_release, db_exec, db_query, db_queryOne

// === Session Store (database-backed) ===
// session_data table: (id, session_id, key, value, created_at, updated_at)

let _sessionCounter = 0

// Initialize session tables
fn session_initTables(db) {
    db_exec(db, "CREATE TABLE IF NOT EXISTS session_data (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        session_id TEXT NOT NULL,
        key TEXT NOT NULL,
        value TEXT,
        created_at TEXT DEFAULT (datetime('now')),
        updated_at TEXT DEFAULT (datetime('now'))
    )")
    db_exec(db, "CREATE INDEX IF NOT EXISTS idx_session_id ON session_data(session_id)")
    db_exec(db, "CREATE INDEX IF NOT EXISTS idx_session_key ON session_data(session_id, key)")
    return {success: true}
}

// Generate a random session ID
fn session_generateId() {
    _sessionCounter = _sessionCounter + 1
    let cnt = convert.toString(_sessionCounter)
    let raw = "sess-" + cnt + "-" + strings.length(cnt) + "-tll"
    return raw
}

// Create a new session, returns session ID
fn session_create() {
    let id = session_generateId()
    // Insert a placeholder record to mark session as existing
    let db = db_get()
    db_exec(db, "INSERT INTO session_data (session_id, key, value) VALUES ('" + id + "', '__created__', '1')")
    db_release(db)
    return id
}

// Get session data, returns map or null if session doesn't exist
fn session_get(id) {
    if (id == null) { return null }
    let db = db_get()
    let rows = db_query(db, "SELECT key, value FROM session_data WHERE session_id='" + id + "'")
    db_release(db)
    if (arrays.length(rows) == 0) { return null }
    let data = {}
    let i = 0
    while (i < arrays.length(rows)) {
        data[rows[i].key] = rows[i].value
        i = i + 1
    }
    return data
}

// Set a value in session
fn session_set(id, key, value) {
    if (id == null) { return false }
    let db = db_get()
    // Check if key exists
    let existing = db_queryOne(db, "SELECT id FROM session_data WHERE session_id='" + id + "' AND key='" + key + "'")
    if (existing == null) {
        db_exec(db, "INSERT INTO session_data (session_id, key, value) VALUES ('" + id + "', '" + key + "', '" + convert.toString(value) + "')")
    } else {
        db_exec(db, "UPDATE session_data SET value='" + convert.toString(value) + "', updated_at=datetime('now') WHERE session_id='" + id + "' AND key='" + key + "'")
    }
    db_release(db)
    return true
}

// Get a value from session
fn session_getValue(id, key, defaultValue) {
    if (id == null) { return defaultValue }
    let db = db_get()
    let row = db_queryOne(db, "SELECT value FROM session_data WHERE session_id='" + id + "' AND key='" + key + "'")
    db_release(db)
    if (row == null) { return defaultValue }
    let val = row.value
    if (val == null) { return defaultValue }
    return val
}

// Destroy a session
fn session_destroy(id) {
    if (id == null) { return false }
    let db = db_get()
    db_exec(db, "DELETE FROM session_data WHERE session_id='" + id + "'")
    db_release(db)
    return true
}

// Check if session exists
fn session_exists(id) {
    if (id == null) { return false }
    let db = db_get()
    let row = db_queryOne(db, "SELECT COUNT(*) as cnt FROM session_data WHERE session_id='" + id + "'")
    db_release(db)
    if (row == null) { return false }
    return row.cnt > 0
}

// Get session ID from request cookies, or create new one
fn session_getOrCreate(req) {
    // Try both "Cookie" and "cookie" (HTTP/2 sends lowercase headers)
    let cookieHeader = null
    if (req.headers != null) {
        cookieHeader = req.headers["Cookie"]
        if (cookieHeader == null) { cookieHeader = req.headers["cookie"] }
        if (cookieHeader == null) { cookieHeader = req.headers["COOKIE"] }
    }
    let sessionId = null
    if (cookieHeader != null) {
        let parts = strings.split(cookieHeader, ";")
        let i = 0
        while (i < arrays.length(parts)) {
            let part = strings.trim(parts[i])
            if (strings.startsWith(part, "sessionId=")) {
                sessionId = strings.substring(part, 10, strings.length(part))
                break
            }
            i = i + 1
        }
    }
    if (sessionId != null && session_exists(sessionId)) {
        return {id: sessionId, isNew: false}
    }
    let newId = session_create()
    return {id: newId, isNew: true}
}

// Build Set-Cookie header for session
fn session_cookieHeader(sessionId, maxAge) {
    let age = 86400
    if (maxAge != null) { age = maxAge }
    return "sessionId=" + sessionId + "; Path=/; Max-Age=" + convert.toString(age) + "; HttpOnly"
}

// === Cookie Helpers ===

fn cookie_get(req, name, defaultValue) {
    // Try both "Cookie" and "cookie" (HTTP/2 sends lowercase headers)
    let cookieHeader = null
    if (req.headers != null) {
        cookieHeader = req.headers["Cookie"]
        if (cookieHeader == null) { cookieHeader = req.headers["cookie"] }
        if (cookieHeader == null) { cookieHeader = req.headers["COOKIE"] }
    }
    if (cookieHeader == null) { return defaultValue }
    let parts = strings.split(cookieHeader, ";")
    let i = 0
    while (i < arrays.length(parts)) {
        let part = strings.trim(parts[i])
        if (strings.startsWith(part, name + "=")) {
            return strings.substring(part, strings.length(name) + 1, strings.length(part))
        }
        i = i + 1
    }
    return defaultValue
}

fn cookie_set(name, value, maxAge) {
    let age = 86400
    if (maxAge != null) { age = maxAge }
    return name + "=" + value + "; Path=/; Max-Age=" + convert.toString(age)
}

// === Cache Layer (in-memory with TTL) ===

let _cache = {}
let _cacheHits = 0
let _cacheMisses = 0

fn cache_set(key, value, ttlSeconds) {
    let ttl = 3600
    if (ttlSeconds != null) { ttl = ttlSeconds }
    _cache[key] = {
        value: value,
        expiresAt: _sessionCounter + ttl
    }
}

fn cache_get(key, defaultValue) {
    let entry = _cache[key]
    if (entry == null) {
        _cacheMisses = _cacheMisses + 1
        return defaultValue
    }
    if (entry.expiresAt < _sessionCounter) {
        _cache[key] = null
        _cacheMisses = _cacheMisses + 1
        return defaultValue
    }
    _cacheHits = _cacheHits + 1
    return entry.value
}

fn cache_delete(key) {
    _cache[key] = null
}

fn cache_clear() {
    _cache = {}
}

fn cache_stats() {
    return {
        hits: _cacheHits,
        misses: _cacheMisses
    }
}

// === Password Hashing (bcrypt via TLL builtin) ===

fn hash_password(password) {
    return password.hash(password)
}

fn verify_password(password, hash) {
    // Support legacy "tll$len$reversed" format for migration
    if (strings.startsWith(hash, "tll$")) {
        let parts = strings.split(hash, "$")
        if (arrays.length(parts) == 3) {
            let expectedLen = convert.toInt(parts[1])
            let reversed = parts[2]
            if (strings.length(password) == expectedLen) {
                let check = ""
                let i = 0
                while (i < expectedLen) {
                    check = strings.charAt(password, i) + check
                    i = i + 1
                }
                return check == reversed
            }
        }
        return false
    }
    // bcrypt format
    return password.verify(password, hash)
}

fn needs_password_rehash(hash) {
    return !strings.startsWith(hash, "$2b$")
}
