// === 6. 账户日志 ===
fn admin_merchantLogsPage(req) {
    let sessionId = cookie_getSessionId(req)
    let currentUser = auth_currentUser(sessionId)
    if (currentUser == null) { return res_redirect("/login?redirect=/admin/merchant/logs") }
    let db = req.db
    let logs = db_query(db, "SELECT l.*, m.shop_name FROM merchant_account_logs l LEFT JOIN merchants m ON l.merchant_id=m.id ORDER BY l.created_at DESC LIMIT 50")
    let content = "<div class='admin-card'><h3 style='margin-top:0'>商家账户日志</h3>"
    if (arrays.length(logs) == 0) {
        content = content + _emptyState("📊", "暂无账户日志记录", null, null)
    } else {
        content = content + "<table class='admin-table'><thead><tr><th>ID</th><th>商家</th><th>类型</th><th>金额</th><th>余额</th><th>说明</th><th>时间</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(logs)) {
            let l = logs[i]
            let typeBadge = "<span class='admin-badge admin-badge-info'>收入</span>"
            if (l.type == "withdraw") { typeBadge = "<span class='admin-badge admin-badge-warning'>提现</span>" }
            if (l.type == "settlement") { typeBadge = "<span class='admin-badge admin-badge-success'>结算</span>" }
            content = content + "<tr><td>" + convert.toString(l.id) + "</td><td>" + l.shop_name + "</td><td>" + typeBadge + "</td><td>¥" + convert.toString(l.amount) + "</td><td>¥" + convert.toString(l.balance) + "</td><td>" + l.description + "</td><td>" + l.created_at + "</td></tr>"
            i = i + 1
        }
        content = content + "</tbody></table>"
    }
    content = content + "</div>"
    return _adminPage("账户日志", "merchant_logs", content)
}

// === 7. 充值管理 ===
fn admin_userRechargePage(req) {
    let sessionId = cookie_getSessionId(req)
    let currentUser = auth_currentUser(sessionId)
    if (currentUser == null) { return res_redirect("/login?redirect=/admin/user/recharge") }
    let db = req.db
    let recharges = db_query(db, "SELECT r.*, u.username FROM user_recharges r LEFT JOIN users u ON r.user_id=u.id ORDER BY r.created_at DESC LIMIT 50")
    let content = "<div class='admin-stat-row'><div class='admin-stat-card'><div class='admin-stat-num'>0</div><div class='admin-stat-label'>今日充值</div></div><div class='admin-stat-card'><div class='admin-stat-num'>0</div><div class='admin-stat-label'>本周充值</div></div><div class='admin-stat-card'><div class='admin-stat-num'>0</div><div class='admin-stat-label'>本月充值</div></div><div class='admin-stat-card'><div class='admin-stat-num'>0</div><div class='admin-stat-label'>总充值金额</div></div></div>"
    content = content + "<div class='admin-card'><h3 style='margin-top:0'>充值记录</h3>"
    if (arrays.length(recharges) == 0) {
        content = content + _emptyState("💳", "暂无充值记录", null, null)
    } else {
        content = content + "<table class='admin-table'><thead><tr><th>ID</th><th>用户</th><th>充值金额</th><th>支付方式</th><th>状态</th><th>充值时间</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(recharges)) {
            let r = recharges[i]
            content = content + "<tr><td>" + convert.toString(r.id) + "</td><td>" + r.username + "</td><td style='color:#52c41a;font-weight:bold'>¥" + convert.toString(r.amount) + "</td><td>" + r.payment_method + "</td><td><span class='admin-badge admin-badge-success'>成功</span></td><td>" + r.created_at + "</td></tr>"
            i = i + 1
        }
        content = content + "</tbody></table>"
    }
    content = content + "</div>"
    return _adminPage("充值管理", "user_recharge", content)
}

// === 8. 提现管理 ===
fn admin_userWithdrawPage(req) {
    let sessionId = cookie_getSessionId(req)
    let currentUser = auth_currentUser(sessionId)
    if (currentUser == null) { return res_redirect("/login?redirect=/admin/user/withdraw") }
    let db = req.db
    let withdraws = db_query(db, "SELECT w.*, u.username FROM user_withdraws w LEFT JOIN users u ON w.user_id=u.id ORDER BY w.created_at DESC LIMIT 50")
    let content = "<div class='admin-card'><h3 style='margin-top:0'>用户提现申请</h3>"
    if (arrays.length(withdraws) == 0) {
        content = content + _emptyState("💰", "暂无提现申请", null, null)
    } else {
        content = content + "<table class='admin-table'><thead><tr><th>ID</th><th>用户</th><th>提现金额</th><th>收款方式</th><th>收款账号</th><th>状态</th><th>申请时间</th><th>操作</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(withdraws)) {
            let w = withdraws[i]
            let statusBadge = "<span class='admin-badge admin-badge-warning'>待审核</span>"
            if (w.status == "approved") { statusBadge = "<span class='admin-badge admin-badge-success'>已通过</span>" }
            if (w.status == "rejected") { statusBadge = "<span class='admin-badge admin-badge-danger'>已拒绝</span>" }
            if (w.status == "paid") { statusBadge = "<span class='admin-badge admin-badge-info'>已打款</span>" }
            content = content + "<tr><td>" + convert.toString(w.id) + "</td><td>" + w.username + "</td><td style='color:#ff4d4f;font-weight:bold'>¥" + convert.toString(w.amount) + "</td><td>" + w.payment_method + "</td><td>" + w.account + "</td><td>" + statusBadge + "</td><td>" + w.created_at + "</td><td><a href='/admin/user/withdraw/approve/" + convert.toString(w.id) + "' class='admin-btn admin-btn-success'>通过</a> <a href='/admin/user/withdraw/reject/" + convert.toString(w.id) + "' class='admin-btn admin-btn-danger'>拒绝</a></td></tr>"
            i = i + 1
        }
        content = content + "</tbody></table>"
    }
    content = content + "</div>"
    return _adminPage("提现管理", "user_withdraw", content)
}

