// === 18. 收款记录 ===
fn admin_financePaymentsPage(req) {
    let sessionId = cookie_getSessionId(req)
    let currentUser = auth_currentUser(sessionId)
    if (currentUser == null) { return res_redirect("/login?redirect=/admin/finance/payments") }
    let db = req.db
    let payments = db_query(db, "SELECT p.*, o.order_no, u.username FROM payments p LEFT JOIN orders o ON p.order_id=o.id LEFT JOIN users u ON p.user_id=u.id ORDER BY p.created_at DESC LIMIT 50")
    let content = "<div class='admin-stat-row'><div class='admin-stat-card'><div class='admin-stat-num'>0</div><div class='admin-stat-label'>今日收款</div></div><div class='admin-stat-card'><div class='admin-stat-num'>0</div><div class='admin-stat-label'>本周收款</div></div><div class='admin-stat-card'><div class='admin-stat-num'>0</div><div class='admin-stat-label'>本月收款</div></div><div class='admin-stat-card'><div class='admin-stat-num'>0</div><div class='admin-stat-label'>总收款金额</div></div></div>"
    content = content + "<div class='admin-card'><h3 style='margin-top:0'>收款记录</h3>"
    if (arrays.length(payments) == 0) {
        content = content + _emptyState("💰", "暂无收款记录", null, null)
    } else {
        content = content + "<table class='admin-table'><thead><tr><th>支付单号</th><th>订单号</th><th>用户</th><th>支付金额</th><th>支付方式</th><th>支付状态</th><th>支付时间</th></tr></thead><tbody>"
        let i = 0
        while (i < arrays.length(payments)) {
            let p = payments[i]
            content = content + "<tr><td>" + convert.toString(p.id) + "</td><td>" + p.order_no + "</td><td>" + p.username + "</td><td style='color:#52c41a;font-weight:bold'>¥" + convert.toString(p.amount) + "</td><td>" + p.payment_method + "</td><td><span class='admin-badge admin-badge-success'>成功</span></td><td>" + p.created_at + "</td></tr>"
            i = i + 1
        }
        content = content + "</tbody></table>"
    }
    content = content + "</div>"
    return _adminPage("收款记录", "finance_payments", content)
}

