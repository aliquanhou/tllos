        "<tr><td>1</td><td>用户注册协议</td><td>用户协议</td><td>v1.0</td><td><span class='admin-badge admin-badge-info'>是</span></td><td><span class='admin-badge admin-badge-success'>启用</span></td><td>2026-09-01</td><td><a href='#' class='admin-btn'>编辑</a> <a href='#' class='admin-btn'>预览</a></td></tr>" +
        "<tr><td>2</td><td>隐私政策</td><td>隐私政策</td><td>v1.0</td><td><span class='admin-badge admin-badge-info'>是</span></td><td><span class='admin-badge admin-badge-success'>启用</span></td><td>2026-09-01</td><td><a href='#' class='admin-btn'>编辑</a> <a href='#' class='admin-btn'>预览</a></td></tr>" +
        "<tr><td>3</td><td>商家入驻协议</td><td>商家协议</td><td>v1.0</td><td><span class='admin-badge admin-badge-info'>是</span></td><td><span class='admin-badge admin-badge-success'>启用</span></td><td>2026-09-01</td><td><a href='#' class='admin-btn'>编辑</a> <a href='#' class='admin-btn'>预览</a></td></tr>" +
        "</tbody></table></div>" +
        "<div class='admin-card'><h3 style='margin-top:0'>添加/编辑协议</h3>" +
        "<div class='admin-form-group'><label class='admin-form-label'>协议名称</label><input class='admin-form-input' placeholder='请输入协议名称'></div>" +
        "<div class='admin-form-group'><label class='admin-form-label'>协议类型</label><select class='admin-form-input'><option>用户协议</option><option>隐私政策</option><option>商家协议</option><option>其他</option></select></div>" +
        "<div class='admin-form-group'><label class='admin-form-label'>版本号</label><input class='admin-form-input' placeholder='如 v1.0'></div>" +
        "<div class='admin-form-group'><label class='admin-form-label'>协议内容</label><textarea class='admin-form-textarea' placeholder='请输入协议内容（支持HTML）'></textarea></div>" +
        "<button class='admin-btn' onclick='alert(\"协议已保存\")'>保存协议</button>" +
        "</div>"
    return _adminPage("协议管理", "system_agreement", content)
}

// === Register all missing routes ===
fn admin_missing_registerAll(router) {
    // 订单管理
    router_get(router, "/admin/refunds", fn(req) { return admin_refundsPage(req) })
    router_get(router, "/admin/logistics", fn(req) { return admin_logisticsPage(req) })

    // 商家管理
    router_get(router, "/admin/merchant/apply", fn(req) { return admin_merchantApplyPage(req) })
    router_get(router, "/admin/merchant/levels", fn(req) { return admin_merchantLevelsPage(req) })
    router_get(router, "/admin/merchant/categories", fn(req) { return admin_merchantCategoriesPage(req) })
    router_get(router, "/admin/merchant/logs", fn(req) { return admin_merchantLogsPage(req) })

    // 用户管理
    router_get(router, "/admin/user/recharge", fn(req) { return admin_userRechargePage(req) })
    router_get(router, "/admin/user/withdraw", fn(req) { return admin_userWithdrawPage(req) })

    // 分销管理
    router_get(router, "/admin/distribution/products", fn(req) { return admin_distributionProductsPage(req) })
    router_get(router, "/admin/distribution/orders", fn(req) { return admin_distributionOrdersPage(req) })
    router_get(router, "/admin/distribution/levels", fn(req) { return admin_distributionLevelsPage(req) })
    router_get(router, "/admin/distribution/apply", fn(req) { return admin_distributionApplyPage(req) })
    router_get(router, "/admin/distribution/settings", fn(req) { return admin_distributionSettingsPage(req) })

    // 营销管理
    router_get(router, "/admin/marketing/discount", fn(req) { return admin_marketingDiscountPage(req) })
    router_get(router, "/admin/marketing/seckill", fn(req) { return admin_marketingSeckillPage(req) })
    router_get(router, "/admin/marketing/group", fn(req) { return admin_marketingGroupPage(req) })

    // 应用管理
    router_get(router, "/admin/messages", fn(req) { return admin_messagesPage(req) })

    // 财务管理
    router_get(router, "/admin/finance/payments", fn(req) { return admin_financePaymentsPage(req) })
    router_get(router, "/admin/finance/refunds", fn(req) { return admin_financeRefundsPage(req) })
    router_get(router, "/admin/finance/withdraw", fn(req) { return admin_financeWithdrawPage(req) })
    router_get(router, "/admin/finance/settlement", fn(req) { return admin_financeSettlementPage(req) })

    // 系统设置
    router_get(router, "/admin/system/payment", fn(req) { return admin_systemPaymentPage(req) })
    router_get(router, "/admin/system/logistics", fn(req) { return admin_systemLogisticsPage(req) })
    router_get(router, "/admin/system/shipping", fn(req) { return admin_systemShippingPage(req) })
    router_get(router, "/admin/system/agreement", fn(req) { return admin_systemAgreementPage(req) })

    io.println("[AdminMissing] 25 missing admin pages registered")
    return {success: true}
}
