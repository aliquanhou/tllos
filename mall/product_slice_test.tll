// TLL Commerce Dogfood - Product Vertical Slice
// Reuses mall/core/database.tll, does NOT create a third mall
// Goal: GET /products -> SQLite -> JSON -> HTTP Response

from "./core/database" import db_open, db_exec, db_query, db_get, db_release, db_insert, GLOBAL_DB_PATH

// === Product Schema & Seed ===

fn ensureProductsTable(db) {
    db_exec(db, "CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, price REAL NOT NULL DEFAULT 0, stock INTEGER NOT NULL DEFAULT 0, description TEXT)")
}

fn seedProducts(db) {
    let count = db_query(db, "SELECT COUNT(*) as cnt FROM products")
    if arrays.length(count) > 0 {
        let cnt = count[0].cnt
        if cnt == 0 {
            db_insert(db, "INSERT INTO products (name, price, stock, description) VALUES (?, ?, ?, ?)", ["Widget Pro", 99.99, 100, "High-quality widget"])
            db_insert(db, "INSERT INTO products (name, price, stock, description) VALUES (?, ?, ?, ?)", ["Gadget Plus", 149.50, 50, "Advanced gadget"])
            db_insert(db, "INSERT INTO products (name, price, stock, description) VALUES (?, ?, ?, ?)", ["Thingamajig", 29.99, 200, "Essential thingamajig"])
            io.println("Seeded 3 products")
        }
    }
}

// === HTTP Handler ===

fn productHandler(req) {
    // Get fresh DB connection per request (worker pool closure workaround)
    let db = db_get()

    if req.path == "/products" && req.method == "GET" {
        let rows = db_query(db, "SELECT id, name, price, stock, description FROM products ORDER BY id")
        db_release(db)
        return {status: 200, contentType: "application/json", body: json.stringify(rows)}
    }

    if req.path == "/products/seed" && req.method == "POST" {
        ensureProductsTable(db)
        seedProducts(db)
        db_release(db)
        return {status: 200, contentType: "application/json", body: json.stringify({ok: true, message: "Products seeded"})}
    }

    if req.path == "/health" && req.method == "GET" {
        db_release(db)
        return {status: 200, contentType: "application/json", body: json.stringify({status: "ok", service: "product-slice"})}
    }

    db_release(db)
    return {status: 404, contentType: "application/json", body: json.stringify({error: "Not Found", path: req.path})}
}

// === Main (top-level execution, matching test_http_db.tll pattern) ===

io.println("Product Slice: initializing...")
io.println("Using database: " + GLOBAL_DB_PATH)
let db = db_open(GLOBAL_DB_PATH)
io.println("Database opened")
ensureProductsTable(db)
io.println("Table ensured")
seedProducts(db)
io.println("Seed complete")

// Verify seed
let rows = db_query(db, "SELECT COUNT(*) as cnt FROM products")
if arrays.length(rows) > 0 {
    io.println("Product count: " + convert.toString(rows[0].cnt))
}
db_release(db)
io.println("Database released")

io.println("=== Product Vertical Slice starting on :8088 ===")
io.println("GET /products    - List all products")
io.println("GET /health      - Health check")
io.println("POST /products/seed - Re-seed products")
io.println("Server ready")
http.serve("0.0.0.0:8088", productHandler)
