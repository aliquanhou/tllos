// TLLOS Mall - User Services Module (13 full-featured services)
// All implemented in TLL high-frame-rate language

from "../core/database" import db_query, db_queryOne, db_exec, db_get, db_release
from "../core/router" import router_get, router_post, res_html, res_json, res_redirect, req_getQuery, req_getJsonBody
from "../core/session" import cookie_getSessionId
from "../core/auth" import auth_currentUser

// === Ensure all tables exist ===
fn us_ensureTables(db) {
    // User messages
    db_exec(db, "CREATE TABLE IF NOT EXISTS user_messages (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER NOT NULL,
        title TEXT NOT NULL,
        content TEXT,
        type TEXT DEFAULT 'system',
        is_read INTEGER DEFAULT 0,
        created_at TEXT DEFAULT (datetime('now'))
    )")
    // Browsing history
    db_exec(db, "CREATE TABLE IF NOT EXISTS browsing_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER NOT NULL,
        product_id INTEGER NOT NULL,
        product_name TEXT,
        product_price REAL,
        product_image TEXT,
        created_at TEXT DEFAULT (datetime('now'))
    )")
    // Invitations
    db_exec(db, "CREATE TABLE IF NOT EXISTS invitations (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        inviter_id INTEGER NOT NULL,
        invitee_id INTEGER,
        invite_code TEXT,
        status TEXT DEFAULT 'pending',
        reward_points INTEGER DEFAULT 0,
        created_at TEXT DEFAULT (datetime('now'))
    )")
    // Complaints
    db_exec(db, "CREATE TABLE IF NOT EXISTS complaints (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER NOT NULL,
        type TEXT DEFAULT 'suggestion',
        title TEXT NOT NULL,
        content TEXT,
        contact TEXT,
        status TEXT DEFAULT 'pending',
        reply TEXT,
        created_at TEXT DEFAULT (datetime('now'))
    )")
    // Help articles
    db_exec(db, "CREATE TABLE IF NOT EXISTS help_articles (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        category TEXT DEFAULT 'common',
        title TEXT NOT NULL,
        content TEXT,
        sort_order INTEGER DEFAULT 0,
        status TEXT DEFAULT 'published',
        created_at TEXT DEFAULT (datetime('now'))
    )")
    // Seed help articles if empty
    let count = db_queryOne(db, "SELECT COUNT(*) as cnt FROM help_articles")
    if (count.cnt == 0) {
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('common', '如何注册账号？', '点击首页右上角注册按钮，填写用户名、邮箱和密码即可完成注册。', 1)")
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('common', '如何下单购买？', '浏览商品选择规格后加入购物车，进入购物车结算，选择收货地址和支付方式后提交订单。', 2)")
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('common', '如何申请退款？', '在订单详情页点击申请退款，填写退款原因后提交，客服审核通过后退款将原路返回。', 3)")
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('order', '订单状态有哪些？', '待付款、待发货、待收货、已完成、已取消、退款中。', 1)")
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('order', '如何查看物流？', '在订单详情页点击查看物流，可实时追踪包裹位置。', 2)")
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('payment', '支持哪些支付方式？', '目前支持微信支付、支付宝和余额支付三种方式。', 1)")
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('payment', '优惠券如何使用？', '在结算页面选择可用优惠券，系统自动计算优惠金额。', 2)")
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('account', '如何修改密码？', '进入用户中心-账户安全，点击修改密码，输入原密码和新密码即可。', 1)")
        db_exec(db, "INSERT INTO help_articles (category, title, content, sort_order) VALUES ('account', '如何实名认证？', '进入用户中心-实名认证，填写真实姓名和身份证号，提交后等待审核。', 2)")
    }
    // Seed system messages if empty
    let msgCount = db_queryOne(db, "SELECT COUNT(*) as cnt FROM user_messages WHERE user_id=1")
    if (msgCount.cnt == 0) {
        db_exec(db, "INSERT INTO user_messages (user_id, title, content, type) VALUES (1, '欢迎来到TLL Mall', '感谢您注册TLL Mall，祝您购物愉快！', 'system')")
        db_exec(db, "INSERT INTO user_messages (user_id, title, content, type) VALUES (1, '新用户专享优惠', '新用户注册即送100积分，可在结算时抵扣现金。', 'promotion')")
    }
    return {success: true}
}

// === Common CSS (shared with user_center) ===
fn us_css() {
    return "<style>" +
    "*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}" +
    "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f5f5f5;color:#333;font-size:14px;line-height:1.5}" +
    ".us-topbar{display:flex;align-items:center;padding:12px 16px;background:#fff;border-bottom:1px solid #eee;position:sticky;top:0;z-index:10}" +
    ".us-back{font-size:20px;cursor:pointer;color:#333;width:30px}" +
    ".us-title{flex:1;text-align:center;font-size:16px;font-weight:600}" +
    ".us-right{width:30px;text-align:right}" +
    ".us-card{background:#fff;margin:12px;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.04)}" +
    ".us-list-item{display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid #f5f5f5;cursor:pointer}" +
    ".us-list-item:last-child{border-bottom:none}" +
    ".us-list-icon{font-size:22px;margin-right:12px;width:30px;text-align:center}" +
    ".us-list-content{flex:1;min-width:0}" +
    ".us-list-title{font-size:14px;color:#333;margin-bottom:2px}" +
    ".us-list-desc{font-size:12px;color:#999;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}" +
    ".us-list-arrow{color:#ccc;font-size:16px}" +
    ".us-list-amount{font-size:16px;font-weight:bold;color:#ff4400}" +
    ".us-empty{text-align:center;padding:60px 20px;color:#999}" +
    ".us-empty-icon{font-size:48px;margin-bottom:12px;opacity:0.3}" +
    ".us-empty-text{font-size:14px;margin-bottom:16px}" +
    ".us-btn{display:inline-block;padding:10px 24px;background:#ff6a00;color:#fff;border:none;border-radius:20px;font-size:14px;cursor:pointer;text-decoration:none}" +
    ".us-btn-outline{background:#fff;color:#ff6a00;border:1px solid #ff6a00}" +
    ".us-tabs{display:flex;background:#fff;border-bottom:1px solid #eee}" +
    ".us-tab{flex:1;text-align:center;padding:12px 0;font-size:14px;color:#666;cursor:pointer;position:relative}" +
    ".us-tab.active{color:#ff6a00;font-weight:600}" +
    ".us-tab.active::after{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:30px;height:2px;background:#ff6a00;border-radius:1px}" +
    ".us-form{padding:16px}" +
    ".us-form-group{margin-bottom:16px}" +
    ".us-form-label{display:block;font-size:14px;color:#333;margin-bottom:6px;font-weight:500}" +
    ".us-form-input{width:100%;padding:12px;border:1px solid #ddd;border-radius:8px;font-size:14px;outline:none}" +
    ".us-form-input:focus{border-color:#ff6a00}" +
    ".us-form-textarea{width:100%;padding:12px;border:1px solid #ddd;border-radius:8px;font-size:14px;outline:none;min-height:100px;resize:vertical}" +
    ".us-form-select{width:100%;padding:12px;border:1px solid #ddd;border-radius:8px;font-size:14px;outline:none;background:#fff}" +
    ".us-badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px}" +
    ".us-badge-success{background:#e8f5e9;color:#2e7d32}" +
    ".us-badge-warning{background:#fff3e0;color:#e65100}" +
    ".us-badge-danger{background:#ffebee;color:#c62828}" +
    ".us-badge-info{background:#e3f2fd;color:#1565c0}" +
    ".us-stat-row{display:flex;padding:16px;background:linear-gradient(135deg,#ff6a00,#ee0979);color:#fff}" +
    ".us-stat-item{flex:1;text-align:center}" +
    ".us-stat-num{font-size:22px;font-weight:bold}" +
    ".us-stat-label{font-size:12px;opacity:0.8;margin-top:2px}" +
    ".us-product-card{display:flex;padding:12px;border-bottom:1px solid #f5f5f5;cursor:pointer}" +
    ".us-product-img{width:70px;height:70px;border-radius:8px;background:#f0f0f0;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:24px}" +
    ".us-product-info{flex:1;margin-left:12px;min-width:0}" +
    ".us-product-name{font-size:14px;color:#333;margin-bottom:6px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}" +
    ".us-product-price{font-size:16px;color:#ff4400;font-weight:bold}" +
    ".us-product-time{font-size:11px;color:#999;margin-top:4px}" +
    ".us-content{padding-bottom:20px;min-height:100vh}" +
    ".us-article{padding:16px}" +
    ".us-article h3{font-size:16px;margin-bottom:12px;color:#333}" +
    ".us-article p{font-size:14px;color:#666;line-height:1.8;margin-bottom:12px}" +
    "</style>"
}

// === Common page wrapper ===
fn us_page(title, body, currentUser) {
    return "<!DOCTYPE html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no'><title>" + title + " - TLL Mall</title>" + us_css() + "</head><body>" +
        "<div class='us-content'>" +
        "<div class='us-topbar'><span class='us-back' onclick=\"location.href='/user'\">‹</span><span class='us-title'>" + title + "</span><span class='us-right'></span></div>" +
        body +
        "</div></body></html>"
}

// === Require login helper ===
fn us_requireLogin(req) {
    let sessionId = cookie_getSessionId(req)
    let currentUser = auth_currentUser(sessionId)
    return currentUser
}

// === Helper: tab active class ===
fn us_tabClass(tab, current) {
    if (tab == current) { return "active" }
    return ""
}

// === Helper: if else string ===
fn us_ifStr(cond, trueVal, falseVal) {
    if (cond) { return trueVal }
    return falseVal
}
