// TLLOS Mall - User Services Main Module (13 full features)
// All implemented in TLL high-frame-rate language

from "../core/database" import db_query, db_queryOne, db_exec
from "../core/router" import router_get, router_post, res_html, res_json, res_redirect, req_getQuery, req_getJsonBody
from "../core/session" import cookie_getSessionId, hash_password, verify_password
from "../core/auth" import auth_currentUser
from "./user_services_base" import us_ensureTables, us_page, us_requireLogin, us_tabClass, us_ifStr

// === 1. Coupons ===
fn us_couponsPage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let tab = req_getQuery(req, "tab", "unused")
    let statusCond = "status='unused'"
    if (tab == "used") { statusCond = "status='used'" }
    if (tab == "expired") { statusCond = "status='expired'" }
    let coupons = db_query(db, "SELECT uc.*, c.name, c.discount_type, c.discount_value, c.min_amount, c.valid_from, c.valid_to FROM user_coupons uc LEFT JOIN coupons c ON uc.coupon_id=c.id WHERE uc.user_id=" + convert.toString(currentUser.id) + " AND " + statusCond + " ORDER BY uc.created_at DESC LIMIT 50")
    let html = "<div class='us-tabs'>" +
        "<div class='us-tab " + us_tabClass(tab, "unused") + "' onclick=\"location.href='/user/coupons?tab=unused'\">未使用</div>" +
        "<div class='us-tab " + us_tabClass(tab, "used") + "' onclick=\"location.href='/user/coupons?tab=used'\">已使用</div>" +
        "<div class='us-tab " + us_tabClass(tab, "expired") + "' onclick=\"location.href='/user/coupons?tab=expired'\">已过期</div>" +
        "</div>"
    if (arrays.length(coupons) == 0) {
        html = html + "<div class='us-empty'><div class='us-empty-icon'>🎫</div><div class='us-empty-text'>暂无优惠券</div><a href='/' class='us-btn'>去领券</a></div>"
    } else {
        let i = 0
        while (i < arrays.length(coupons)) {
            let c = coupons[i]
            let discountText = ""
            if (c.discount_type == "fixed") { discountText = "¥" + convert.toString(c.discount_value) }
            if (c.discount_type == "percent") { discountText = convert.toString(c.discount_value) + "折" }
            html = html + "<div class='us-card' style='display:flex;margin:12px'><div style='width:100px;background:linear-gradient(135deg,#ff6a00,#ee0979);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px'><div style='font-size:24px;font-weight:bold'>" + discountText + "</div><div style='font-size:11px;opacity:0.8'>满" + convert.toString(c.min_amount) + "可用</div></div><div style='flex:1;padding:12px'><div style='font-size:14px;font-weight:600;margin-bottom:4px'>" + c.name + "</div><div style='font-size:12px;color:#999;margin-bottom:8px'>有效期至 " + c.valid_to + "</div>"
            if (tab == "unused") { html = html + "<button class='us-btn' style='padding:6px 16px;font-size:12px' onclick=\"location.href='/'\">立即使用</button>" }
            if (tab == "used") { html = html + "<span class='us-badge us-badge-success'>已使用</span>" }
            if (tab == "expired") { html = html + "<span class='us-badge us-badge-danger'>已过期</span>" }
            html = html + "</div></div>"
            i = i + 1
        }
    }
    return res_html(us_page("我的优惠券", html, currentUser))
}

// === 2. My Collections ===
fn us_collectionsPage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let collections = db_query(db, "SELECT uc.*, p.name, p.price, p.main_image, p.status FROM user_collections uc LEFT JOIN products p ON uc.product_id=p.id WHERE uc.user_id=" + convert.toString(currentUser.id) + " ORDER BY uc.created_at DESC LIMIT 50")
    let html = ""
    if (arrays.length(collections) == 0) {
        html = "<div class='us-empty'><div class='us-empty-icon'>❤️</div><div class='us-empty-text'>暂无收藏商品</div><a href='/' class='us-btn'>去逛逛</a></div>"
    } else {
        html = "<div class='us-card' style='margin:12px;padding:0'>"
        let i = 0
        while (i < arrays.length(collections)) {
            let c = collections[i]
            let imgText = "📦"
            if (c.main_image != null && c.main_image != "") { imgText = "<img src='" + c.main_image + "' style='width:100%;height:100%;object-fit:cover;border-radius:8px'>" }
            html = html + "<div class='us-product-card' onclick=\"location.href='/product/" + convert.toString(c.product_id) + "'\">" +
                "<div class='us-product-img'>" + imgText + "</div>" +
                "<div class='us-product-info'>" +
                "<div class='us-product-name'>" + c.name + "</div>" +
                "<div class='us-product-price'>¥" + convert.toString(c.price) + "</div>" +
                "<div class='us-product-time'>收藏于 " + c.created_at + "</div>" +
                "</div></div>"
            i = i + 1
        }
        html = html + "</div>"
    }
    return res_html(us_page("我的收藏", html, currentUser))
}

// === 3. Points History ===
fn us_pointsPage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let userInfo = db_queryOne(db, "SELECT points FROM users WHERE id=" + convert.toString(currentUser.id))
    let totalPoints = 0
    if (userInfo != null && userInfo.points != null) { totalPoints = userInfo.points }
    let logs = db_query(db, "SELECT * FROM point_logs WHERE user_id=" + convert.toString(currentUser.id) + " ORDER BY created_at DESC LIMIT 50")
    let html = "<div class='us-stat-row'><div class='us-stat-item'><div class='us-stat-num'>" + convert.toString(totalPoints) + "</div><div class='us-stat-label'>当前积分</div></div><div class='us-stat-item'><div class='us-stat-num'>100</div><div class='us-stat-label'>可抵现金(元)</div></div><div class='us-stat-item'><div class='us-stat-num'>1</div><div class='us-stat-label'>积分=1分</div></div></div>"
    if (arrays.length(logs) == 0) {
        html = html + "<div class='us-empty'><div class='us-empty-icon'>✨</div><div class='us-empty-text'>暂无积分记录</div></div>"
    } else {
        html = html + "<div class='us-card' style='margin:12px;padding:0'>"
        let i = 0
        while (i < arrays.length(logs)) {
            let l = logs[i]
            let pointsText = "+" + convert.toString(l.points)
            let pointsColor = "#4caf50"
            if (l.type == "spend") { pointsText = "-" + convert.toString(l.points); pointsColor = "#ff4400" }
            html = html + "<div class='us-list-item'><div class='us-list-icon'>" + us_ifStr(l.type == "earn", "📈", "📉") + "</div><div class='us-list-content'><div class='us-list-title'>" + l.description + "</div><div class='us-list-desc'>" + l.created_at + "</div></div><div class='us-list-amount' style='color:" + pointsColor + "'>" + pointsText + "</div></div>"
            i = i + 1
        }
        html = html + "</div>"
    }
    return res_html(us_page("积分明细", html, currentUser))
}

// === 4. Balance History ===
fn us_balancePage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let userInfo = db_queryOne(db, "SELECT balance FROM users WHERE id=" + convert.toString(currentUser.id))
    let totalBalance = 0.0
    if (userInfo != null && userInfo.balance != null) { totalBalance = userInfo.balance }
    let logs = db_query(db, "SELECT * FROM account_logs WHERE user_id=" + convert.toString(currentUser.id) + " ORDER BY created_at DESC LIMIT 50")
    let html = "<div class='us-stat-row'><div class='us-stat-item'><div class='us-stat-num'>¥" + convert.toString(totalBalance) + "</div><div class='us-stat-label'>账户余额</div></div><div class='us-stat-item'><div class='us-stat-num'>💳</div><div class='us-stat-label'>充值</div></div><div class='us-stat-item'><div class='us-stat-num'>🎁</div><div class='us-stat-label'>提现</div></div></div>"
    if (arrays.length(logs) == 0) {
        html = html + "<div class='us-empty'><div class='us-empty-icon'>💳</div><div class='us-empty-text'>暂无余额变动记录</div></div>"
    } else {
        html = html + "<div class='us-card' style='margin:12px;padding:0'>"
        let i = 0
        while (i < arrays.length(logs)) {
            let l = logs[i]
            let amountText = "+¥" + convert.toString(l.amount)
            let amountColor = "#4caf50"
            if (l.type == "expense") { amountText = "-¥" + convert.toString(l.amount); amountColor = "#ff4400" }
            html = html + "<div class='us-list-item'><div class='us-list-icon'>" + us_ifStr(l.type == "income", "💰", "💸") + "</div><div class='us-list-content'><div class='us-list-title'>" + l.description + "</div><div class='us-list-desc'>" + l.created_at + " 余额: ¥" + convert.toString(l.balance_after) + "</div></div><div class='us-list-amount' style='color:" + amountColor + "'>" + amountText + "</div></div>"
            i = i + 1
        }
        html = html + "</div>"
    }
    return res_html(us_page("余额明细", html, currentUser))
}

// === 5. Real Name Verification ===
fn us_verifyPage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let userInfo = db_queryOne(db, "SELECT real_name, id_card, verified FROM users WHERE id=" + convert.toString(currentUser.id))
    let verified = 0
    let realName = ""
    let idCard = ""
    if (userInfo != null) {
        if (userInfo.verified != null) { verified = userInfo.verified }
        if (userInfo.real_name != null) { realName = userInfo.real_name }
        if (userInfo.id_card != null) { idCard = userInfo.id_card }
    }
    let html = ""
    if (verified == 1) {
        html = "<div class='us-card' style='text-align:center;padding:40px 20px'><div style='font-size:60px;margin-bottom:16px'>✅</div><div style='font-size:18px;font-weight:600;margin-bottom:8px'>已实名认证</div><div style='font-size:14px;color:#666;margin-bottom:4px'>姓名: " + realName + "</div><div style='font-size:14px;color:#666'>身份证: " + strings.substring(idCard, 0, 4) + "**********" + strings.substring(idCard, strings.length(idCard) - 4, strings.length(idCard)) + "</div></div>"
    } else if (verified == 2) {
        html = "<div class='us-card' style='text-align:center;padding:40px 20px'><div style='font-size:60px;margin-bottom:16px'>⏳</div><div style='font-size:18px;font-weight:600;margin-bottom:8px'>审核中</div><div style='font-size:14px;color:#666'>您的实名认证申请正在审核中，预计1-3个工作日完成</div></div>"
    } else {
        html = "<div class='us-card'><div class='us-form'>" +
            "<div class='us-form-group'><label class='us-form-label'>真实姓名</label><input class='us-form-input' id='realName' placeholder='请输入真实姓名' value='" + realName + "'></div>" +
            "<div class='us-form-group'><label class='us-form-label'>身份证号</label><input class='us-form-input' id='idCard' placeholder='请输入18位身份证号' value='" + idCard + "'></div>" +
            "<div style='background:#fff3e0;padding:12px;border-radius:8px;margin-bottom:16px;font-size:12px;color:#e65100'>⚠️ 实名认证信息提交后不可修改，请确保信息准确无误</div>" +
            "<button class='us-btn' style='width:100%' onclick='submitVerify()'>提交认证</button>" +
            "</div></div>" +
            "<script>function submitVerify(){let n=document.getElementById('realName').value;let c=document.getElementById('idCard').value;if(!n){alert('请输入真实姓名');return;}if(!c||c.length!=18){alert('请输入18位身份证号');return;}fetch('/user/verify/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({real_name:n,id_card:c})}).then(r=>r.json()).then(d=>{if(d.success){alert('提交成功，等待审核');location.reload();}else{alert(d.error);}});}</script>"
    }
    return res_html(us_page("实名认证", html, currentUser))
}

fn us_verifySubmit(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_json({success: false, error: "请先登录"}, 401) }
    let body = req_getJsonBody(req)
    let db = req.db
    db_exec(db, "UPDATE users SET real_name='" + body.real_name + "', id_card='" + body.id_card + "', verified=2 WHERE id=" + convert.toString(currentUser.id))
    return res_json({success: true})
}

// === 6. Account Security ===
fn us_securityPage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let userInfo = db_queryOne(db, "SELECT phone, email, verified FROM users WHERE id=" + convert.toString(currentUser.id))
    let phone = "未绑定"
    let email = "未绑定"
    let verified = 0
    if (userInfo != null) {
        if (userInfo.phone != null && userInfo.phone != "") { phone = strings.substring(userInfo.phone, 0, 3) + "****" + strings.substring(userInfo.phone, strings.length(userInfo.phone) - 4, strings.length(userInfo.phone)) }
        if (userInfo.email != null && userInfo.email != "") { email = userInfo.email }
        if (userInfo.verified != null) { verified = userInfo.verified }
    }
    let html = "<div class='us-card' style='padding:0'>" +
        "<div class='us-list-item' onclick=\"location.href='/user/security/password'\"><div class='us-list-icon'>🔑</div><div class='us-list-content'><div class='us-list-title'>修改密码</div><div class='us-list-desc'>定期修改密码更安全</div></div><div class='us-list-arrow'>›</div></div>" +
        "<div class='us-list-item'><div class='us-list-icon'>📱</div><div class='us-list-content'><div class='us-list-title'>绑定手机</div><div class='us-list-desc'>" + phone + "</div></div><div class='us-list-arrow'>›</div></div>" +
        "<div class='us-list-item'><div class='us-list-icon'>📧</div><div class='us-list-content'><div class='us-list-title'>绑定邮箱</div><div class='us-list-desc'>" + email + "</div></div><div class='us-list-arrow'>›</div></div>" +
        "<div class='us-list-item' onclick=\"location.href='/user/verify'\"><div class='us-list-icon'>🪪</div><div class='us-list-content'><div class='us-list-title'>实名认证</div><div class='us-list-desc'>" + us_ifStr(verified == 1, "已认证", "未认证") + "</div></div><div class='us-list-arrow'>›</div></div>" +
        "</div>" +
        "<div class='us-card' style='padding:0'>" +
        "<div class='us-list-item' style='color:#ff4400' onclick=\"if(confirm('确定要注销账户吗？此操作不可恢复！')){location.href='/user/account/cancel'}\"><div class='us-list-icon'>⚠️</div><div class='us-list-content'><div class='us-list-title'>注销账户</div><div class='us-list-desc'>注销后数据将被删除，不可恢复</div></div><div class='us-list-arrow'>›</div></div>" +
        "</div>"
    return res_html(us_page("账户安全", html, currentUser))
}

fn us_passwordPage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let html = "<div class='us-card'><div class='us-form'>" +
        "<div class='us-form-group'><label class='us-form-label'>原密码</label><input class='us-form-input' type='password' id='oldPassword' placeholder='请输入原密码'></div>" +
        "<div class='us-form-group'><label class='us-form-label'>新密码</label><input class='us-form-input' type='password' id='newPassword' placeholder='请输入新密码（至少6位）'></div>" +
        "<div class='us-form-group'><label class='us-form-label'>确认新密码</label><input class='us-form-input' type='password' id='confirmPassword' placeholder='请再次输入新密码'></div>" +
        "<button class='us-btn' style='width:100%' onclick='changePassword()'>确认修改</button>" +
        "</div></div>" +
        "<script>function changePassword(){let o=document.getElementById('oldPassword').value;let n=document.getElementById('newPassword').value;let c=document.getElementById('confirmPassword').value;if(!o){alert('请输入原密码');return;}if(!n||n.length<6){alert('新密码至少6位');return;}if(n!=c){alert('两次密码不一致');return;}fetch('/user/security/password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({old_password:o,new_password:n})}).then(r=>r.json()).then(d=>{if(d.success){alert('密码修改成功，请重新登录');location.href='/logout';}else{alert(d.error);}});}</script>"
    return res_html(us_page("修改密码", html, currentUser))
}

fn us_passwordSubmit(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_json({success: false, error: "请先登录"}, 401) }
    let body = req_getJsonBody(req)
    let db = req.db
    let userInfo = db_queryOne(db, "SELECT password_hash FROM users WHERE id=" + convert.toString(currentUser.id))
    if (userInfo == null) { return res_json({success: false, error: "用户不存在"}, 404) }
    if (!verify_password(body.old_password, userInfo.password_hash)) { return res_json({success: false, error: "原密码错误"}, 400) }
    let newHash = hash_password(body.new_password)
    db_exec(db, "UPDATE users SET password_hash='" + newHash + "' WHERE id=" + convert.toString(currentUser.id))
    return res_json({success: true})
}
