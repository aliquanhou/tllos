// TLLOS Mall - User Services Part 3 (Invite, History, Complaint) + Router
// All implemented in TLL high-frame-rate language

from "../core/database" import db_query, db_queryOne, db_exec
from "../core/router" import router_get, router_post, res_html, res_json, res_redirect, req_getQuery, req_getJsonBody
from "../core/session" import cookie_getSessionId
from "../core/auth" import auth_currentUser
from "./user_services_base" import us_ensureTables, us_page, us_requireLogin, us_tabClass, us_ifStr
from "./user_services_part1" import us_couponsPage, us_collectionsPage, us_pointsPage, us_balancePage, us_verifyPage, us_verifySubmit, us_securityPage, us_passwordPage, us_passwordSubmit
from "./user_services_part2" import us_messagesPage, us_messageDetail, us_servicePage, us_serviceSend, us_helpPage, us_helpDetail, us_settingsPage, us_profilePage, us_profileSubmit

// === 11. Invite & Earn ===
fn us_invitePage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let inviteCode = "TLL" + convert.toString(10000 + currentUser.id)
    let inviteCount = db_queryOne(db, "SELECT COUNT(*) as cnt FROM invitations WHERE inviter_id=" + convert.toString(currentUser.id))
    let rewardPoints = db_queryOne(db, "SELECT COALESCE(SUM(reward_points),0) as total FROM invitations WHERE inviter_id=" + convert.toString(currentUser.id) + " AND status='completed'")
    let invites = db_query(db, "SELECT i.*, u.username as invitee_name FROM invitations i LEFT JOIN users u ON i.invitee_id=u.id WHERE i.inviter_id=" + convert.toString(currentUser.id) + " ORDER BY i.created_at DESC LIMIT 20")
    let html = "<div class='us-stat-row' style='background:linear-gradient(135deg,#667eea,#764ba2)'><div class='us-stat-item'><div class='us-stat-num'>" + convert.toString(inviteCount.cnt) + "</div><div class='us-stat-label'>邀请人数</div></div><div class='us-stat-item'><div class='us-stat-num'>" + convert.toString(rewardPoints.total) + "</div><div class='us-stat-label'>累计积分</div></div><div class='us-stat-item'><div class='us-stat-num'>100</div><div class='us-stat-label'>每人奖励</div></div></div>" +
        "<div class='us-card' style='padding:20px;text-align:center'><div style='font-size:14px;color:#666;margin-bottom:8px'>我的邀请码</div><div style='font-size:32px;font-weight:bold;color:#ff6a00;letter-spacing:4px;margin-bottom:16px'>" + inviteCode + "</div><button class='us-btn' style='margin-right:8px' onclick=\"navigator.clipboard.writeText('" + inviteCode + "');alert('邀请码已复制')\">复制邀请码</button><button class='us-btn us-btn-outline' onclick='showShareModal()'>分享给好友</button></div>" +
        "<div id='shareModal' style='display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center'><div style='background:#fff;border-radius:12px;padding:24px;width:80%;max-width:320px;text-align:center'><div style='font-size:18px;font-weight:600;margin-bottom:16px'>分享给好友</div><div style='margin-bottom:16px'><img src='https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https://shop.tllos.com/register?invite=" + inviteCode + "' style='width:180px;height:180px;border:1px solid #eee;border-radius:8px'></div><div style='font-size:13px;color:#666;margin-bottom:8px'>邀请链接：</div><div style='font-size:12px;color:#333;background:#f5f5f5;padding:8px;border-radius:4px;margin-bottom:16px;word-break:break-all'>https://shop.tllos.com/register?invite=" + inviteCode + "</div><button class='us-btn' style='width:100%' onclick=\"navigator.clipboard.writeText('https://shop.tllos.com/register?invite=" + inviteCode + "');alert('邀请链接已复制')\">复制链接</button><button class='us-btn us-btn-outline' style='width:100%;margin-top:8px' onclick='hideShareModal()'>关闭</button></div></div>" +
        "<script>function showShareModal(){document.getElementById('shareModal').style.display='flex';}function hideShareModal(){document.getElementById('shareModal').style.display='none';}</script>" +
        "<div class='us-card' style='padding:16px;background:#fff8f0'><div style='font-size:14px;font-weight:600;color:#e65100;margin-bottom:8px'>🎁 活动规则</div><div style='font-size:12px;color:#666;line-height:1.8'>1. 邀请好友注册，双方各得100积分<br>2. 好友首次下单，邀请人再得200积分<br>3. 积分可在结算时抵扣现金（100积分=1元）<br>4. 活动最终解释权归TLL Mall所有</div></div>"
    if (arrays.length(invites) > 0) {
        html = html + "<div class='us-card' style='margin:12px;padding:0'><div style='padding:14px 16px;font-weight:600;border-bottom:1px solid #f5f5f5'>邀请记录</div>"
        let i = 0
        while (i < arrays.length(invites)) {
            let inv = invites[i]
            let statusText = "待注册"
            let statusClass = "us-badge-warning"
            if (inv.status == "completed") { statusText = "已完成"; statusClass = "us-badge-success" }
            if (inv.status == "cancelled") { statusText = "已取消"; statusClass = "us-badge-danger" }
            let name = inv.invitee_name
            if (name == null) { name = "未注册" }
            html = html + "<div class='us-list-item'><div class='us-list-icon'>👤</div><div class='us-list-content'><div class='us-list-title'>" + name + "</div><div class='us-list-desc'>" + inv.created_at + "</div></div><div><span class='us-badge " + statusClass + "'>" + statusText + "</span><div style='font-size:12px;color:#ff6a00;margin-top:4px;text-align:right'>+" + convert.toString(inv.reward_points) + "积分</div></div></div>"
            i = i + 1
        }
        html = html + "</div>"
    }
    return res_html(us_page("邀请有礼", html, currentUser))
}

// === 12. Browsing History ===
fn us_historyPage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let history = db_query(db, "SELECT * FROM browsing_history WHERE user_id=" + convert.toString(currentUser.id) + " ORDER BY created_at DESC LIMIT 50")
    let html = ""
    if (arrays.length(history) == 0) {
        html = "<div class='us-empty'><div class='us-empty-icon'>👣</div><div class='us-empty-text'>暂无浏览记录</div><a href='/' class='us-btn'>去逛逛</a></div>"
    } else {
        html = "<div style='padding:12px 16px;display:flex;justify-content:space-between;align-items:center'><div style='font-size:14px;color:#666'>共 " + convert.toString(arrays.length(history)) + " 条浏览记录</div><button class='us-btn us-btn-outline' style='padding:6px 12px;font-size:12px' onclick=\"if(confirm('确定清空浏览记录？')){location.href='/user/history/clear'}\">清空</button></div>"
        html = html + "<div class='us-card' style='margin:0 12px 12px;padding:0'>"
        let i = 0
        while (i < arrays.length(history)) {
            let h = history[i]
            let imgText = "📦"
            if (h.product_image != null && h.product_image != "") { imgText = "<img src='" + h.product_image + "' style='width:100%;height:100%;object-fit:cover;border-radius:8px'>" }
            html = html + "<div class='us-product-card' onclick=\"location.href='/product/" + convert.toString(h.product_id) + "'\">" +
                "<div class='us-product-img'>" + imgText + "</div>" +
                "<div class='us-product-info'>" +
                "<div class='us-product-name'>" + h.product_name + "</div>" +
                "<div class='us-product-price'>¥" + convert.toString(h.product_price) + "</div>" +
                "<div class='us-product-time'>浏览于 " + h.created_at + "</div>" +
                "</div></div>"
            i = i + 1
        }
        html = html + "</div>"
    }
    return res_html(us_page("浏览历史", html, currentUser))
}

fn us_historyClear(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    db_exec(db, "DELETE FROM browsing_history WHERE user_id=" + convert.toString(currentUser.id))
    return res_redirect("/user/history")
}

// === 13. Complaints & Suggestions ===
fn us_complaintPage(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let tab = req_getQuery(req, "tab", "list")
    let html = "<div class='us-tabs'>" +
        "<div class='us-tab " + us_tabClass(tab, "list") + "' onclick=\"location.href='/user/complaint?tab=list'\">我的反馈</div>" +
        "<div class='us-tab " + us_tabClass(tab, "new") + "' onclick=\"location.href='/user/complaint?tab=new'\">提交反馈</div>" +
        "</div>"
    if (tab == "new") {
        html = html + "<div class='us-card'><div class='us-form'>" +
            "<div class='us-form-group'><label class='us-form-label'>反馈类型</label><select class='us-form-select' id='type'><option value='suggestion'>功能建议</option><option value='bug'>问题反馈</option><option value='complaint'>投诉</option><option value='other'>其他</option></select></div>" +
            "<div class='us-form-group'><label class='us-form-label'>标题</label><input class='us-form-input' id='title' placeholder='请简要描述问题或建议'></div>" +
            "<div class='us-form-group'><label class='us-form-label'>详细描述</label><textarea class='us-form-textarea' id='content' placeholder='请详细描述您遇到的问题或建议，我们会认真处理'></textarea></div>" +
            "<div class='us-form-group'><label class='us-form-label'>联系方式（选填）</label><input class='us-form-input' id='contact' placeholder='手机号或邮箱，方便我们联系您'></div>" +
            "<button class='us-btn' style='width:100%' onclick='submitComplaint()'>提交反馈</button>" +
            "</div></div>" +
            "<script>function submitComplaint(){let t=document.getElementById('type').value;let ti=document.getElementById('title').value;let c=document.getElementById('content').value;let co=document.getElementById('contact').value;if(!ti){alert('请输入标题');return;}if(!c){alert('请输入详细描述');return;}fetch('/user/complaint/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:t,title:ti,content:c,contact:co})}).then(r=>r.json()).then(d=>{if(d.success){alert('提交成功，感谢您的反馈！');location.href='/user/complaint?tab=list';}else{alert(d.error);}});}</script>"
    } else {
        let complaints = db_query(db, "SELECT * FROM complaints WHERE user_id=" + convert.toString(currentUser.id) + " ORDER BY created_at DESC LIMIT 20")
        if (arrays.length(complaints) == 0) {
            html = html + "<div class='us-empty'><div class='us-empty-icon'>📝</div><div class='us-empty-text'>暂无反馈记录</div><a href='/user/complaint?tab=new' class='us-btn'>提交反馈</a></div>"
        } else {
            html = html + "<div class='us-card' style='margin:12px;padding:0'>"
            let i = 0
            while (i < arrays.length(complaints)) {
                let c = complaints[i]
                let typeText = "功能建议"
                if (c.type == "bug") { typeText = "问题反馈" }
                if (c.type == "complaint") { typeText = "投诉" }
                if (c.type == "other") { typeText = "其他" }
                let statusText = "待处理"
                let statusClass = "us-badge-warning"
                if (c.status == "processing") { statusText = "处理中"; statusClass = "us-badge-info" }
                if (c.status == "completed") { statusText = "已完成"; statusClass = "us-badge-success" }
                html = html + "<div class='us-list-item' onclick=\"location.href='/user/complaint/" + convert.toString(c.id) + "'\"><div class='us-list-icon'>📝</div><div class='us-list-content'><div class='us-list-title'>" + c.title + " <span class='us-badge us-badge-info'>" + typeText + "</span></div><div class='us-list-desc'>" + c.created_at + "</div></div><span class='us-badge " + statusClass + "'>" + statusText + "</span></div>"
                i = i + 1
            }
            html = html + "</div>"
        }
    }
    return res_html(us_page("投诉建议", html, currentUser))
}

fn us_complaintSubmit(req) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_json({success: false, error: "请先登录"}, 401) }
    let body = req_getJsonBody(req)
    let db = req.db
    us_ensureTables(db)
    db_exec(db, "INSERT INTO complaints (user_id, type, title, content, contact) VALUES (" + convert.toString(currentUser.id) + ", '" + body.type + "', '" + body.title + "', '" + body.content + "', '" + body.contact + "')")
    return res_json({success: true})
}

fn us_complaintDetail(req, complaintId) {
    let currentUser = us_requireLogin(req)
    if (currentUser == null) { return res_redirect("/login") }
    let db = req.db
    us_ensureTables(db)
    let c = db_queryOne(db, "SELECT * FROM complaints WHERE id=" + convert.toString(complaintId) + " AND user_id=" + convert.toString(currentUser.id))
    let html = ""
    if (c == null) {
        html = "<div class='us-empty'><div class='us-empty-icon'>❓</div><div class='us-empty-text'>反馈不存在</div></div>"
    } else {
        let statusText = "待处理"
        let statusClass = "us-badge-warning"
        if (c.status == "processing") { statusText = "处理中"; statusClass = "us-badge-info" }
        if (c.status == "completed") { statusText = "已完成"; statusClass = "us-badge-success" }
        html = "<div class='us-card'><div class='us-article'><div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:12px'><h3 style='margin:0'>" + c.title + "</h3><span class='us-badge " + statusClass + "'>" + statusText + "</span></div><div style='font-size:12px;color:#999;margin-bottom:16px'>" + c.created_at + "</div><p style='white-space:pre-wrap'>" + c.content + "</p></div></div>"
        if (c.reply != null && c.reply != "") {
            html = html + "<div class='us-card' style='background:#f0f7ff'><div class='us-article'><div style='font-size:14px;font-weight:600;color:#1565c0;margin-bottom:8px'>💬 官方回复</div><p style='white-space:pre-wrap;color:#333'>" + c.reply + "</p></div></div>"
        }
    }
    return res_html(us_page("反馈详情", html, currentUser))
}

// === Register All Routes ===
fn us_registerAll(router) {
    // 1. Coupons
    router_get(router, "/user/coupons", fn(req) { return us_couponsPage(req) })
    // 2. Collections
    router_get(router, "/user/collections", fn(req) { return us_collectionsPage(req) })
    // 3. Points
    router_get(router, "/user/points", fn(req) { return us_pointsPage(req) })
    // 4. Balance
    router_get(router, "/user/balance", fn(req) { return us_balancePage(req) })
    // 5. Verify
    router_get(router, "/user/verify", fn(req) { return us_verifyPage(req) })
    router_post(router, "/user/verify/submit", fn(req) { return us_verifySubmit(req) })
    // 6. Security
    router_get(router, "/user/security", fn(req) { return us_securityPage(req) })
    router_get(router, "/user/security/password", fn(req) { return us_passwordPage(req) })
    router_post(router, "/user/security/password", fn(req) { return us_passwordSubmit(req) })
    // 7. Messages
    router_get(router, "/user/messages", fn(req) { return us_messagesPage(req) })
    router_get(router, "/user/messages/:id", fn(req) {
        let id = req_getQuery(req, "id", "0")
        return us_messageDetail(req, convert.toInt(id))
    })
    // 8. Service
    router_get(router, "/user/service", fn(req) { return us_servicePage(req) })
    router_post(router, "/user/service/send", fn(req) { return us_serviceSend(req) })
    // 9. Help
    router_get(router, "/user/help", fn(req) { return us_helpPage(req) })
    router_get(router, "/user/help/:id", fn(req) {
        let id = req_getQuery(req, "id", "0")
        return us_helpDetail(req, convert.toInt(id))
    })
    // 10. Settings
    router_get(router, "/user/settings", fn(req) { return us_settingsPage(req) })
    router_get(router, "/user/settings/profile", fn(req) { return us_profilePage(req) })
    router_post(router, "/user/settings/profile", fn(req) { return us_profileSubmit(req) })
    // 11. Invite
    router_get(router, "/user/invite", fn(req) { return us_invitePage(req) })
    // 12. History
    router_get(router, "/user/history", fn(req) { return us_historyPage(req) })
    router_get(router, "/user/history/clear", fn(req) { return us_historyClear(req) })
    // 13. Complaint
    router_get(router, "/user/complaint", fn(req) { return us_complaintPage(req) })
    router_post(router, "/user/complaint/submit", fn(req) { return us_complaintSubmit(req) })
    router_get(router, "/user/complaint/:id", fn(req) {
        let id = req_getQuery(req, "id", "0")
        return us_complaintDetail(req, convert.toInt(id))
    })

    io.println("[UserServices] 13 full-featured services registered")
    return {success: true}
}
