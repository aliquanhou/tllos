// HTTP + Router test with global router variable
from "./core/router" import router_create, router_get, router_post, router_handler, res_json, res_html, router_handle

// Use global variable instead of closure capture
let globalRouter = router_create()

router_get(globalRouter, "/", fn(req) {
    return res_html("<h1>Home</h1>")
})

router_get(globalRouter, "/test", fn(req) {
    return res_json({path: req.path, method: req.method, routeCount: arrays.length(globalRouter.routes)})
})

fn globalHandler(req) {
    return router_handle(globalRouter, req)
}

io.println("Starting HTTP+Router (global var) server on :8095...")
http.serve("0.0.0.0:8095", globalHandler)
