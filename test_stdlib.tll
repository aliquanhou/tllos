// TLL Standard Library test - Array operations
from "./stdlib/array" import array_map, array_filter, array_reduce, array_find, array_any, array_all, array_reverse, array_len, array_concat

let nums = [1, 2, 3, 4, 5]

// Test map
let doubled = array_map(nums, fn(x) -> int { return x * 2 })
io.println("map: " + convert.toString(arrays.get(doubled, 0)) + "," + convert.toString(arrays.get(doubled, 1)) + "," + convert.toString(arrays.get(doubled, 2)))

// Test filter
let evens = array_filter(nums, fn(x) -> bool { return x % 2 == 0 })
io.println("filter evens count: " + convert.toString(arrays.length(evens)))

// Test reduce
let sum = array_reduce(nums, fn(acc, x) -> int { return acc + x }, 0)
io.println("reduce sum: " + convert.toString(sum))

// Test find
let found = array_find(nums, fn(x) -> bool { return x > 3 })
io.println("find >3: " + convert.toString(found))

// Test any
let hasLarge = array_any(nums, fn(x) -> bool { return x > 4 })
io.println("any >4: " + convert.toString(hasLarge))

// Test all
let allPositive = array_all(nums, fn(x) -> bool { return x > 0 })
io.println("all >0: " + convert.toString(allPositive))

// Test reverse
let reversed = array_reverse(nums)
io.println("reverse first: " + convert.toString(arrays.get(reversed, 0)))

// Test len
io.println("len: " + convert.toString(array_len(nums)))

// Test concat
let more = [6, 7]
let combined = array_concat(nums, more)
io.println("concat length: " + convert.toString(arrays.length(combined)))

io.println("=== Stdlib Array Tests Done ===")
