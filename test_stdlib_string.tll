// TLL Standard Library test - String operations
from "./stdlib/string" import string_len, string_startsWith, string_endsWith, string_contains, string_substring, string_split, string_trim, string_repeat, string_replace

let s = "Hello, World!"

// Test len
io.println("len: " + convert.toString(string_len(s)))

// Test startsWith
io.println("startsWith Hello: " + convert.toString(string_startsWith(s, "Hello")))
io.println("startsWith World: " + convert.toString(string_startsWith(s, "World")))

// Test endsWith
io.println("endsWith !: " + convert.toString(string_endsWith(s, "!")))
io.println("endsWith Hello: " + convert.toString(string_endsWith(s, "Hello")))

// Test contains
io.println("contains World: " + convert.toString(string_contains(s, "World")))
io.println("contains Python: " + convert.toString(string_contains(s, "Python")))

// Test substring
io.println("substring 0-5: " + string_substring(s, 0, 5))

// Test split
let parts = string_split("a,b,c", ",")
io.println("split count: " + convert.toString(arrays.length(parts)))
io.println("split[0]: " + arrays.get(parts, 0))

// Test trim
io.println("trim: '" + string_trim("  hello  ") + "'")

// Test repeat
io.println("repeat: " + string_repeat("ab", 3))

// Test replace
io.println("replace: " + string_replace("Hello World", "World", "TLL"))

io.println("=== Stdlib String Tests Done ===")
