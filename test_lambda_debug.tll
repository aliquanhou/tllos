// Debug lambda
io.println("start")

let add = fn(a, b) {
    io.println("  lambda body executing, a=" + convert.toString(a) + " b=" + convert.toString(b))
    return a + b
}

io.println("calling add...")
let r = add(3, 4)
io.println("result type=" + convert.typeOf(r))
io.println("result=[" + convert.toString(r) + "]")
io.println("done")
